<UserControl x:Class="GerenciadorSalao.Views.ProdutosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:GerenciadorSalao.ViewModels"
             xmlns:helpers="clr-namespace:GerenciadorSalao.Helpers"
             d:DataContext="{d:DesignInstance Type=vm:ProdutosViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1100">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Estilo dos Campos de Formulário (Inputs Modernos) -->
        <Style x:Key="ModalTextBoxStyle" TargetType="TextBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
            <Setter Property="Background" Value="#F8F6F5"/>
            <Setter Property="BorderBrush" Value="#E8E2E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BrushPrimary}"/>
                                <Setter TargetName="border" Property="Background" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo dos Cards de Produto -->
        <Style x:Key="ProductCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BrushSurface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#D8CEC9"/>
                    <Setter Property="Background" Value="#FCFBFA"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- ===================== CONTEÚDO PRINCIPAL DA TELA ===================== -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="28,20,28,32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- 1. Header da Página -->
                    <RowDefinition Height="Auto"/> <!-- 2. Barra de Busca e Contador -->
                    <RowDefinition Height="*"/>    <!-- 3. Cards de Produtos ou Empty State -->
                </Grid.RowDefinitions>

                <!-- ===================== 1. HEADER DA PÁGINA ===================== -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Produtos" 
                                   FontSize="26" 
                                   FontWeight="Bold" 
                                   Foreground="{StaticResource BrushTextPrimary}"/>
                        <TextBlock Text="Uma seleção de cuidados para continuar em casa." 
                                   FontSize="13" 
                                   Foreground="{StaticResource BrushTextSecondary}" 
                                   Margin="0,3,0,0"/>
                    </StackPanel>

                    <!-- Botão Novo Produto -->
                    <Button Grid.Column="1"
                            Command="{Binding AbrirNovoProdutoCommand}"
                            Background="{StaticResource BrushPrimary}"
                            Foreground="White"
                            BorderThickness="0"
                            Padding="16,9"
                            Cursor="Hand"
                            VerticalAlignment="Center">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Add24" FontSize="15" Foreground="White" Margin="0,0,6,0"/>
                            <TextBlock Text="Novo produto" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- ===================== 2. BARRA DE BUSCA E CONTADOR ===================== -->
                <Grid Grid.Row="1" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Caixa de Pesquisa com Ícone de Lupa -->
                    <Border Grid.Column="0"
                            Background="{StaticResource BrushSurface}"
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <ui:SymbolIcon Grid.Column="0" 
                                           Symbol="Search24" 
                                           FontSize="15" 
                                           Foreground="{StaticResource BrushTextSecondary}" 
                                           VerticalAlignment="Center" 
                                           Margin="0,0,8,0"/>

                            <TextBox x:Name="TxtBuscaProdutos"
                                     Grid.Column="1"
                                     Text="{Binding TermoBusca, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="12"
                                     Foreground="{StaticResource BrushTextPrimary}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="0"
                                     Margin="0"
                                     VerticalContentAlignment="Center"/>

                            <!-- Placeholder Text -->
                            <TextBlock Grid.Column="1"
                                       Text="Buscar produto por nome..."
                                       FontSize="12"
                                       Foreground="{StaticResource BrushTextSecondary}"
                                       VerticalAlignment="Center"
                                       Padding="0"
                                       Margin="0"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding TermoBusca}" Value=""/>
                                                    <Condition Binding="{Binding IsKeyboardFocused, ElementName=TxtBuscaProdutos}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- Contador de Produtos à Direita -->
                    <TextBlock Grid.Column="1" 
                               HorizontalAlignment="Right" 
                               VerticalAlignment="Center"
                               FontSize="12" 
                               Foreground="{StaticResource BrushTextSecondary}">
                        <Run Text="{Binding TotalProdutosTexto}"/>
                    </TextBlock>
                </Grid>

                <!-- ===================== 3. GRID DE CARDS DE PRODUTOS ===================== -->
                <Grid Grid.Row="2">
                    <!-- Lista em Cards quando há produtos -->
                    <ItemsControl ItemsSource="{Binding Produtos}" 
                                  Visibility="{Binding TemProdutos, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ProductCardStyle}" 
                                        Width="260" 
                                        Margin="0,0,16,16">
                                    <StackPanel>
                                        <!-- Ícone do Produto (Caixa/Embalagem) com Fundo Verde Sálvia Suave -->
                                        <Border Width="42" 
                                                Height="42" 
                                                CornerRadius="8" 
                                                Background="#E8F3EE" 
                                                HorizontalAlignment="Left" 
                                                Margin="0,0,0,16">
                                            <ui:SymbolIcon Symbol="Box24" 
                                                           FontSize="20" 
                                                           Foreground="#2E5A44" 
                                                           HorizontalAlignment="Center" 
                                                           VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Nome / Descrição do Produto -->
                                        <TextBlock Text="{Binding Descricao}" 
                                                   FontSize="15" 
                                                   FontWeight="SemiBold" 
                                                   Foreground="{StaticResource BrushTextPrimary}" 
                                                   TextWrapping="Wrap" 
                                                   MinHeight="40" 
                                                   Margin="0,0,0,16"/>

                                        <!-- Linha Divisória Sutil -->
                                        <Border Height="1" 
                                                Background="#F0EAE8" 
                                                Margin="0,0,0,14"/>

                                        <!-- Rodapé do Card: Valor à Esquerda e Ações à Direita -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Preço em Destaque -->
                                            <TextBlock Grid.Column="0" 
                                                       Text="{Binding ValorFormatado}" 
                                                       FontSize="17" 
                                                       FontWeight="Bold" 
                                                       Foreground="{StaticResource BrushTextPrimary}" 
                                                       VerticalAlignment="Center"/>

                                            <!-- Botões de Ação (Editar e Excluir) -->
                                            <StackPanel Grid.Column="1" 
                                                        Orientation="Horizontal" 
                                                        VerticalAlignment="Center">
                                                <!-- Botão Editar -->
                                                <Button Command="{Binding DataContext.AbrirEditarProdutoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Editar produto"
                                                        Background="Transparent" 
                                                        BorderThickness="0" 
                                                        Cursor="Hand" 
                                                        Padding="5" 
                                                        Margin="0,0,2,0">
                                                    <ui:SymbolIcon Symbol="Edit24" FontSize="15" Foreground="{StaticResource BrushTextSecondary}"/>
                                                </Button>

                                                <!-- Botão Excluir -->
                                                <Button Command="{Binding DataContext.AbrirExcluirProdutoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Excluir produto"
                                                        Background="Transparent" 
                                                        BorderThickness="0" 
                                                        Cursor="Hand" 
                                                        Padding="5">
                                                    <ui:SymbolIcon Symbol="Delete24" FontSize="15" Foreground="{StaticResource BrushTextSecondary}"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Estado Vazio (Sem Produtos ou Nenhum Resultado) -->
                    <Border Visibility="{Binding SemProdutos, Converter={StaticResource BoolToVis}}"
                            Background="{StaticResource BrushSurface}"
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="48,56">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="56" Height="56" CornerRadius="14" Background="#F5EFEB" Margin="0,0,0,16" HorizontalAlignment="Center">
                                <ui:SymbolIcon Symbol="Box24" FontSize="26" Foreground="#8C827A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Nenhum produto cadastrado" 
                                       FontSize="16" 
                                       FontWeight="SemiBold" 
                                       Foreground="{StaticResource BrushTextPrimary}" 
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Cadastre produtos para registrar vendas adicionais nas comandas." 
                                       FontSize="12" 
                                       Foreground="{StaticResource BrushTextSecondary}" 
                                       Margin="0,5,0,20" 
                                       HorizontalAlignment="Center"/>
                            <Button Command="{Binding AbrirNovoProdutoCommand}"
                                    Background="{StaticResource BrushPrimary}"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Padding="18,9"
                                    Cursor="Hand"
                                    HorizontalAlignment="Center">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Add24" FontSize="14" Foreground="White" Margin="0,0,6,0"/>
                                    <TextBlock Text="Novo produto" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>

        <!-- ===================== MODAL: NOVO / EDITAR PRODUTO ===================== -->
        <Grid Visibility="{Binding IsModalProdutoAberto, Converter={StaticResource BoolToVis}}">
            <Border Background="#55000000" Cursor="Hand" MouseLeftButtonDown="FecharModalProduto_MouseLeftButtonDown"/>
            <Border Background="White" 
                    CornerRadius="14" 
                    Width="440" 
                    Padding="26,24" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center">
                <Border.RenderTransform>
                    <TranslateTransform X="{Binding DataContext.IsSidebarOpen, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SidebarToModalOffsetXConverter}}"
                                        Y="-26"/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" Direction="270" ShadowDepth="6" Opacity="0.18" Color="#201C1B"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header -->
                        <RowDefinition Height="Auto"/> <!-- Campos -->
                        <RowDefinition Height="Auto"/> <!-- Mensagem de Erro -->
                        <RowDefinition Height="Auto"/> <!-- Botão Salvar -->
                    </Grid.RowDefinitions>

                    <!-- Header com Título, Subtítulo e Botão Fechar (X) -->
                    <Grid Grid.Row="0" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="{Binding ModalTitulo}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                            <TextBlock Text="Detalhes do cadastro." FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3,0,0"/>
                        </StackPanel>

                        <!-- Botão Fechar (X) -->
                        <Button HorizontalAlignment="Right" 
                                VerticalAlignment="Top" 
                                Command="{Binding FecharModalProdutoCommand}" 
                                Background="Transparent" 
                                BorderThickness="0" 
                                Cursor="Hand" 
                                Padding="6">
                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" Foreground="{StaticResource BrushTextSecondary}"/>
                        </Button>
                    </Grid>

                    <!-- Campos do Formulário -->
                    <StackPanel Grid.Row="1">
                        <!-- Campo Nome / Descrição -->
                        <TextBlock Text="Nome / descrição" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,5"/>
                        <TextBox Style="{StaticResource ModalTextBoxStyle}" 
                                 Text="{Binding FormDescricao, UpdateSourceTrigger=PropertyChanged}" 
                                 MaxLength="150"
                                 Margin="0,0,0,14"/>

                        <!-- Campo Valor (R$) com Máscara Monetária em Tempo Real -->
                        <TextBlock Text="Valor (R$)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,5"/>
                        <TextBox Style="{StaticResource ModalTextBoxStyle}" 
                                 helpers:MaskHelper.Mask="Currency"
                                 Text="{Binding FormValor, UpdateSourceTrigger=PropertyChanged}" 
                                 MaxLength="12"
                                 Margin="0,0,0,14"/>
                    </StackPanel>

                    <!-- Mensagem de Validação / Erro -->
                    <Border Grid.Row="2" 
                            Background="#FDECEA" 
                            CornerRadius="6" 
                            Padding="10,6" 
                            Margin="0,0,0,14">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FormMensagemErro}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding FormMensagemErro}" FontSize="11" Foreground="#C62828"/>
                    </Border>

                    <!-- Botão Salvar Produto em Largura Total -->
                    <Button Grid.Row="3"
                            Command="{Binding SalvarProdutoCommand}"
                            Background="{StaticResource BrushPrimary}"
                            Foreground="White"
                            BorderThickness="0"
                            Padding="0,12"
                            Cursor="Hand"
                            HorizontalAlignment="Stretch">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                        <TextBlock Text="Salvar produto" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- ===================== MODAL: EXCLUIR PRODUTO ===================== -->
        <Grid Visibility="{Binding IsModalExcluirAberto, Converter={StaticResource BoolToVis}}">
            <Border Background="#55000000" Cursor="Hand" MouseLeftButtonDown="FecharModalExcluir_MouseLeftButtonDown"/>
            <Border Background="White" 
                    CornerRadius="14" 
                    Width="440" 
                    Padding="26,24" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center">
                <Border.RenderTransform>
                    <TranslateTransform X="{Binding DataContext.IsSidebarOpen, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SidebarToModalOffsetXConverter}}"
                                        Y="-26"/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" Direction="270" ShadowDepth="6" Opacity="0.18" Color="#201C1B"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header -->
                        <RowDefinition Height="Auto"/> <!-- Descrição -->
                        <RowDefinition Height="Auto"/> <!-- Botão Excluir -->
                    </Grid.RowDefinitions>

                    <!-- Header com Título e Botão Fechar -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Excluir produto?" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                        <Button HorizontalAlignment="Right" 
                                VerticalAlignment="Top" 
                                Command="{Binding FecharModalExcluirCommand}" 
                                Background="Transparent" 
                                BorderThickness="0" 
                                Cursor="Hand" 
                                Padding="6">
                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" Foreground="{StaticResource BrushTextSecondary}"/>
                        </Button>
                    </Grid>

                    <!-- Mensagem Informativa de Exclusão -->
                    <TextBlock Grid.Row="1" 
                               Text="{Binding ProdutoParaExcluir.Descricao, StringFormat='{}{0}. Esta ação não pode ser desfeita. Cadastros com atendimentos vinculados são preservados.'}" 
                               FontSize="13" 
                               Foreground="{StaticResource BrushTextSecondary}" 
                               TextWrapping="Wrap" 
                               LineHeight="18"
                               Margin="0,0,0,20"/>

                    <!-- Botão Confirmar Exclusão -->
                    <Button Grid.Row="2"
                            Command="{Binding ConfirmarExclusaoCommand}"
                            Background="#D32F2F"
                            Foreground="White"
                            BorderThickness="0"
                            Padding="0,12"
                            Cursor="Hand"
                            HorizontalAlignment="Stretch">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                        <TextBlock Text="Confirmar exclusão" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
