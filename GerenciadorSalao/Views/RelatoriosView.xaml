<UserControl x:Class="GerenciadorSalao.Views.RelatoriosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:GerenciadorSalao.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:RelatoriosViewModel}"
             d:DesignHeight="900" d:DesignWidth="1100">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20,16,20,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 0. Cabeçalho + Filtros -->
                <RowDefinition Height="Auto"/> <!-- 1. Cards de Resumo Financeiro -->
                <RowDefinition Height="Auto"/> <!-- 2. Gráfico Dinâmico de Faturamento -->
                <RowDefinition Height="Auto"/> <!-- 3. Tabelas: Mês a Mês + Top Clientes -->
            </Grid.RowDefinitions>

            <!-- ===================== 0. CABEÇALHO + FILTROS ===================== -->
            <Grid Grid.Row="0" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Titulo}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                    <TextBlock Text="{Binding Subtitulo}" FontSize="13" Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Filtros: Período + Ano + Botão Atualizar -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Filtro Período -->
                    <Border Background="White" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Height="38" Padding="8,0" Margin="0,0,10,0">
                        <ComboBox ItemsSource="{Binding PeriodosDisponiveis}"
                                  SelectedItem="{Binding PeriodoSelecionado, Mode=TwoWay}"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  FontSize="12"
                                  FontWeight="SemiBold"
                                  VerticalAlignment="Center"/>
                    </Border>

                    <!-- Filtro Ano -->
                    <Border Background="White" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Height="38" Padding="8,0" Margin="0,0,10,0">
                        <ComboBox ItemsSource="{Binding AnosDisponiveis}"
                                  SelectedItem="{Binding AnoSelecionado, Mode=TwoWay}"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  FontSize="12"
                                  FontWeight="SemiBold"
                                  VerticalAlignment="Center"/>
                    </Border>

                    <!-- Botão Atualizar -->
                    <Button Command="{Binding CarregarDadosCommand}"
                            Background="#F4ECE8"
                            BorderThickness="0"
                            Height="38"
                            Padding="14,0"
                            Cursor="Hand"
                            OverridesDefaultStyle="True">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#E8DED8"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#DDD1CB"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="ArrowSync24" FontSize="14" Foreground="{StaticResource BrushPrimary}" Margin="0,0,6,0"/>
                            <TextBlock Text="Atualizar" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushPrimary}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ===================== 1. CARDS DE RESUMO FINANCEIRO ===================== -->
            <Grid Grid.Row="1" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- CARD 1: Faturamento Total -->
                <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="12" Padding="18,16" Margin="0,0,8,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Faturamento Total" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                            <Border Grid.Column="1" HorizontalAlignment="Right" Width="30" Height="30" CornerRadius="8" Background="#E8F5E9">
                                <ui:SymbolIcon Symbol="Money24" FontSize="15" Foreground="#2E7D32"/>
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding FaturamentoTotalTexto}" FontSize="20" FontWeight="Bold" Foreground="#2E7D32" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding PeriodoTagDescricao}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <!-- CARD 2: Ticket Médio -->
                <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="12" Padding="18,16" Margin="4,0,4,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Ticket Médio" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                            <Border Grid.Column="1" HorizontalAlignment="Right" Width="30" Height="30" CornerRadius="8" Background="#EDE7F6">
                                <ui:SymbolIcon Symbol="ArrowTrendingLines24" FontSize="15" Foreground="#5E35B1"/>
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding TicketMedioTexto}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="Média por atendimento" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <!-- CARD 3: Atendimentos Faturados -->
                <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="12" Padding="18,16" Margin="4,0,4,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Atendimentos Pagos" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                            <Border Grid.Column="1" HorizontalAlignment="Right" Width="30" Height="30" CornerRadius="8" Background="#E1F5FE">
                                <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="15" Foreground="#0277BD"/>
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding TotalAtendimentosTexto}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="Comandas finalizadas" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <!-- CARD 4: Média Mensal -->
                <Border Grid.Column="3" Background="White" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="12" Padding="18,16" Margin="8,0,0,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Média Mensal" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                            <Border Grid.Column="1" HorizontalAlignment="Right" Width="30" Height="30" CornerRadius="8" Background="#FFF3E0">
                                <ui:SymbolIcon Symbol="CalendarLtr24" FontSize="15" Foreground="#EF6C00"/>
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding MediaMensalTexto}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="Faturamento por mês" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===================== 2. GRÁFICO DINÂMICO DE FATURAMENTO ===================== -->
            <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="12" Padding="24" Margin="0,0,0,24">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="Curva de Faturamento Mensal" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="Evolução da receita ao longo dos meses" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding FaturamentoTotalTexto, StringFormat='Total: {0}'}" FontSize="15" FontWeight="Bold" Foreground="#2E7D32"/>
                    </Grid>

                    <!-- Área de Visualização do Gráfico Bézier Adaptativo (Sem Viewbox / Sem Esticar) -->
                    <Grid Height="200" Margin="0,8,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="65"/> <!-- Eixo Y Labels -->
                            <ColumnDefinition Width="*"/>   <!-- Área do Gráfico Dinâmica -->
                        </Grid.ColumnDefinitions>

                        <!-- Eixo Y com Valores em R$ Perfeitamente Alinhados com as Linhas de Grade -->
                        <Grid Grid.Column="0">
                            <TextBlock Text="{Binding YLabelMax}" FontSize="10" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,18,10,0"/>
                            <TextBlock Text="{Binding YLabel75}" FontSize="10" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,53,10,0"/>
                            <TextBlock Text="{Binding YLabel50}" FontSize="10" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,88,10,0"/>
                            <TextBlock Text="{Binding YLabel25}" FontSize="10" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,123,10,0"/>
                            <TextBlock Text="{Binding YLabel0}" FontSize="10" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,158,10,0"/>
                        </Grid>

                        <!-- Área de Desenho e Interação do Gráfico (Ajusta o espaçamento entre meses conforme a tela) -->
                        <Grid x:Name="ChartArea" 
                              Grid.Column="1" 
                              Height="200" 
                              SizeChanged="ChartArea_SizeChanged" 
                              ClipToBounds="True">

                            <!-- Linhas de Grade Horizontais Tracejadas Dinâmicas que preenchem 100% da largura -->
                            <Canvas>
                                <Line X1="0" Y1="25" X2="{Binding ActualWidth, ElementName=ChartArea}" Y2="25" Stroke="#F0EDE8" StrokeDashArray="3 3"/>
                                <Line X1="0" Y1="60" X2="{Binding ActualWidth, ElementName=ChartArea}" Y2="60" Stroke="#F0EDE8" StrokeDashArray="3 3"/>
                                <Line X1="0" Y1="95" X2="{Binding ActualWidth, ElementName=ChartArea}" Y2="95" Stroke="#F0EDE8" StrokeDashArray="3 3"/>
                                <Line X1="0" Y1="130" X2="{Binding ActualWidth, ElementName=ChartArea}" Y2="130" Stroke="#F0EDE8" StrokeDashArray="3 3"/>
                                <Line X1="0" Y1="165" X2="{Binding ActualWidth, ElementName=ChartArea}" Y2="165" Stroke="#D6CECA" StrokeThickness="1"/>
                            </Canvas>

                            <!-- Preenchimento Suave em Gradiente sob a Curva -->
                            <Path Data="{Binding GraficoAreaGeometry}" Opacity="0.16">
                                <Path.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#C25E4B" Offset="0.0"/>
                                        <GradientStop Color="#FFF0ED" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Path.Fill>
                            </Path>

                            <!-- Linha Principal da Curva Suave Bézier (Espessura nativa fixa, sem esticar) -->
                            <Path Data="{Binding GraficoLinhaGeometry}" 
                                  Stroke="#C25E4B" 
                                  StrokeThickness="2.5" 
                                  StrokeLineJoin="Round" 
                                  StrokeStartLineCap="Round" 
                                  StrokeEndLineCap="Round"/>

                            <!-- Colunas de Interação Hover para Cada Mês com Tooltip Rico -->
                            <ItemsControl ItemsSource="{Binding ChartMeses}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas IsItemsHost="True"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding ColumnLeft}"/>
                                        <Setter Property="Canvas.Top" Value="0"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Width="{Binding ColumnWidth}" 
                                              Height="200" 
                                              Background="Transparent" 
                                              Cursor="Hand"
                                              ToolTipService.InitialShowDelay="0"
                                              ToolTipService.BetweenShowDelay="0"
                                              ToolTipService.ShowDuration="30000">
                                            <ToolTipService.ToolTip>
                                                <Border Background="#2B2423" 
                                                        CornerRadius="8" 
                                                        Padding="14,10" 
                                                        BorderBrush="#4A3F3D" 
                                                        BorderThickness="1"
                                                        SnapsToDevicePixels="True">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="14" Direction="270" ShadowDepth="4" Opacity="0.35" Color="#000000"/>
                                                    </Border.Effect>
                                                    <StackPanel MinWidth="195">
                                                        <TextBlock Text="{Binding MesNomeCompletoAno}" FontSize="12" FontWeight="Bold" Foreground="White" Margin="0,0,0,4" TextTrimming="CharacterEllipsis"/>
                                                        <Border Height="1" Background="#4A3F3D" Margin="0,0,0,6"/>
                                                        
                                                        <!-- Linha 1: Faturamento -->
                                                        <Grid Margin="0,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="Faturamento:" FontSize="11" Foreground="#DDD5D2" Margin="0,0,12,0"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding ValorFormatado}" FontSize="11" FontWeight="Bold" Foreground="#81C784" HorizontalAlignment="Right" TextAlignment="Right"/>
                                                        </Grid>

                                                        <!-- Linha 2: Atendimentos -->
                                                        <Grid Margin="0,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="Atendimentos:" FontSize="11" Foreground="#DDD5D2" Margin="0,0,12,0"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding TotalAtendimentosTexto}" FontSize="11" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Right" TextAlignment="Right"/>
                                                        </Grid>

                                                        <!-- Linha 3: Ticket Médio -->
                                                        <Grid Margin="0,2" Visibility="{Binding TemAtendimentos, Converter={StaticResource BoolToVis}}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="Ticket Médio:" FontSize="11" Foreground="#DDD5D2" Margin="0,0,12,0"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding TicketMedioFormatado}" FontSize="11" FontWeight="SemiBold" Foreground="#FFD54F" HorizontalAlignment="Right" TextAlignment="Right"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                            </ToolTipService.ToolTip>

                                            <!-- Efeito de Destaque da Coluna no Hover -->
                                            <Border x:Name="HoverHighlight" 
                                                    Background="#64423C" 
                                                    Opacity="0" 
                                                    CornerRadius="6" 
                                                    Margin="2,20,2,30"/>

                                            <!-- Linha Guia Vertical que acende no Hover -->
                                            <Line x:Name="GuideLine" 
                                                  X1="{Binding LocalCenterX}" Y1="25" 
                                                  X2="{Binding LocalCenterX}" Y2="165" 
                                                  Stroke="#C25E4B" StrokeThickness="1" StrokeDashArray="3 3" 
                                                  Opacity="0"/>

                                            <!-- Pontos do Gráfico na Posição Exata do Valor -->
                                            <Canvas>
                                                <!-- Halo de Pulso ao Redor do Ponto -->
                                                <Ellipse x:Name="HaloCircle" 
                                                         Canvas.Left="{Binding LocalPointLeft}" 
                                                         Canvas.Top="{Binding LocalPointTop}" 
                                                         Width="16" Height="16" Margin="-4,-4,0,0"
                                                         Fill="#C25E4B" Opacity="0"/>

                                                <!-- Ponto Central na Curva (Círculo perfeito nativo, sem esticar) -->
                                                <Ellipse x:Name="PointCircle" 
                                                         Canvas.Left="{Binding LocalPointLeft}" 
                                                         Canvas.Top="{Binding LocalPointTop}" 
                                                         Width="8" Height="8"
                                                         Fill="White" Stroke="#C25E4B" StrokeThickness="2.5"/>
                                            </Canvas>
                                        </Grid>

                                        <DataTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="HoverHighlight" Property="Opacity" Value="0.06"/>
                                                <Setter TargetName="GuideLine" Property="Opacity" Value="0.75"/>
                                                <Setter TargetName="HaloCircle" Property="Opacity" Value="0.3"/>
                                                <Setter TargetName="PointCircle" Property="Fill" Value="#C25E4B"/>
                                                <Setter TargetName="PointCircle" Property="Stroke" Value="White"/>
                                            </Trigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Mensagem se Não Houver Dados no Período -->
                            <Border Background="#F9F7F6" 
                                    BorderBrush="{StaticResource BrushBorder}" 
                                    BorderThickness="1" 
                                    CornerRadius="8" 
                                    Padding="16,10" 
                                    HorizontalAlignment="Center" 
                                    VerticalAlignment="Center" 
                                    Visibility="{Binding SemDadosNoGrafico, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Info24" FontSize="15" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,8,0"/>
                                    <TextBlock Text="Nenhum faturamento registrado para o período selecionado." FontSize="12" Foreground="{StaticResource BrushTextSecondary}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- Eixo X com os Meses (Alinhado 100% com as Colunas do Gráfico sem Viewbox) -->
                    <Grid Margin="65,6,0,0" Height="22" ClipToBounds="True">
                        <Canvas Height="22">
                            <ItemsControl ItemsSource="{Binding ChartMeses}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas IsItemsHost="True"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding ColumnLeft}"/>
                                        <Setter Property="Canvas.Top" Value="0"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Width="{Binding ColumnWidth}" 
                                                   Text="{Binding MesNome}" 
                                                   FontSize="11" 
                                                   FontWeight="Medium" 
                                                   Foreground="{StaticResource BrushTextSecondary}" 
                                                   TextAlignment="Center"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Canvas>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===================== 3. TABELA DETALHADA + TOP CLIENTES ===================== -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <!-- COLUNA ESQUERDA: TABELA MÊS A MÊS -->
                <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Detalhamento Mês a Mês" FontSize="15" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,12"/>

                        <!-- Cabeçalho da Tabela com Larguras Fixas para Suportar Grandes Volumes -->
                        <Border Background="#F9F6F5" CornerRadius="6" Padding="14,9" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="140"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Mês" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Atendimentos" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}" TextAlignment="Right" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="Ticket Médio" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}" TextAlignment="Right" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="Total Faturado" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}" TextAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Lista dos Meses com Colunas Alinhadas aos Mesmos Tamanhos do Cabeçalho -->
                        <ItemsControl ItemsSource="{Binding MesesDetalhados}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#F3ECE8" BorderThickness="0,0,0,1" Padding="14,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="140"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding NomeMes}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1" Text="{Binding TotalAtendimentos}" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" TextAlignment="Right" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding TicketMedioTexto}" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" TextAlignment="Right" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding TotalFaturadoTexto}" FontSize="12" FontWeight="Bold" Foreground="#2E7D32" TextAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- COLUNA DIREITA: TOP CLIENTES QUE MAIS CONSOMEM -->
                <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="12" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Clientes que Mais Consomem" FontSize="15" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,4"/>
                        <TextBlock Text="Maiores faturamentos do período" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,14"/>

                        <ItemsControl ItemsSource="{Binding TopClientes}" Visibility="{Binding TemTopClientes, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#F3ECE8" BorderThickness="0,0,0,1" Padding="0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28"/>
                                                <ColumnDefinition Width="36"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Posição -->
                                            <TextBlock Grid.Column="0" Text="{Binding Posicao}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>

                                            <!-- Avatar -->
                                            <Border Grid.Column="1" Width="30" Height="30" CornerRadius="15" Background="{Binding AvatarBg}" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Iniciais}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- Nome e Atendimentos -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding Nome}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding AtendimentosTexto}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                                            </StackPanel>

                                            <!-- Total Gasto -->
                                            <TextBlock Grid.Column="3" Text="{Binding TotalGastoTexto}" FontSize="13" FontWeight="Bold" Foreground="#2E7D32" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Mensagem quando não houver clientes -->
                        <Border Height="180" Background="#FAFAFA" CornerRadius="8" Visibility="{Binding SemTopClientes, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Nenhum consumo faturado no período." FontSize="12" Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
