<UserControl x:Class="GerenciadorSalao.Views.ServicosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:GerenciadorSalao.ViewModels"
             xmlns:helpers="clr-namespace:GerenciadorSalao.Helpers"
             d:DataContext="{d:DesignInstance Type=vm:ServicosViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1100">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Estilo dos Campos de Formulário (Inputs Modernos) -->
        <Style x:Key="ModalTextBoxStyle" TargetType="TextBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
            <Setter Property="Background" Value="#F8F6F5"/>
            <Setter Property="BorderBrush" Value="#E8E2E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BrushPrimary}"/>
                                <Setter TargetName="border" Property="Background" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo dos Cards de Serviço -->
        <Style x:Key="ServiceCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BrushSurface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="22,20"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#D8CEC9"/>
                    <Setter Property="Background" Value="#FCFBFA"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- ===================== CONTEÚDO PRINCIPAL DA TELA ===================== -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="28,20,28,32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- 1. Header da Página -->
                    <RowDefinition Height="Auto"/> <!-- 2. Barra de Busca e Contador -->
                    <RowDefinition Height="*"/>    <!-- 3. Cards de Serviços ou Empty State -->
                    <RowDefinition Height="Auto"/> <!-- 4. Barra de Paginação -->
                </Grid.RowDefinitions>

                <!-- ===================== 1. HEADER DA PÁGINA ===================== -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Serviços" 
                                   FontSize="26" 
                                   FontWeight="Bold" 
                                   Foreground="{StaticResource BrushTextPrimary}"/>
                        <TextBlock Text="Seu talento, organizado em cada serviço." 
                                   FontSize="13" 
                                   Foreground="{StaticResource BrushTextSecondary}" 
                                   Margin="0,3,0,0"/>
                    </StackPanel>

                    <!-- Botão Novo Serviço -->
                    <Button Grid.Column="1"
                            Command="{Binding AbrirNovoServicoCommand}"
                            Style="{StaticResource PrimaryActionButtonStyle}"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Add24" FontSize="15" Foreground="White" Margin="0,0,6,0"/>
                            <TextBlock Text="Novo serviço" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- ===================== 2. BARRA DE BUSCA E CONTADOR ===================== -->
                <Grid Grid.Row="1" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Caixa de Pesquisa com Ícone de Lupa -->
                    <Border Grid.Column="0"
                            Background="{StaticResource BrushSurface}"
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <ui:SymbolIcon Grid.Column="0" 
                                           Symbol="Search24" 
                                           FontSize="15" 
                                           Foreground="{StaticResource BrushTextSecondary}" 
                                           VerticalAlignment="Center" 
                                           Margin="0,0,8,0"/>

                            <TextBox x:Name="TxtBuscaServicos"
                                     Grid.Column="1"
                                     Text="{Binding TermoBusca, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="12"
                                     Foreground="{StaticResource BrushTextPrimary}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="0"
                                     Margin="0"
                                     VerticalContentAlignment="Center"/>

                            <!-- Placeholder Text -->
                            <TextBlock Grid.Column="1"
                                       Text="Buscar serviço por nome..."
                                       FontSize="12"
                                       Foreground="{StaticResource BrushTextSecondary}"
                                       VerticalAlignment="Center"
                                       Padding="0"
                                       Margin="0"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding TermoBusca}" Value=""/>
                                                    <Condition Binding="{Binding IsKeyboardFocused, ElementName=TxtBuscaServicos}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- Contador de Serviços à Direita -->
                    <TextBlock Grid.Column="1" 
                               HorizontalAlignment="Right" 
                               VerticalAlignment="Center"
                               FontSize="12" 
                               Foreground="{StaticResource BrushTextSecondary}">
                        <Run Text="{Binding TotalServicosTexto}"/>
                    </TextBlock>
                </Grid>

                <!-- ===================== 3. GRID DE CARDS DE SERVIÇOS ===================== -->
                <Grid Grid.Row="2">
                    <!-- Lista em Cards quando há serviços -->
                    <ItemsControl ItemsSource="{Binding Servicos}" 
                                  Visibility="{Binding TemServicos, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ServiceCardStyle}" 
                                        Width="275" 
                                        Margin="0,0,16,16">
                                    <StackPanel>
                                        <!-- Ícone do Serviço (Tesoura) com Fundo Blush/Terracota Suave Rosé Studio -->
                                        <Border Width="42" 
                                                Height="42" 
                                                CornerRadius="10" 
                                                Background="#F7EBE5" 
                                                HorizontalAlignment="Left" 
                                                Margin="0,0,0,16">
                                            <ui:SymbolIcon Symbol="Cut24" 
                                                           FontSize="20" 
                                                           Foreground="#8C6558" 
                                                           HorizontalAlignment="Center" 
                                                           VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Nome / Descrição do Serviço com Especificação -->
                                        <TextBlock Text="{Binding NomeExibicao}" 
                                                   FontSize="15" 
                                                   FontWeight="SemiBold" 
                                                   Foreground="{StaticResource BrushTextPrimary}" 
                                                   TextWrapping="Wrap" 
                                                   MaxHeight="42"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding NomeExibicao}"
                                                   Margin="0,0,0,6"/>

                                        <!-- Duração com Ícone de Relógio -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,18">
                                            <ui:SymbolIcon Symbol="Clock24" 
                                                           FontSize="14" 
                                                           Foreground="{StaticResource BrushTextSecondary}" 
                                                           VerticalAlignment="Center" 
                                                           Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding DuracaoFormatada}" 
                                                       FontSize="13" 
                                                       Foreground="{StaticResource BrushTextSecondary}" 
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Linha Divisória Sutil -->
                                        <Border Height="1" 
                                                Background="#F0EAE8" 
                                                Margin="0,0,0,14"/>

                                        <!-- Rodapé do Card: Valor à Esquerda e Ações à Direita -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Preço em Destaque -->
                                            <TextBlock Grid.Column="0" 
                                                       Text="{Binding ValorFormatado}" 
                                                       FontSize="17" 
                                                       FontWeight="Bold" 
                                                       Foreground="{StaticResource BrushTextPrimary}" 
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,0,8,0"
                                                       VerticalAlignment="Center"/>

                                            <!-- Botões de Ação (Editar e Excluir) -->
                                            <StackPanel Grid.Column="1" 
                                                        Orientation="Horizontal" 
                                                        VerticalAlignment="Center">
                                                <!-- Botão Editar -->
                                                <Button Command="{Binding DataContext.AbrirEditarServicoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Editar serviço"
                                                        Style="{StaticResource IconButtonEditStyle}"
                                                        Margin="0,0,3,0">
                                                    <ui:SymbolIcon Symbol="Edit24" FontSize="15" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                </Button>

                                                <!-- Botão Excluir -->
                                                <Button Command="{Binding DataContext.AbrirExcluirServicoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Excluir serviço"
                                                        Style="{StaticResource IconButtonTrashStyle}">
                                                    <ui:SymbolIcon Symbol="Delete24" FontSize="15" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Estado Vazio (Sem Serviços ou Nenhum Resultado) -->
                    <Border Visibility="{Binding SemServicos, Converter={StaticResource BoolToVis}}"
                            Background="{StaticResource BrushSurface}"
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="48,56">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="56" Height="56" CornerRadius="14" Background="#F7EBE5" Margin="0,0,0,16" HorizontalAlignment="Center">
                                <ui:SymbolIcon Symbol="Cut24" FontSize="26" Foreground="#8C6558" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Nenhum serviço cadastrado" 
                                       FontSize="16" 
                                       FontWeight="SemiBold" 
                                       Foreground="{StaticResource BrushTextPrimary}" 
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Cadastre serviços para gerenciar atendimentos e compor suas comandas." 
                                       FontSize="12" 
                                       Foreground="{StaticResource BrushTextSecondary}" 
                                       Margin="0,5,0,20" 
                                       HorizontalAlignment="Center"/>
                            <Button Command="{Binding AbrirNovoServicoCommand}"
                                    Style="{StaticResource PrimaryActionButtonStyle}"
                                    HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Add24" FontSize="15" Foreground="White" Margin="0,0,6,0"/>
                                    <TextBlock Text="Novo serviço" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Barra de Paginação de Serviços -->
                <Border Grid.Row="3" 
                        Margin="0,16,0,0"
                        Background="{StaticResource BrushSurface}"
                        BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="16,10"
                        Visibility="{Binding TemServicos, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" 
                                   Text="{Binding TextoPaginacao}" 
                                   FontSize="12" 
                                   Foreground="{StaticResource BrushTextSecondary}" 
                                   VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Command="{Binding PaginaAnteriorCommand}"
                                    IsEnabled="{Binding PodeVoltarPagina}"
                                    Style="{StaticResource OutlineActionButtonStyle}"
                                    Padding="12,6"
                                    Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="ChevronLeft24" FontSize="14" Margin="0,0,4,0"/>
                                    <TextBlock Text="Anterior" FontSize="12"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ProximaPaginaCommand}"
                                    IsEnabled="{Binding PodeAvancarPagina}"
                                    Style="{StaticResource OutlineActionButtonStyle}"
                                    Padding="12,6">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Próxima" FontSize="12"/>
                                    <ui:SymbolIcon Symbol="ChevronRight24" FontSize="14" Margin="4,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- ===================== MODAL: NOVO / EDITAR SERVIÇO ===================== -->
        <Grid Visibility="{Binding IsModalServicoAberto, Converter={StaticResource BoolToVis}}">
            <Border Background="#55000000" Cursor="Hand" MouseLeftButtonDown="FecharModalServico_MouseLeftButtonDown"/>
            <Border Background="White" 
                    CornerRadius="14" 
                    Width="440" 
                    MaxHeight="520"
                    Padding="24,20" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center">
                <Border.RenderTransform>
                    <TranslateTransform X="{Binding DataContext.IsSidebarOpen, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SidebarToModalOffsetXConverter}}"
                                        Y="0"/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" Direction="270" ShadowDepth="6" Opacity="0.18" Color="#201C1B"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Row 0: Header fixo -->
                        <RowDefinition Height="*"/>    <!-- Row 1: Corpo rolável -->
                        <RowDefinition Height="Auto"/> <!-- Row 2: Rodapé / Ações fixas -->
                    </Grid.RowDefinitions>

                    <!-- 0. Header com Título, Subtítulo e Botão Fechar (X) -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="{Binding ModalTitulo}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="Detalhes do cadastro." FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                                HorizontalAlignment="Right" 
                                VerticalAlignment="Top" 
                                Command="{Binding FecharModalServicoCommand}" 
                                Style="{StaticResource ModalCloseButtonStyle}">
                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                    </Grid>

                    <!-- 1. Corpo Rolável com ScrollViewer -->
                    <ScrollViewer Grid.Row="1" 
                                  VerticalScrollBarVisibility="Auto" 
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="0,0,6,0"
                                  Margin="0,0,0,6">
                        <StackPanel>
                            <!-- Campo Descrição -->
                            <TextBlock Text="Descrição" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,4"/>
                            <TextBox Style="{StaticResource ModalTextBoxStyle}" 
                                     Text="{Binding FormDescricao, UpdateSourceTrigger=PropertyChanged}" 
                                     MaxLength="100"
                                     Margin="0,0,0,12"/>

                            <!-- Campo Especificação -->
                            <TextBlock Text="Especificação (opcional)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,4"/>
                            <TextBox Style="{StaticResource ModalTextBoxStyle}" 
                                     Text="{Binding FormEspecificacao, UpdateSourceTrigger=PropertyChanged}" 
                                     MaxLength="100"
                                     Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding NomeExibicaoPreview, StringFormat='{}Exibição: {0}'}" 
                                       FontSize="11" 
                                       Foreground="{StaticResource BrushTextSecondary}" 
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,0,0,12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding NomeExibicaoPreview}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Campo Valor (R$) -->
                            <TextBlock Text="Valor (R$)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,4"/>
                            <TextBox Style="{StaticResource ModalTextBoxStyle}" 
                                     helpers:MaskHelper.Mask="Currency"
                                     Text="{Binding FormValor, UpdateSourceTrigger=PropertyChanged}" 
                                     MaxLength="12"
                                     Margin="0,0,0,12"/>

                            <!-- Campo Tempo Estimado -->
                            <TextBlock Text="Tempo estimado (hh:mm ou minutos)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,4"/>
                            <TextBox Style="{StaticResource ModalTextBoxStyle}" 
                                     helpers:MaskHelper.Mask="Duration"
                                     Text="{Binding FormDuracao, UpdateSourceTrigger=PropertyChanged}" 
                                     MaxLength="8"
                                     Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding FormDuracaoPreview}" 
                                       FontSize="11" 
                                       Foreground="{StaticResource BrushTextSecondary}" 
                                       Margin="0,0,0,8"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 2. Rodapé Fixo / Ações (Nunca Cortado Fora da Tela) -->
                    <StackPanel Grid.Row="2">
                        <!-- Mensagem de Validação / Erro -->
                        <Border Background="#FDECEA" 
                                CornerRadius="6" 
                                Padding="10,6" 
                                Margin="0,0,0,8">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FormMensagemErro}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding FormMensagemErro}" FontSize="11" Foreground="#C62828" TextWrapping="Wrap"/>
                        </Border>

                        <Button Command="{Binding SalvarServicoCommand}"
                                Style="{StaticResource PrimaryActionButtonStyle}"
                                Padding="0,11"
                                HorizontalAlignment="Stretch">
                            <TextBlock Text="Salvar serviço" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ===================== MODAL: EXCLUIR SERVIÇO ===================== -->
        <Grid Visibility="{Binding IsModalExcluirAberto, Converter={StaticResource BoolToVis}}">
            <Border Background="#55000000" Cursor="Hand" MouseLeftButtonDown="FecharModalExcluir_MouseLeftButtonDown"/>
            <Border Background="White" 
                    CornerRadius="14" 
                    Width="440" 
                    Padding="26,24" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center">
                <Border.RenderTransform>
                    <TranslateTransform X="{Binding DataContext.IsSidebarOpen, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SidebarToModalOffsetXConverter}}"
                                        Y="-26"/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" Direction="270" ShadowDepth="6" Opacity="0.18" Color="#201C1B"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header -->
                        <RowDefinition Height="Auto"/> <!-- Descrição -->
                        <RowDefinition Height="Auto"/> <!-- Botão Excluir -->
                    </Grid.RowDefinitions>

                    <!-- Header com Título e Botão Fechar -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Excluir serviço?" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                        <Button HorizontalAlignment="Right" 
                                VerticalAlignment="Top" 
                                Command="{Binding FecharModalExcluirCommand}" 
                                Style="{StaticResource ModalCloseButtonStyle}">
                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                    </Grid>

                    <!-- Mensagem Informativa de Exclusão -->
                    <TextBlock Grid.Row="1" 
                               Text="{Binding ServicoParaExcluir.NomeExibicao, StringFormat='{}{0}. Esta ação não pode ser desfeita. Cadastros com atendimentos vinculados são preservados.'}" 
                               FontSize="13" 
                               Foreground="{StaticResource BrushTextSecondary}" 
                               TextWrapping="Wrap" 
                               LineHeight="18"
                               Margin="0,0,0,20"/>

                    <!-- Botão Confirmar Exclusão -->
                    <Button Grid.Row="2"
                            Command="{Binding ConfirmarExclusaoCommand}"
                            Style="{StaticResource DangerActionButtonStyle}"
                            Padding="0,12"
                            HorizontalAlignment="Stretch">
                        <TextBlock Text="Confirmar exclusão" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
