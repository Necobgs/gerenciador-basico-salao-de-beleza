<UserControl x:Class="GerenciadorSalao.Views.AgendamentosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1100">

    <UserControl.Resources>
        <!-- Estilo do Botão Primário (+ Novo agendamento / Salvar agendamento) -->
        <Style x:Key="PrimaryActionButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="{StaticResource BrushPrimary}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BrushPrimaryHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#553732"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo do Botão Outline (Abrir comanda →) -->
        <Style x:Key="OutlineActionButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2D7D1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FAF6F4"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F3ECE8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo dos Botões Segmentados de Filtro (Todos / Agendados / Em atendimento) -->
        <Style x:Key="SegmentedTabRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="tabBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="#ECE5E0"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter TargetName="tabBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="4" Direction="270" ShadowDepth="1" Opacity="0.08" Color="#302B2A"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo dos Botões de Navegação do Mês no Calendário (↑ / ↓) -->
        <Style x:Key="CalendarNavButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F5F2F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo dos Botões de Ação de Texto (Limpar / Hoje) -->
        <Style x:Key="FlatActionButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" Padding="6,4" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BrushInfoSubtle}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo do Botão Ícone de Lixeira (Excluir Agendamento / Remover Serviço) -->
        <Style x:Key="IconButtonTrashStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FEECE9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo do Botão Fechar Modal (✕) -->
        <Style x:Key="ModalCloseButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F0ECE9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo do Botão '+' de Adicionar Serviço no Modal -->
        <Style x:Key="FormAddButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="#A89893"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#95847F"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#7E6E69"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo ComboBox para os Formulários do Modal com Suporte a Placeholder -->
        <ControlTemplate x:Key="FormComboBoxToggleButtonTemplate" TargetType="ToggleButton">
            <Border x:Name="Border"
                    Background="{StaticResource BrushSurface}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock x:Name="Placeholder"
                                   Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                   FontSize="12"
                                   Foreground="{StaticResource BrushTextSecondary}"
                                   Visibility="Collapsed"/>
                        <ContentPresenter x:Name="ContentSite"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          VerticalAlignment="Center"/>
                    </Grid>
                    
                    <ui:SymbolIcon Grid.Column="1"
                                   Symbol="ChevronDown24"
                                   FontSize="14"
                                   Foreground="{StaticResource BrushTextSecondary}"
                                   VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <DataTrigger Binding="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" Value="{x:Null}">
                    <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                    <Setter TargetName="Border" Property="Background" Value="#FAF8F7"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource BrushPrimary}"/>
                    <Setter TargetName="Border" Property="Background" Value="#FAF8F7"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="FormComboBoxStyle" TargetType="ComboBox">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Template="{StaticResource FormComboBoxToggleButtonTemplate}">
                                <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                  VerticalAlignment="Center"/>
                            </ToggleButton>

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade"
                                   VerticalOffset="4">
                                <Border x:Name="DropDownBorder"
                                        Background="{StaticResource BrushSurface}"
                                        BorderBrush="{StaticResource BrushBorder}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="260"
                                        Padding="4"
                                        SnapsToDevicePixels="True">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="4" Opacity="0.14" Color="#34302F"/>
                                    </Border.Effect>
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBorder"
                                            Background="Transparent"
                                            CornerRadius="6"
                                            Padding="{TemplateBinding Padding}"
                                            Margin="0,1">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource BrushSurfaceSubtle}"/>
                                            <Setter Property="Foreground" Value="{StaticResource BrushPrimary}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#66605E"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Grid Principal com Camada de Conteúdo e Camada Modal -->
    <Grid>
        <!-- ========================================================================= -->
        <!-- CAMADA 0: CONTEÚDO PRINCIPAL DA TELA DE AGENDA                            -->
        <!-- ========================================================================= -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="32,24,32,32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- 1. Header (Agenda / Subtítulo / Botão Novo Agendamento) -->
                    <RowDefinition Height="Auto"/> <!-- 2. Barra de Filtros (Data + Pílulas Todos/Agendados/Em atendimento + Contador) -->
                    <RowDefinition Height="*"/>    <!-- 3. Lista de Cards de Agendamentos -->
                </Grid.RowDefinitions>

                <!-- ===================== 1. HEADER DA PÁGINA ===================== -->
                <Grid Grid.Row="0" Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Titulo}" 
                                   FontSize="26" 
                                   FontWeight="Bold" 
                                   Foreground="{StaticResource BrushTextPrimary}"/>
                        <TextBlock Text="{Binding Subtitulo}" 
                                   FontSize="13" 
                                   Foreground="{StaticResource BrushTextSecondary}" 
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Botão Novo Agendamento -->
                    <Button Grid.Column="1"
                            Command="{Binding AbrirModalNovoAgendamentoCommand}"
                            Style="{StaticResource PrimaryActionButtonStyle}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Add24" FontSize="15" Foreground="White" Margin="0,0,6,0"/>
                            <TextBlock Text="Novo agendamento" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- ===================== 2. BARRA DE FILTROS ===================== -->
                <Grid Grid.Row="1" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Seletor de Data com Calendário Dropdown -->
                        <Grid Margin="0,0,12,0">
                            <ToggleButton x:Name="btnDatePicker"
                                          IsChecked="{Binding IsCalendarOpen, Mode=TwoWay}"
                                          FocusVisualStyle="{x:Null}"
                                          Cursor="Hand"
                                          OverridesDefaultStyle="True">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="btnBorder"
                                                Background="{StaticResource BrushSurface}"
                                                BorderBrush="{StaticResource BrushBorder}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="14,8">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DataSelecionadaFormatada}" 
                                                           FontSize="12" 
                                                           FontWeight="Medium" 
                                                           Foreground="{StaticResource BrushTextPrimary}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,10,0"/>
                                                <ui:SymbolIcon Symbol="CalendarLtr24" FontSize="15" Foreground="{StaticResource BrushTextSecondary}"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                                <Setter TargetName="btnBorder" Property="Background" Value="#FAF8F7"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="{StaticResource BrushPrimary}"/>
                                                <Setter TargetName="btnBorder" Property="Background" Value="#FAF8F7"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <!-- Popup do Calendário Suspenso -->
                            <Popup Placement="Bottom"
                                   PlacementTarget="{Binding ElementName=btnDatePicker}"
                                   IsOpen="{Binding IsCalendarOpen, Mode=TwoWay}"
                                   StaysOpen="False"
                                   AllowsTransparency="True"
                                   PopupAnimation="Fade"
                                   VerticalOffset="6">
                                <Border Background="{StaticResource BrushSurface}"
                                        BorderBrush="{StaticResource BrushBorder}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="16"
                                        Width="260"
                                        SnapsToDevicePixels="True">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="4" Opacity="0.12" Color="#34302F"/>
                                    </Border.Effect>

                                    <StackPanel>
                                        <!-- Cabeçalho do Mês / Ano e Navegação (↑ / ↓) -->
                                        <Grid Margin="2,0,2,12">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding MesVisualizadoTexto}" 
                                                           FontSize="13" 
                                                           FontWeight="Bold" 
                                                           Foreground="{StaticResource BrushTextPrimary}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text=" ▾" 
                                                           FontSize="10" 
                                                           Foreground="{StaticResource BrushTextSecondary}" 
                                                           VerticalAlignment="Center" 
                                                           Margin="2,0,0,0"/>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <Button Command="{Binding MesAnteriorCommand}"
                                                        ToolTip="Mês anterior"
                                                        Style="{StaticResource CalendarNavButtonStyle}"
                                                        Margin="0,0,2,0">
                                                    <ui:SymbolIcon Symbol="ArrowUp24" FontSize="13" Foreground="{StaticResource BrushTextPrimary}"/>
                                                </Button>
                                                <Button Command="{Binding MesProximoCommand}"
                                                        ToolTip="Próximo mês"
                                                        Style="{StaticResource CalendarNavButtonStyle}">
                                                    <ui:SymbolIcon Symbol="ArrowDown24" FontSize="13" Foreground="{StaticResource BrushTextPrimary}"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Cabeçalho dos Dias da Semana: D S T Q Q S S -->
                                        <UniformGrid Columns="7" Margin="0,0,0,8">
                                            <TextBlock Text="D" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="S" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="T" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Q" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Q" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="S" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="S" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center"/>
                                        </UniformGrid>

                                        <!-- Grade de Dias do Mês (42 células) -->
                                        <ItemsControl ItemsSource="{Binding DiasCalendario}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="7" Rows="6"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding DataContext.SelecionarDataCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding Data}"
                                                            FocusVisualStyle="{x:Null}"
                                                            Cursor="Hand"
                                                            Margin="0,2"
                                                            OverridesDefaultStyle="True">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="dayBorder"
                                                                        Width="28" Height="28"
                                                                        CornerRadius="4"
                                                                        Background="Transparent"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center">
                                                                    <TextBlock x:Name="dayText"
                                                                               Text="{Binding Dia}"
                                                                               FontSize="12"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"
                                                                               Foreground="{StaticResource BrushTextPrimary}"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMesAtual}" Value="False">
                                                                        <Setter TargetName="dayText" Property="Foreground" Value="#A8A29E"/>
                                                                    </DataTrigger>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                                                                            <Condition Binding="{Binding IsSelecionado}" Value="False"/>
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter TargetName="dayBorder" Property="Background" Value="#F5F2F0"/>
                                                                    </MultiDataTrigger>
                                                                    <DataTrigger Binding="{Binding IsSelecionado}" Value="True">
                                                                        <Setter TargetName="dayBorder" Property="Background" Value="#504746"/>
                                                                        <Setter TargetName="dayText" Property="Foreground" Value="White"/>
                                                                        <Setter TargetName="dayText" Property="FontWeight" Value="SemiBold"/>
                                                                    </DataTrigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Linha de Ações Inferior: Limpar e Hoje -->
                                        <Grid Margin="2,14,2,2">
                                            <Button Command="{Binding LimparDataCommand}"
                                                    Content="Limpar"
                                                    FontSize="12"
                                                    FontWeight="Medium"
                                                    Foreground="{StaticResource BrushInfo}"
                                                    HorizontalAlignment="Left"
                                                    Style="{StaticResource FlatActionButtonStyle}"/>

                                            <Button Command="{Binding HojeDataCommand}"
                                                    Content="Hoje"
                                                    FontSize="12"
                                                    FontWeight="Medium"
                                                    Foreground="{StaticResource BrushInfo}"
                                                    HorizontalAlignment="Right"
                                                    Style="{StaticResource FlatActionButtonStyle}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>

                        <!-- Pílulas Segmentadas de Filtro (Todos / Agendados / Em atendimento) -->
                        <Border Background="#F5EEE9" CornerRadius="8" Padding="3">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="Todos" 
                                             GroupName="FiltroAgendaGroup"
                                             IsChecked="{Binding IsFiltroTodos, Mode=TwoWay}"
                                             Style="{StaticResource SegmentedTabRadioButtonStyle}"/>
                                <RadioButton Content="Agendados" 
                                             GroupName="FiltroAgendaGroup"
                                             IsChecked="{Binding IsFiltroAgendados, Mode=TwoWay}"
                                             Style="{StaticResource SegmentedTabRadioButtonStyle}"/>
                                <RadioButton Content="Em atendimento" 
                                             GroupName="FiltroAgendaGroup"
                                             IsChecked="{Binding IsFiltroEmAtendimento, Mode=TwoWay}"
                                             Style="{StaticResource SegmentedTabRadioButtonStyle}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Contador à Direita: e.g. "5 agendamentos" -->
                    <TextBlock Grid.Column="1" 
                               Text="{Binding TotalAgendamentosTexto}" 
                               FontSize="12" 
                               Foreground="{StaticResource BrushTextSecondary}" 
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- ===================== 3. LISTA DE CARDS DE AGENDAMENTOS ===================== -->
                <Grid Grid.Row="2">
                    <!-- Estado Vazio amigável se não houver agendamentos -->
                    <Border Background="{StaticResource BrushSurface}"
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="32"
                            Margin="0,10,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AgendamentosFiltrados.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="CalendarClock24" FontSize="36" Foreground="{StaticResource BrushAccent}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock Text="Nenhum agendamento encontrado para esta data ou filtro." 
                                       FontSize="14" 
                                       FontWeight="Medium" 
                                       Foreground="{StaticResource BrushTextSecondary}" 
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Lista de Cards de Agendamentos -->
                    <ItemsControl ItemsSource="{Binding AgendamentosFiltrados}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BrushSurface}"
                                        BorderBrush="#EFE8E3"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="20,16"
                                        Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>  <!-- 0: Horário e Duração -->
                                            <ColumnDefinition Width="Auto"/> <!-- 1: Linha Divisória Vertical -->
                                            <ColumnDefinition Width="*"/>    <!-- 2: Cliente e Serviços -->
                                            <ColumnDefinition Width="Auto"/> <!-- 3: Preço, Status, Ações -->
                                        </Grid.ColumnDefinitions>

                                        <!-- Coluna 0: Horário e Duração -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Horario}"
                                                       FontSize="19"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource BrushTextPrimary}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0" VerticalAlignment="Center">
                                                <ui:SymbolIcon Symbol="Clock24" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding DuracaoTexto}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource BrushTextSecondary}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Coluna 1: Linha Divisória Vertical -->
                                        <Rectangle Grid.Column="1"
                                                   Width="1"
                                                   Fill="#EFE8E3"
                                                   Margin="20,2,24,2"
                                                   VerticalAlignment="Stretch"/>

                                        <!-- Coluna 2: Cliente e Serviços -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="{Binding NomeCliente}"
                                                       FontSize="15"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource BrushTextPrimary}"/>
                                            <TextBlock Text="{Binding ServicosTexto}"
                                                       FontSize="13"
                                                       Foreground="{StaticResource BrushTextSecondary}"
                                                       Margin="0,4,0,0"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <!-- Coluna 3: Preço, Status, Botão Abrir Comanda e Excluir -->
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Preço Total -->
                                            <TextBlock Text="{Binding ValorTotalTexto}"
                                                       FontSize="15"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource BrushTextPrimary}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,24,0"/>

                                            <!-- Badge de Status (Agendada / Em atendimento / Concluído) -->
                                            <Border Background="{Binding StatusBg}"
                                                    CornerRadius="12"
                                                    Padding="10,4"
                                                    Margin="0,0,16,0"
                                                    VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="• " Foreground="{Binding StatusFg}" FontSize="12" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding StatusTexto}" Foreground="{Binding StatusFg}" FontSize="11" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Botão 'Abrir comanda →' -->
                                            <Button Content="Abrir comanda →"
                                                    Command="{Binding DataContext.AbrirComandaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Id}"
                                                    Style="{StaticResource OutlineActionButtonStyle}"
                                                    Margin="0,0,12,0"/>

                                            <!-- Botão de Excluir / Cancelar -->
                                            <Button Command="{Binding DataContext.ExcluirAgendamentoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Id}"
                                                    ToolTip="Cancelar agendamento"
                                                    Style="{StaticResource IconButtonTrashStyle}">
                                                <ui:SymbolIcon Symbol="Delete24" FontSize="16" Foreground="{StaticResource BrushTextSecondary}"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Grid>
        </ScrollViewer>

        <!-- ========================================================================= -->
        <!-- CAMADA 1: MODAL FLUTUANTE DE NOVO AGENDAMENTO                             -->
        <!-- ========================================================================= -->
        <Grid Visibility="{Binding IsModalNovoAgendamentoAberto, Converter={StaticResource BooleanToVisibilityConverter}}">
            <!-- Fundo Escurecido / Backdrop com Bloqueio de Cliques -->
            <Border Background="#66000000"/>

            <!-- Cartão Centrado do Modal -->
            <Border Width="460"
                    MaxHeight="720"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource BrushSurface}"
                    CornerRadius="16"
                    Padding="24"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1"
                    SnapsToDevicePixels="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" Direction="270" ShadowDepth="8" Opacity="0.22" Color="#302B2A"/>
                </Border.Effect>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- Topo do Modal: Título e Botão Fechar (✕) -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Novo agendamento" 
                                       FontSize="18" 
                                       FontWeight="Bold" 
                                       Foreground="{StaticResource BrushTextPrimary}"
                                       VerticalAlignment="Center"/>

                            <Button Grid.Column="1"
                                    Command="{Binding FecharModalNovoAgendamentoCommand}"
                                    Style="{StaticResource ModalCloseButtonStyle}">
                                <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" Foreground="{StaticResource BrushTextSecondary}"/>
                            </Button>
                        </Grid>

                        <!-- Subtítulo -->
                        <TextBlock Text="Dados do atendimento" 
                                   FontSize="13" 
                                   Foreground="{StaticResource BrushTextSecondary}" 
                                   Margin="0,0,0,18"/>

                        <!-- 1. Campo Cliente -->
                        <TextBlock Text="Cliente" 
                                   FontSize="12" 
                                   FontWeight="Medium" 
                                   Foreground="{StaticResource BrushTextPrimary}" 
                                   Margin="0,0,0,6"/>
                        <ComboBox Tag="Selecione um cliente"
                                  ItemsSource="{Binding ClientesDisponiveis}"
                                  SelectedItem="{Binding ClienteSelecionado}"
                                  DisplayMemberPath="Nome"
                                  Style="{StaticResource FormComboBoxStyle}"
                                  Margin="0,0,0,14"/>

                        <!-- 2. Campo Data e Horário -->
                        <TextBlock Text="Data e horário" 
                                   FontSize="12" 
                                   FontWeight="Medium" 
                                   Foreground="{StaticResource BrushTextPrimary}" 
                                   Margin="0,0,0,6"/>
                        <Border BorderBrush="{StaticResource BrushBorder}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Height="38"
                                Padding="12,0"
                                Background="{StaticResource BrushSurface}"
                                Margin="0,0,0,14">
                            <Grid>
                                <TextBox Text="{Binding NovaDataHoraTexto, UpdateSourceTrigger=PropertyChanged}"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         FontSize="12"
                                         Foreground="{StaticResource BrushTextPrimary}"
                                         VerticalAlignment="Center"
                                         Margin="0,0,24,0"/>
                                <ui:SymbolIcon Symbol="CalendarLtr24" 
                                               FontSize="15" 
                                               Foreground="{StaticResource BrushTextSecondary}" 
                                               HorizontalAlignment="Right" 
                                               VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- 3. Campo Adicionar Serviço -->
                        <TextBlock Text="Adicionar serviço" 
                                   FontSize="12" 
                                   FontWeight="Medium" 
                                   Foreground="{StaticResource BrushTextPrimary}" 
                                   Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox Grid.Column="0"
                                      Tag="Selecione um item"
                                      ItemsSource="{Binding ServicosDisponiveis}"
                                      SelectedItem="{Binding ServicoSelecionadoParaAdicionar}"
                                      DisplayMemberPath="Descricao"
                                      Style="{StaticResource FormComboBoxStyle}"/>

                            <Button Grid.Column="1"
                                    Command="{Binding AdicionarServicoCommand}"
                                    Style="{StaticResource FormAddButtonStyle}"
                                    Margin="8,0,0,0">
                                <ui:SymbolIcon Symbol="Add24" FontSize="16" Foreground="White"/>
                            </Button>
                        </Grid>

                        <!-- Lista de Serviços Adicionados no Agendamento -->
                        <ItemsControl ItemsSource="{Binding ServicosSelecionadosParaNovo}" Margin="0,0,0,12">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#F0ECE9" BorderThickness="0,0,0,1" Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Nome e Duração do Serviço -->
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Descricao}" 
                                                           FontSize="13" 
                                                           FontWeight="Bold" 
                                                           Foreground="{StaticResource BrushTextPrimary}"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock Text="{Binding DuracaoMinutos}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                                                    <TextBlock Text=" min" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Preço e Botão Remover -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Valor, StringFormat='{}{0:C2}'}" 
                                                           FontSize="13" 
                                                           FontWeight="Bold" 
                                                           Foreground="{StaticResource BrushTextPrimary}" 
                                                           VerticalAlignment="Center" 
                                                           Margin="0,0,12,0"/>
                                                <Button Command="{Binding DataContext.RemoverServicoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource IconButtonTrashStyle}">
                                                    <ui:SymbolIcon Symbol="Delete24" FontSize="15" Foreground="{StaticResource BrushTextSecondary}"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Faixa de Totais (Tempo e Valor Total) -->
                        <Border Background="#FDF8F5" 
                                CornerRadius="8" 
                                Padding="14,12" 
                                Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Clock24" FontSize="14" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding TempoTotalMinutosTexto}" 
                                               FontSize="12" 
                                               Foreground="{StaticResource BrushTextSecondary}" 
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Grid.Column="1" 
                                           Text="{Binding ValorTotalServicosTexto}" 
                                           FontSize="13" 
                                           FontWeight="Bold" 
                                           Foreground="{StaticResource BrushTextPrimary}" 
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- 4. Campo Observação -->
                        <TextBlock Text="Observação" 
                                   FontSize="12" 
                                   FontWeight="Medium" 
                                   Foreground="{StaticResource BrushTextPrimary}" 
                                   Margin="0,0,0,6"/>
                        <TextBox Text="{Binding NovaObservacao, UpdateSourceTrigger=PropertyChanged}"
                                 Height="65"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 BorderBrush="{StaticResource BrushBorder}"
                                 BorderThickness="1"
                                 FontSize="12"
                                 Foreground="{StaticResource BrushTextPrimary}"
                                 Padding="8"
                                 Margin="0,0,0,20"/>

                        <!-- Botão Salvar Agendamento -->
                        <Button Content="Salvar agendamento"
                                Command="{Binding SalvarNovoAgendamentoCommand}"
                                Style="{StaticResource PrimaryActionButtonStyle}"
                                HorizontalAlignment="Right"
                                Padding="20,10"
                                FontSize="13"
                                FontWeight="SemiBold"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
