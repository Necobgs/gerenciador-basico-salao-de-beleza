<UserControl x:Class="GerenciadorSalao.Views.AgendamentosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:helpers="clr-namespace:GerenciadorSalao.Helpers"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1100"
             PreviewMouseDown="AgendamentosView_PreviewMouseDown"
             Unloaded="AgendamentosView_Unloaded">

    <UserControl.Resources>

        <!-- Estilo do Botão Outline (Abrir comanda →) -->
        <Style x:Key="OutlineActionButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2D7D1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FAF6F4"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F3ECE8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo dos Botões Segmentados de Filtro (Todos / Agendados / Em atendimento) -->
        <Style x:Key="SegmentedTabRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="tabBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="#ECE5E0"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter TargetName="tabBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="4" Direction="270" ShadowDepth="1" Opacity="0.08" Color="#302B2A"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo dos Botões de Navegação do Mês no Calendário (↑ / ↓) -->
        <Style x:Key="CalendarNavButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F5F2F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo dos Botões de Ação de Texto (Limpar / Hoje) -->
        <Style x:Key="FlatActionButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" Padding="6,4" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BrushInfoSubtle}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo do Botão Ícone de Lixeira (Excluir Agendamento / Remover Serviço) -->
        <Style x:Key="IconButtonTrashStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FEECE9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo do Botão Ícone de Edição de Agendamento -->
        <Style x:Key="IconButtonEditStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F3ECE8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo do Botão Fechar Modal (✕) -->
        <Style x:Key="ModalCloseButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F0ECE9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo do Botão '+' de Adicionar Serviço no Modal -->
        <Style x:Key="FormAddButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="#A89893"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#95847F"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#7E6E69"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo ComboBox para os Formulários do Modal com Suporte a Placeholder -->
        <ControlTemplate x:Key="FormComboBoxToggleButtonTemplate" TargetType="ToggleButton">
            <Border x:Name="Border"
                    Background="{StaticResource BrushSurface}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock x:Name="Placeholder"
                                   Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                   FontSize="12"
                                   Foreground="{StaticResource BrushTextSecondary}"
                                   Visibility="Collapsed"/>
                        <ContentPresenter x:Name="ContentSite"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          VerticalAlignment="Center"/>
                    </Grid>
                    
                    <ui:SymbolIcon Grid.Column="1"
                                   Symbol="ChevronDown24"
                                   FontSize="14"
                                   Foreground="{StaticResource BrushTextSecondary}"
                                   VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <DataTrigger Binding="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" Value="{x:Null}">
                    <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                    <Setter TargetName="Border" Property="Background" Value="#FAF8F7"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource BrushPrimary}"/>
                    <Setter TargetName="Border" Property="Background" Value="#FAF8F7"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="FormComboBoxStyle" TargetType="ComboBox">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Template="{StaticResource FormComboBoxToggleButtonTemplate}">
                                <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                  VerticalAlignment="Center"/>
                            </ToggleButton>

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade"
                                   VerticalOffset="4">
                                <Border x:Name="DropDownBorder"
                                        Background="{StaticResource BrushSurface}"
                                        BorderBrush="{StaticResource BrushBorder}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="260"
                                        Padding="4"
                                        SnapsToDevicePixels="True">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="4" Opacity="0.14" Color="#34302F"/>
                                    </Border.Effect>
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBorder"
                                            Background="Transparent"
                                            CornerRadius="6"
                                            Padding="{TemplateBinding Padding}"
                                            Margin="0,1">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource BrushSurfaceSubtle}"/>
                                            <Setter Property="Foreground" Value="{StaticResource BrushPrimary}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#66605E"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo dos Campos de Formulário Modernos -->
        <Style x:Key="ModalTextBoxStyle" TargetType="TextBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
            <Setter Property="Background" Value="#F8F6F5"/>
            <Setter Property="BorderBrush" Value="#E8E2E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BrushPrimary}"/>
                                <Setter TargetName="border" Property="Background" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Grid Principal com Camada de Conteúdo e Camada Modal -->
    <Grid>
        <!-- ========================================================================= -->
        <!-- CAMADA 0: CONTEÚDO PRINCIPAL DA TELA DE AGENDA                            -->
        <!-- ========================================================================= -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="32,24,32,32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- 1. Header (Agenda / Subtítulo / Botão Novo Agendamento) -->
                    <RowDefinition Height="Auto"/> <!-- 2. Barra de Filtros (Data + Pílulas Todos/Agendados/Em atendimento + Contador) -->
                    <RowDefinition Height="*"/>    <!-- 3. Lista de Cards de Agendamentos -->
                </Grid.RowDefinitions>

                <!-- ===================== 1. HEADER DA PÁGINA ===================== -->
                <Grid Grid.Row="0" Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Titulo}" 
                                   FontSize="26" 
                                   FontWeight="Bold" 
                                   Foreground="{StaticResource BrushTextPrimary}"/>
                        <TextBlock Text="{Binding Subtitulo}" 
                                   FontSize="13" 
                                   Foreground="{StaticResource BrushTextSecondary}" 
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Botões do Header (Calendário iPhone + Novo Agendamento) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Botão Calendário iPhone / iCloud -->
                        <Button Command="{Binding AbrirModalICloudCommand}"
                                Style="{StaticResource OutlineActionButtonStyle}"
                                Padding="12,8"
                                Margin="0,0,10,0"
                                ToolTip="Sincronização Offline-First com Calendário do iPhone (iCloud)">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="{Binding ICloudStatusCor}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <ui:SymbolIcon Symbol="Phone24" FontSize="15" Margin="0,0,6,0" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ICloudBotaoHeaderTexto}" FontSize="12" FontWeight="Medium" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Botão Novo Agendamento -->
                        <Button Command="{Binding AbrirModalNovoAgendamentoCommand}"
                                Style="{StaticResource PrimaryActionButtonStyle}"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Add24" FontSize="15" Foreground="White" Margin="0,0,6,0"/>
                                <TextBlock Text="Novo agendamento" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ===================== 2. BARRA DE FILTROS ===================== -->
                <Grid Grid.Row="1" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Seletor de Data com Calendário Dropdown -->
                        <Grid Margin="0,0,12,0">
                            <ToggleButton x:Name="btnDatePicker"
                                          IsChecked="{Binding IsCalendarOpen, Mode=TwoWay}"
                                          FocusVisualStyle="{x:Null}"
                                          Cursor="Hand"
                                          OverridesDefaultStyle="True">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="btnBorder"
                                                Background="{StaticResource BrushSurface}"
                                                BorderBrush="{StaticResource BrushBorder}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="14,8">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DataSelecionadaFormatada}" 
                                                           FontSize="12" 
                                                           FontWeight="Medium" 
                                                           Foreground="{StaticResource BrushTextPrimary}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,10,0"/>
                                                <ui:SymbolIcon Symbol="CalendarLtr24" FontSize="15" Foreground="{StaticResource BrushTextSecondary}"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                                <Setter TargetName="btnBorder" Property="Background" Value="#FAF8F7"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="{StaticResource BrushPrimary}"/>
                                                <Setter TargetName="btnBorder" Property="Background" Value="#FAF8F7"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <!-- Popup do Calendário Suspenso -->
                            <Popup Placement="Bottom"
                                   PlacementTarget="{Binding ElementName=btnDatePicker}"
                                   IsOpen="{Binding IsCalendarOpen, Mode=TwoWay}"
                                   StaysOpen="False"
                                   AllowsTransparency="True"
                                   PopupAnimation="Fade"
                                   VerticalOffset="6">
                                <Border Background="{StaticResource BrushSurface}"
                                        BorderBrush="{StaticResource BrushBorder}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="16"
                                        Width="260"
                                        SnapsToDevicePixels="True">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="4" Opacity="0.12" Color="#34302F"/>
                                    </Border.Effect>

                                    <StackPanel>
                                        <!-- Cabeçalho do Mês / Ano e Navegação (↑ / ↓) -->
                                        <Grid Margin="2,0,2,12">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding MesVisualizadoTexto}" 
                                                           FontSize="13" 
                                                           FontWeight="Bold" 
                                                           Foreground="{StaticResource BrushTextPrimary}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text=" ▾" 
                                                           FontSize="10" 
                                                           Foreground="{StaticResource BrushTextSecondary}" 
                                                           VerticalAlignment="Center" 
                                                           Margin="2,0,0,0"/>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <Button Command="{Binding MesAnteriorCommand}"
                                                        ToolTip="Mês anterior"
                                                        Style="{StaticResource CalendarNavButtonStyle}"
                                                        Margin="0,0,2,0">
                                                    <ui:SymbolIcon Symbol="ArrowUp24" FontSize="13" Foreground="{StaticResource BrushTextPrimary}"/>
                                                </Button>
                                                <Button Command="{Binding MesProximoCommand}"
                                                        ToolTip="Próximo mês"
                                                        Style="{StaticResource CalendarNavButtonStyle}">
                                                    <ui:SymbolIcon Symbol="ArrowDown24" FontSize="13" Foreground="{StaticResource BrushTextPrimary}"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Cabeçalho dos Dias da Semana: D S T Q Q S S -->
                                        <UniformGrid Columns="7" Margin="0,0,0,8">
                                            <TextBlock Text="D" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="S" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="T" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Q" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Q" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="S" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="S" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center"/>
                                        </UniformGrid>

                                        <!-- Grade de Dias do Mês (42 células) -->
                                        <ItemsControl ItemsSource="{Binding DiasCalendario}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="7" Rows="6"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding DataContext.SelecionarDataCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding Data}"
                                                            FocusVisualStyle="{x:Null}"
                                                            Cursor="Hand"
                                                            Margin="0,2"
                                                            OverridesDefaultStyle="True">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="dayBorder"
                                                                        Width="28" Height="28"
                                                                        CornerRadius="4"
                                                                        Background="Transparent"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center">
                                                                    <TextBlock x:Name="dayText"
                                                                               Text="{Binding Dia}"
                                                                               FontSize="12"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"
                                                                               Foreground="{StaticResource BrushTextPrimary}"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMesAtual}" Value="False">
                                                                        <Setter TargetName="dayText" Property="Foreground" Value="#A8A29E"/>
                                                                    </DataTrigger>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                                                                            <Condition Binding="{Binding IsSelecionado}" Value="False"/>
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter TargetName="dayBorder" Property="Background" Value="#F5F2F0"/>
                                                                    </MultiDataTrigger>
                                                                    <DataTrigger Binding="{Binding IsSelecionado}" Value="True">
                                                                        <Setter TargetName="dayBorder" Property="Background" Value="#504746"/>
                                                                        <Setter TargetName="dayText" Property="Foreground" Value="White"/>
                                                                        <Setter TargetName="dayText" Property="FontWeight" Value="SemiBold"/>
                                                                    </DataTrigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Linha de Ações Inferior: Limpar e Hoje -->
                                        <Grid Margin="2,14,2,2">
                                            <Button Command="{Binding LimparDataCommand}"
                                                    Content="Limpar"
                                                    FontSize="12"
                                                    FontWeight="Medium"
                                                    Foreground="{StaticResource BrushInfo}"
                                                    HorizontalAlignment="Left"
                                                    Style="{StaticResource FlatActionButtonStyle}"/>

                                            <Button Command="{Binding HojeDataCommand}"
                                                    Content="Hoje"
                                                    FontSize="12"
                                                    FontWeight="Medium"
                                                    Foreground="{StaticResource BrushInfo}"
                                                    HorizontalAlignment="Right"
                                                    Style="{StaticResource FlatActionButtonStyle}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>

                        <!-- Pílulas Segmentadas de Filtro (Todos / Agendados / Em atendimento) -->
                        <Border Background="#F5EEE9" CornerRadius="8" Padding="3">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="Todos" 
                                             GroupName="FiltroAgendaGroup"
                                             IsChecked="{Binding IsFiltroTodos, Mode=TwoWay}"
                                             Style="{StaticResource SegmentedTabRadioButtonStyle}"/>
                                <RadioButton Content="Pendentes" 
                                             GroupName="FiltroAgendaGroup"
                                             IsChecked="{Binding IsFiltroPendentes, Mode=TwoWay}"
                                             Style="{StaticResource SegmentedTabRadioButtonStyle}"/>
                                <RadioButton Content="Finalizados" 
                                             GroupName="FiltroAgendaGroup"
                                             IsChecked="{Binding IsFiltroFinalizados, Mode=TwoWay}"
                                             Style="{StaticResource SegmentedTabRadioButtonStyle}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Contador à Direita: e.g. "5 agendamentos" -->
                    <TextBlock Grid.Column="1" 
                               Text="{Binding TotalAgendamentosTexto}" 
                               FontSize="12" 
                               Foreground="{StaticResource BrushTextSecondary}" 
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- ===================== 3. LISTA DE CARDS DE AGENDAMENTOS ===================== -->
                <Grid Grid.Row="2">
                    <!-- Estado Vazio amigável se não houver agendamentos -->
                    <Border Background="{StaticResource BrushSurface}"
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="32"
                            Margin="0,10,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AgendamentosFiltrados.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="CalendarClock24" FontSize="36" Foreground="{StaticResource BrushAccent}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock Text="Nenhum agendamento encontrado para esta data ou filtro." 
                                       FontSize="14" 
                                       FontWeight="Medium" 
                                       Foreground="{StaticResource BrushTextSecondary}" 
                                       HorizontalAlignment="Center"/>
                            <Button Command="{Binding AbrirModalNovoAgendamentoCommand}"
                                    Style="{StaticResource PrimaryActionButtonStyle}"
                                    HorizontalAlignment="Center"
                                    Margin="0,16,0,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Add24" FontSize="15" Foreground="White" Margin="0,0,6,0"/>
                                    <TextBlock Text="Novo agendamento" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Lista de Cards de Agendamentos -->
                    <ItemsControl ItemsSource="{Binding AgendamentosFiltrados}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BrushSurface}"
                                        BorderBrush="#EFE8E3"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="20,16"
                                        Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>  <!-- 0: Horário e Duração -->
                                            <ColumnDefinition Width="Auto"/> <!-- 1: Linha Divisória Vertical -->
                                            <ColumnDefinition Width="*"/>    <!-- 2: Cliente e Serviços -->
                                            <ColumnDefinition Width="Auto"/> <!-- 3: Preço, Status, Ações -->
                                        </Grid.ColumnDefinitions>

                                        <!-- Coluna 0: Horário e Duração -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Horario}"
                                                       FontSize="19"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource BrushTextPrimary}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0" VerticalAlignment="Center">
                                                <ui:SymbolIcon Symbol="Clock24" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding DuracaoTexto}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource BrushTextSecondary}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Coluna 1: Linha Divisória Vertical -->
                                        <Rectangle Grid.Column="1"
                                                   Width="1"
                                                   Fill="#EFE8E3"
                                                   Margin="20,2,24,2"
                                                   VerticalAlignment="Stretch"/>

                                        <!-- Coluna 2: Cliente e Serviços -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding NomeCliente}"
                                                           FontSize="15"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource BrushTextPrimary}"/>
                                                <!-- Badge iPhone se sincronizado -->
                                                <Border Visibility="{Binding IsSincronizadoICloud, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                        Background="#F3E5F5"
                                                        CornerRadius="6"
                                                        Padding="6,2"
                                                        Margin="8,0,0,0"
                                                        VerticalAlignment="Center"
                                                        ToolTip="Sincronizado com o Calendário do iPhone (iCloud)">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <ui:SymbolIcon Symbol="Phone24" FontSize="11" Foreground="#7B1FA2" Margin="0,0,3,0"/>
                                                        <TextBlock Text="iPhone" FontSize="10" FontWeight="SemiBold" Foreground="#7B1FA2"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding ServicosTexto}"
                                                       FontSize="13"
                                                       Foreground="{StaticResource BrushTextSecondary}"
                                                       Margin="0,4,0,0"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <!-- Coluna 3: Preço, Status, Botão Abrir Comanda e Excluir -->
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Preço Total -->
                                            <TextBlock Text="{Binding ValorTotalTexto}"
                                                       FontSize="15"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource BrushTextPrimary}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,24,0"/>

                                            <!-- Badge de Status (Agendada / Em atendimento / Concluído) -->
                                            <Border Background="{Binding StatusBg}"
                                                    CornerRadius="12"
                                                    Padding="10,4"
                                                    Margin="0,0,16,0"
                                                    VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="• " Foreground="{Binding StatusFg}" FontSize="12" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding StatusTexto}" Foreground="{Binding StatusFg}" FontSize="11" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Botão 'Abrir comanda →' -->
                                            <Button Content="Abrir comanda →"
                                                    Command="{Binding DataContext.AbrirComandaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Id}"
                                                    Style="{StaticResource OutlineActionButtonStyle}"
                                                    Margin="0,0,10,0"/>

                                            <!-- Botão de Editar Agendamento -->
                                            <Button Command="{Binding DataContext.AbrirModalEditarAgendamentoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Id}"
                                                    ToolTip="Editar agendamento"
                                                    Style="{StaticResource IconButtonEditStyle}"
                                                    Margin="0,0,6,0">
                                                <ui:SymbolIcon Symbol="Edit24" FontSize="16" Foreground="{StaticResource BrushTextSecondary}"/>
                                            </Button>

                                            <!-- Botão de Excluir / Cancelar -->
                                            <Button Command="{Binding DataContext.SolicitarExcluirAgendamentoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Cancelar agendamento"
                                                    Style="{StaticResource IconButtonTrashStyle}">
                                                <ui:SymbolIcon Symbol="Delete24" FontSize="16" Foreground="{StaticResource BrushTextSecondary}"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Grid>
        </ScrollViewer>

        <!-- ========================================================================= -->
        <!-- CAMADA 1: MODAL FLUTUANTE DE NOVO AGENDAMENTO                             -->
        <!-- ========================================================================= -->
        <Grid Visibility="{Binding IsModalNovoAgendamentoAberto, Converter={StaticResource BooleanToVisibilityConverter}}">
            <!-- Fundo Escurecido / Backdrop com Bloqueio de Cliques -->
            <Border Background="#55000000" Cursor="Hand" MouseLeftButtonDown="FecharModalNovoAgendamento_MouseLeftButtonDown"/>

            <!-- Cartão Centrado do Modal -->
            <Border Width="560"
                    MaxHeight="510"
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center"
                    Background="{StaticResource BrushSurface}"
                    CornerRadius="16"
                    Padding="24,16"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1"
                    SnapsToDevicePixels="True">
                <Border.RenderTransform>
                    <TranslateTransform X="{Binding DataContext.IsSidebarOpen, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SidebarToModalOffsetXConverter}}"
                                        Y="0"/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" Direction="270" ShadowDepth="8" Opacity="0.22" Color="#302B2A"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Topo -->
                        <RowDefinition Height="*"/>    <!-- Campos e Serviços -->
                        <RowDefinition Height="Auto"/> <!-- Banner de Erro -->
                        <RowDefinition Height="Auto"/> <!-- Botão de Ação -->
                    </Grid.RowDefinitions>

                    <!-- Topo do Modal: Título e Botão Fechar (✕) -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="{Binding ModalTitulo}" 
                                       FontSize="18" 
                                       FontWeight="Bold" 
                                       Foreground="{StaticResource BrushTextPrimary}"/>
                            <TextBlock Text="{Binding ModalSubtitulo}" 
                                       FontSize="12" 
                                       Foreground="{StaticResource BrushTextSecondary}" 
                                       Margin="0,2,0,0"/>
                        </StackPanel>

                        <Button HorizontalAlignment="Right" 
                                VerticalAlignment="Top" 
                                Command="{Binding FecharModalNovoAgendamentoCommand}" 
                                Background="Transparent" 
                                BorderThickness="0" 
                                Cursor="Hand" 
                                Padding="6">
                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" Foreground="{StaticResource BrushTextSecondary}"/>
                        </Button>
                    </Grid>

                    <!-- Área de Conteúdo com Layout Fixo e Estável (SEM SCROLL EXTERNO) -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0" Margin="0,0,0,6">
                        <StackPanel>
                            <!-- 1. Campo Cliente Pesquisável (Aumentado: Nome, Apelido e Telefone) -->
                            <TextBlock Text="Cliente" 
                                       FontSize="12" 
                                       FontWeight="SemiBold" 
                                       Foreground="{StaticResource BrushTextPrimary}" 
                                       Margin="0,0,0,5"/>

                            <Grid x:Name="ContainerInputCliente" Margin="0,0,0,10">
                                <!-- O INPUT ÚNICO: Campo clicável e digitável aumentado (Height="52") -->
                                <Border x:Name="BorderInputCliente"
                                        Background="White"
                                        BorderBrush="{StaticResource BrushBorder}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Height="52"
                                        Padding="12,4"
                                        Cursor="IBeam"
                                        PreviewMouseLeftButtonDown="BorderInputCliente_PreviewMouseLeftButtonDown">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Ícone do Cliente -->
                                        <Border Grid.Column="0"
                                                Width="32"
                                                Height="32"
                                                CornerRadius="16"
                                                Background="#F4ECE8"
                                                VerticalAlignment="Center"
                                                Margin="0,0,10,0">
                                            <ui:SymbolIcon Symbol="Person24" FontSize="15" Foreground="{StaticResource BrushPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Conteúdo Central: Nome em cima e Telefone embaixo se selecionado, ou digitação de busca -->
                                        <Grid Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBox x:Name="TxtBuscaCliente"
                                                         Text="{Binding BuscaClienteTexto, UpdateSourceTrigger=PropertyChanged}"
                                                         FontSize="13"
                                                         FontWeight="SemiBold"
                                                         Foreground="{StaticResource BrushTextPrimary}"
                                                         Background="Transparent"
                                                         BorderThickness="0"
                                                         Padding="0"
                                                         Margin="0"
                                                         VerticalContentAlignment="Center"
                                                         GotFocus="TxtBuscaCliente_GotFocus"
                                                         PreviewKeyDown="TxtBuscaCliente_PreviewKeyDown"/>

                                                <!-- Linha inferior quando cliente está selecionado: Telefone em tamanho menor -->
                                                <TextBlock Text="{Binding ClienteSelecionado.Telefone, StringFormat='Tel: {0}'}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource BrushTextSecondary}"
                                                           Margin="0,2,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding ClienteSelecionado}" Value="{x:Null}"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                </MultiDataTrigger>
                                                                <DataTrigger Binding="{Binding ClienteSelecionado.Telefone}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ClienteSelecionado.Telefone}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>

                                            <!-- Placeholder quando o campo de busca está vazio -->
                                            <TextBlock Text="Clique para selecionar ou digite para pesquisar..."
                                                       FontSize="12"
                                                       Foreground="{StaticResource BrushTextSecondary}"
                                                       VerticalAlignment="Center"
                                                       Padding="0"
                                                       Margin="0"
                                                       IsHitTestVisible="False">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding BuscaClienteTexto}" Value=""/>
                                                                    <Condition Binding="{Binding IsKeyboardFocused, ElementName=TxtBuscaCliente}" Value="False"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>

                                        <!-- Botão de Seta para Abrir/Fechar a Lista -->
                                        <ToggleButton x:Name="BtnToggleClientePopup"
                                                      Grid.Column="2"
                                                      IsChecked="{Binding IsClientePopupOpen, Mode=TwoWay}"
                                                      Background="Transparent"
                                                      BorderThickness="0"
                                                      Padding="6,0"
                                                      Cursor="Hand"
                                                      Focusable="False">
                                            <ToggleButton.Template>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border Background="Transparent">
                                                        <ui:SymbolIcon Symbol="ChevronDown24" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </ToggleButton.Template>
                                        </ToggleButton>
                                    </Grid>
                                </Border>

                                <!-- POPUP DO DROPDOWN DE CLIENTES -->
                                <Popup x:Name="PopupClientes"
                                       PlacementTarget="{Binding ElementName=BorderInputCliente}"
                                       Placement="Bottom"
                                       IsOpen="{Binding IsClientePopupOpen, Mode=TwoWay}"
                                       StaysOpen="False"
                                       AllowsTransparency="True"
                                       PopupAnimation="Fade"
                                       VerticalOffset="4"
                                       Width="{Binding ActualWidth, ElementName=BorderInputCliente}">
                                    <Border Background="White"
                                            BorderBrush="{StaticResource BrushBorder}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Margin="0,4,0,10"
                                            MaxHeight="260"
                                            SnapsToDevicePixels="True">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="4" Opacity="0.16" Color="#201C1B"/>
                                        </Border.Effect>

                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <StackPanel>
                                                <ItemsControl ItemsSource="{Binding ClientesDisponiveisFiltrados}" HorizontalContentAlignment="Stretch">
                                                    <ItemsControl.ItemContainerStyle>
                                                        <Style TargetType="FrameworkElement">
                                                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                                        </Style>
                                                    </ItemsControl.ItemContainerStyle>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Command="{Binding DataContext.SelecionarClienteOptionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Background="Transparent"
                                                                    BorderThickness="0"
                                                                    HorizontalAlignment="Stretch"
                                                                    HorizontalContentAlignment="Stretch"
                                                                    Height="54"
                                                                    Padding="12,0"
                                                                    Cursor="Hand">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="CliBorder" 
                                                                                Background="#00FAF4F2" 
                                                                                Padding="{TemplateBinding Padding}" 
                                                                                HorizontalAlignment="Stretch"
                                                                                VerticalAlignment="Stretch">
                                                                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="CliBorder" Property="Background" Value="#FAF4F2"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                                <Grid HorizontalAlignment="Stretch">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <Border Grid.Column="0" 
                                                                            Width="32" 
                                                                            Height="32" 
                                                                            CornerRadius="16" 
                                                                            Background="#F4ECE8" 
                                                                            Margin="0,0,10,0" 
                                                                            VerticalAlignment="Center">
                                                                        <ui:SymbolIcon Symbol="Person24" FontSize="15" Foreground="{StaticResource BrushPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>

                                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding NomeExibicao}" 
                                                                                   FontSize="13" 
                                                                                   FontWeight="SemiBold" 
                                                                                   Foreground="{StaticResource BrushTextPrimary}" 
                                                                                   TextTrimming="CharacterEllipsis"/>
                                                                        <TextBlock Text="{Binding Telefone}" 
                                                                                   FontSize="11" 
                                                                                   Foreground="{StaticResource BrushTextSecondary}" 
                                                                                   Margin="0,2,0,0" 
                                                                                   TextTrimming="CharacterEllipsis"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <!-- Mensagem quando não houver resultado na busca -->
                                                <TextBlock Text="Nenhum cliente encontrado."
                                                           FontSize="12"
                                                           Foreground="{StaticResource BrushTextSecondary}"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,14">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ClientesDisponiveisFiltrados.Count}" Value="0">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>

                            <!-- 2. Data e Horário -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="130"/>
                                </Grid.ColumnDefinitions>

                                <!-- Data -->
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Data" 
                                               FontSize="12" 
                                               FontWeight="SemiBold" 
                                               Foreground="{StaticResource BrushTextPrimary}" 
                                               Margin="0,0,0,5"/>
                                    <DatePicker SelectedDate="{Binding NovaData, Mode=TwoWay}"
                                                Height="38"
                                                FontSize="12"
                                                BorderBrush="{StaticResource BrushBorder}"/>
                                </StackPanel>

                                <!-- Horário com Máscara HH:mm -->
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Horário" 
                                               FontSize="12" 
                                               FontWeight="SemiBold" 
                                               Foreground="{StaticResource BrushTextPrimary}" 
                                               Margin="0,0,0,5"/>
                                    <Border BorderBrush="{StaticResource BrushBorder}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Height="38"
                                            Padding="10,0"
                                            Background="White">
                                        <Grid>
                                            <TextBox Text="{Binding NovaHoraTexto, UpdateSourceTrigger=PropertyChanged}"
                                                     helpers:MaskHelper.Mask="Time"
                                                     MaxLength="5"
                                                     BorderThickness="0"
                                                     Background="Transparent"
                                                     FontSize="12"
                                                     FontWeight="Medium"
                                                     Foreground="{StaticResource BrushTextPrimary}"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,20,0"/>
                                            <ui:SymbolIcon Symbol="Clock24" 
                                                           FontSize="14" 
                                                           Foreground="{StaticResource BrushTextSecondary}" 
                                                           HorizontalAlignment="Right" 
                                                           VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- 3. Campo Adicionar Serviço (Sem botão +, clique e selecione para adicionar imediatamente) -->
                            <TextBlock Text="Adicionar serviço" 
                                       FontSize="12" 
                                       FontWeight="SemiBold" 
                                       Foreground="{StaticResource BrushTextPrimary}" 
                                       Margin="0,0,0,5"/>

                            <Grid x:Name="ContainerInputServico" Margin="0,0,0,10">
                                <!-- O INPUT ÚNICO: Campo clicável e digitável com dropdown de opções -->
                                <Border x:Name="BorderInputServico"
                                        Background="White"
                                        BorderBrush="{StaticResource BrushBorder}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Height="42"
                                        Padding="10,6"
                                        Cursor="IBeam"
                                        PreviewMouseLeftButtonDown="BorderInputServico_PreviewMouseLeftButtonDown">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <ui:SymbolIcon Grid.Column="0" 
                                                       Symbol="Search24" 
                                                       FontSize="14" 
                                                       Foreground="{StaticResource BrushTextSecondary}" 
                                                       VerticalAlignment="Center" 
                                                       Margin="0,0,8,0"/>

                                        <TextBox x:Name="TxtBuscaServico"
                                                 Grid.Column="1"
                                                 Text="{Binding BuscaServicoTexto, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="12"
                                                 Foreground="{StaticResource BrushTextPrimary}"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Padding="0"
                                                 Margin="0"
                                                 VerticalContentAlignment="Center"
                                                 GotFocus="TxtBuscaServico_GotFocus"
                                                 PreviewKeyDown="TxtBuscaServico_PreviewKeyDown"/>

                                        <!-- Placeholder quando o campo está vazio -->
                                        <TextBlock Grid.Column="1"
                                                   Text="Clique para selecionar ou digite para pesquisar serviço..."
                                                   FontSize="12"
                                                   Foreground="{StaticResource BrushTextSecondary}"
                                                   VerticalAlignment="Center"
                                                   Padding="0"
                                                   Margin="0"
                                                   IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding BuscaServicoTexto}" Value=""/>
                                                                <Condition Binding="{Binding IsKeyboardFocused, ElementName=TxtBuscaServico}" Value="False"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- Botão de Seta para Abrir/Fechar a Lista de Opções -->
                                        <ToggleButton x:Name="BtnToggleServicoPopup"
                                                      Grid.Column="2"
                                                      IsChecked="{Binding IsServicoPopupOpen, Mode=TwoWay}"
                                                      Background="Transparent"
                                                      BorderThickness="0"
                                                      Padding="4,0"
                                                      Cursor="Hand"
                                                      Focusable="False">
                                            <ToggleButton.Template>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border Background="Transparent">
                                                        <ui:SymbolIcon Symbol="ChevronDown24" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </ToggleButton.Template>
                                        </ToggleButton>
                                    </Grid>
                                </Border>

                                <!-- POPUP DO DROPDOWN DE SERVIÇOS -->
                                <Popup x:Name="PopupServicos"
                                       PlacementTarget="{Binding ElementName=BorderInputServico}"
                                       Placement="Bottom"
                                       IsOpen="{Binding IsServicoPopupOpen, Mode=TwoWay}"
                                       StaysOpen="False"
                                       AllowsTransparency="True"
                                       PopupAnimation="Fade"
                                       VerticalOffset="4"
                                       Width="{Binding ActualWidth, ElementName=BorderInputServico}">
                                    <Border Background="White"
                                            BorderBrush="{StaticResource BrushBorder}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Margin="0,4,0,10"
                                            MaxHeight="260"
                                            SnapsToDevicePixels="True">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="4" Opacity="0.16" Color="#201C1B"/>
                                        </Border.Effect>

                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <StackPanel>
                                                <ItemsControl ItemsSource="{Binding ServicosDisponiveisFiltrados}" HorizontalContentAlignment="Stretch">
                                                    <ItemsControl.ItemContainerStyle>
                                                        <Style TargetType="FrameworkElement">
                                                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                                        </Style>
                                                    </ItemsControl.ItemContainerStyle>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Command="{Binding DataContext.SelecionarServicoOptionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Background="Transparent"
                                                                    BorderThickness="0"
                                                                    HorizontalAlignment="Stretch"
                                                                    HorizontalContentAlignment="Stretch"
                                                                    Height="46"
                                                                    Padding="10,0"
                                                                    Cursor="Hand">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="SvcBorder" 
                                                                                Background="#00FAF4F2" 
                                                                                Padding="{TemplateBinding Padding}" 
                                                                                HorizontalAlignment="Stretch"
                                                                                VerticalAlignment="Stretch">
                                                                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="SvcBorder" Property="Background" Value="#FAF4F2"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                                <Grid HorizontalAlignment="Stretch">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/> <!-- Duração Badge -->
                                                                        <ColumnDefinition Width="*"/>    <!-- Nome do Serviço -->
                                                                        <ColumnDefinition Width="Auto"/> <!-- Valor -->
                                                                    </Grid.ColumnDefinitions>

                                                                    <!-- Badge Duração -->
                                                                    <Border Grid.Column="0" 
                                                                            Width="62" 
                                                                            Height="22" 
                                                                            CornerRadius="4" 
                                                                            Background="#FDE8E4"
                                                                            Margin="0,0,10,0" 
                                                                            VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding DuracaoMinutos, StringFormat='{}{0} min'}" 
                                                                                   FontSize="10" 
                                                                                   FontWeight="SemiBold" 
                                                                                   Foreground="#A84834"
                                                                                   HorizontalAlignment="Center" 
                                                                                   VerticalAlignment="Center"/>
                                                                    </Border>

                                                                    <!-- Nome do Serviço -->
                                                                    <TextBlock Grid.Column="1" 
                                                                               Text="{Binding NomeExibicao}" 
                                                                               FontSize="12" 
                                                                               FontWeight="SemiBold" 
                                                                               Foreground="{StaticResource BrushTextPrimary}" 
                                                                               VerticalAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis"/>

                                                                    <!-- Preço -->
                                                                    <TextBlock Grid.Column="2" 
                                                                               Text="{Binding Valor, StringFormat='{}{0:C2}'}" 
                                                                               FontSize="12" 
                                                                               FontWeight="Bold" 
                                                                               Foreground="{StaticResource BrushTextPrimary}" 
                                                                               VerticalAlignment="Center" 
                                                                               HorizontalAlignment="Right"
                                                                               Margin="10,0,0,0"/>
                                                                </Grid>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <!-- Mensagem quando não houver resultado na busca -->
                                                <TextBlock Text="Nenhum serviço encontrado."
                                                           FontSize="12"
                                                           Foreground="{StaticResource BrushTextSecondary}"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,14">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ServicosDisponiveisFiltrados.Count}" Value="0">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>

                            <!-- Lista de Serviços no Agendamento em Espaço Fixo Reservado (ÚNICA ÁREA COM SCROLL) -->
                            <TextBlock Text="Serviços do agendamento" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,5"/>
                            <Border MinHeight="70"
                                    MaxHeight="120"
                                    Background="#FAF8F7" 
                                    BorderBrush="#EAE3E1" 
                                    BorderThickness="1" 
                                    CornerRadius="8" 
                                    Padding="10,8" 
                                    Margin="0,0,0,10">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" 
                                              HorizontalScrollBarVisibility="Disabled">
                                    <Grid MinHeight="60">
                                        <ItemsControl ItemsSource="{Binding ServicosSelecionadosParaNovo}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="White" 
                                                            BorderBrush="#EDE7E5" 
                                                            BorderThickness="1" 
                                                            CornerRadius="8" 
                                                            Padding="10,8" 
                                                            Margin="0,0,0,6">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>    <!-- Nome do Serviço -->
                                                                <ColumnDefinition Width="Auto"/> <!-- Tempo Estimado Editável -->
                                                                <ColumnDefinition Width="Auto"/> <!-- Preço Editável -->
                                                                <ColumnDefinition Width="Auto"/> <!-- Botão Excluir -->
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Nome do Serviço -->
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding NomeExibicao}" 
                                                                       FontSize="12" 
                                                                       FontWeight="SemiBold" 
                                                                       Foreground="{StaticResource BrushTextPrimary}"
                                                                       VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Margin="0,0,8,0"/>

                                                            <!-- Tempo Estimado Editável (HH:mm) -->
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                                                <ui:SymbolIcon Symbol="Clock24" FontSize="13" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                                <TextBox Style="{StaticResource ModalTextBoxStyle}"
                                                                         helpers:MaskHelper.Mask="Time"
                                                                         Text="{Binding DuracaoTexto, UpdateSourceTrigger=PropertyChanged}"
                                                                         MaxLength="5"
                                                                         Width="56"
                                                                         Height="32"
                                                                         Padding="4,2"
                                                                         FontSize="12"
                                                                         HorizontalContentAlignment="Center"
                                                                         ToolTip="Tempo estimado (HH:mm)"/>
                                                            </StackPanel>

                                                            <!-- Preço Editável (Moeda) -->
                                                            <Grid Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>

                                                                <TextBlock Grid.Column="0" Text="R$" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                                <TextBox Grid.Column="1"
                                                                         Style="{StaticResource ModalTextBoxStyle}"
                                                                         helpers:MaskHelper.Mask="Currency"
                                                                         Text="{Binding ValorTexto, UpdateSourceTrigger=PropertyChanged}"
                                                                         MaxLength="10"
                                                                         Width="76"
                                                                         Height="32"
                                                                         Padding="6,2"
                                                                         FontSize="12"
                                                                         HorizontalContentAlignment="Right"
                                                                         ToolTip="Valor do serviço"/>
                                                            </Grid>

                                                            <!-- Botão Remover Serviço -->
                                                            <Button Grid.Column="3"
                                                                    Command="{Binding DataContext.RemoverServicoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource IconButtonTrashStyle}"
                                                                    ToolTip="Remover serviço"
                                                                    VerticalAlignment="Center">
                                                                <ui:SymbolIcon Symbol="Delete24" FontSize="15" Foreground="{StaticResource BrushTextSecondary}"/>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Mensagem se nenhum serviço foi adicionado (Centralizada no espaço fixo) -->
                                        <TextBlock Text="Nenhum serviço adicionado ao agendamento."
                                                   FontSize="12"
                                                   Foreground="{StaticResource BrushTextSecondary}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ServicosSelecionadosParaNovo.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </ScrollViewer>
                            </Border>

                            <!-- Faixa de Totais (Tempo e Valor Total) -->
                            <Border Background="#FDF8F5" 
                                    CornerRadius="8" 
                                    Padding="14,10" 
                                    Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="Clock24" FontSize="14" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding TempoTotalMinutosTexto}" 
                                                   FontSize="12" 
                                                   Foreground="{StaticResource BrushTextSecondary}" 
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="1" 
                                               Text="{Binding ValorTotalServicosTexto}" 
                                               FontSize="13" 
                                               FontWeight="Bold" 
                                               Foreground="{StaticResource BrushTextPrimary}" 
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- 4. Campo Observação -->
                            <TextBlock Text="Observação" 
                                       FontSize="12" 
                                       FontWeight="SemiBold" 
                                       Foreground="{StaticResource BrushTextPrimary}" 
                                       Margin="0,0,0,4"/>
                            <TextBox Text="{Binding NovaObservacao, UpdateSourceTrigger=PropertyChanged}"
                                     Height="48"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     Style="{StaticResource ModalTextBoxStyle}"
                                     Padding="8,6"
                                     Margin="0,0,0,6"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Banner de Erro em Tempo Real (Validação Defensiva) -->
                    <Border Grid.Row="2"
                            Background="#FEECE9" 
                            BorderBrush="#F8C8BF" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Padding="12,8" 
                            Margin="0,4,0,10"
                            Visibility="{Binding TemMensagemErroModal, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="Warning24" FontSize="16" Foreground="#D32F2F" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding MensagemErroModal}" FontSize="12" Foreground="#D32F2F" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Botão Salvar / Atualizar Agendamento -->
                    <Button Grid.Row="3"
                            Content="{Binding BotaoSalvarTexto}"
                            Command="{Binding SalvarNovoAgendamentoCommand}"
                            Style="{StaticResource PrimaryActionButtonStyle}"
                            HorizontalAlignment="Right"
                            Padding="22,9"
                            FontSize="13"
                            FontWeight="SemiBold"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ========================================================================= -->
        <!-- CAMADA 2: MODAL FLUTUANTE DE EXCLUSÃO DE AGENDAMENTO                      -->
        <!-- ========================================================================= -->
        <Grid Visibility="{Binding IsModalExcluirAberto, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="#55000000" Cursor="Hand" MouseLeftButtonDown="FecharModalExcluir_MouseLeftButtonDown"/>
            <Border Background="White" 
                    CornerRadius="14" 
                    Width="440" 
                    Padding="26,24" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center">
                <Border.RenderTransform>
                    <TranslateTransform X="{Binding DataContext.IsSidebarOpen, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SidebarToModalOffsetXConverter}}"
                                        Y="-26"/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" Direction="270" ShadowDepth="6" Opacity="0.18" Color="#201C1B"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header -->
                        <RowDefinition Height="Auto"/> <!-- Descrição -->
                        <RowDefinition Height="Auto"/> <!-- Botões de Ação -->
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Cancelar agendamento?" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                        <Button HorizontalAlignment="Right" 
                                VerticalAlignment="Top" 
                                Command="{Binding FecharModalExcluirCommand}" 
                                Background="Transparent" 
                                BorderThickness="0" 
                                Cursor="Hand" 
                                Padding="6">
                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" Foreground="{StaticResource BrushTextSecondary}"/>
                        </Button>
                    </Grid>

                    <!-- Mensagem Informativa de Exclusão -->
                    <TextBlock Grid.Row="1" 
                               Text="{Binding AgendamentoParaExcluir.NomeCliente, StringFormat='Tem certeza que deseja cancelar o agendamento de {0}? A comanda vinculada a ele também será excluída.'}" 
                               FontSize="13" 
                               Foreground="{StaticResource BrushTextSecondary}" 
                               TextWrapping="Wrap" 
                               LineHeight="18"
                               Margin="0,0,0,20"/>

                    <!-- Botões: Voltar e Confirmar Cancelamento -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="Voltar"
                                Command="{Binding FecharModalExcluirCommand}"
                                Style="{StaticResource OutlineActionButtonStyle}"
                                Margin="0,0,10,0"/>

                        <Button Grid.Column="1"
                                Content="Confirmar cancelamento"
                                Command="{Binding ConfirmarExclusaoCommand}"
                                Style="{StaticResource DangerActionButtonStyle}"
                                Padding="20,10"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ========================================================================= -->
        <!-- CAMADA 4: MODAL FLUTUANTE DO CALENDÁRIO IPHONE / ICLOUD                    -->
        <!-- ========================================================================= -->
        <Grid Visibility="{Binding IsModalICloudAberto, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="#55000000" Cursor="Hand" MouseLeftButtonDown="FecharModalICloud_MouseLeftButtonDown"/>
            <Border Background="White" 
                    CornerRadius="16" 
                    Width="620" 
                    MaxHeight="520"
                    Padding="24,18"
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center">
                <Border.RenderTransform>
                    <TranslateTransform X="{Binding DataContext.IsSidebarOpen, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SidebarToModalOffsetXConverter}}"
                                        Y="0"/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" Direction="270" ShadowDepth="8" Opacity="0.22" Color="#201C1B"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- 0: Header -->
                        <RowDefinition Height="*"/>    <!-- 1: Conteúdo rolável -->
                        <RowDefinition Height="Auto"/> <!-- 2: Feedback / Mensagem -->
                        <RowDefinition Height="Auto"/> <!-- 3: Ações do Rodapé -->
                    </Grid.RowDefinitions>

                    <!-- 0: Header do Modal -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Phone24" FontSize="22" Foreground="#7B1FA2" Margin="0,0,10,0"/>
                                <TextBlock Text="Calendário do iPhone (iCloud)" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                            </StackPanel>
                            <TextBlock Text="Sincronização offline-first via CalDAV com recuperação e resolução de conflitos" 
                                       FontSize="12" 
                                       Foreground="{StaticResource BrushTextSecondary}" 
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="1" 
                                Command="{Binding FecharModalICloudCommand}" 
                                Style="{StaticResource ModalCloseButtonStyle}">
                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" Foreground="{StaticResource BrushTextSecondary}"/>
                        </Button>
                    </Grid>

                    <!-- 1: Conteúdo Principal Rolável -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,6,0">

                            <!-- Status Geral da Sincronização -->
                            <Border Background="#FAF7FB"
                                    BorderBrush="#E1BEE7"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="16,12"
                                    Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Ellipse Width="12" Height="12" Fill="{Binding ICloudStatusCor}" Margin="0,0,12,0" VerticalAlignment="Center"/>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ICloudStatusTexto}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                                        <TextBlock Text="{Binding ICloudUltimaSincronizacaoTexto}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Badges informativas -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Visibility="{Binding IsICloudConectado, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                Background="#E8F5E9" CornerRadius="6" Padding="8,4" Margin="4,0,0,0">
                                            <TextBlock Text="CalDAV Ativo" FontSize="11" FontWeight="SemiBold" Foreground="#2E7D32"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- SEÇÃO 1: CONTA APPLE E CREDENCIAIS (SENHA DE APP) -->
                            <Border Background="#FBF9F8"
                                    BorderBrush="#E8E2E0"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="16,14"
                                    Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Conta Apple (iCloud CalDAV)" FontSize="13" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,8"/>

                                    <!-- Estado Conectado -->
                                    <Grid Visibility="{Binding IsICloudConectado, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="16" Foreground="#2E7D32" Margin="0,0,6,0"/>
                                                <TextBlock Text="Apple ID Conectado:" FontSize="12" FontWeight="SemiBold" Foreground="#1B5E20"/>
                                                <TextBlock Text="{Binding ICloudEmailInput}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="6,0,0,0"/>
                                            </StackPanel>
                                            <TextBlock Text="Sincronização contínua em segundo plano com detecção automática de conexão." 
                                                       FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="22,4,0,0"/>
                                        </StackPanel>

                                        <Button Grid.Column="1"
                                                Command="{Binding DesconectarICloudCommand}"
                                                Style="{StaticResource OutlineActionButtonStyle}"
                                                Padding="12,6"
                                                FontSize="11"
                                                Foreground="#D32F2F"
                                                BorderBrush="#FFCDD2"
                                                VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <ui:SymbolIcon Symbol="LinkDismiss24" FontSize="13" Foreground="#D32F2F" Margin="0,0,4,0"/>
                                                <TextBlock Text="Desconectar" FontSize="11" FontWeight="Medium" Foreground="#D32F2F"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <!-- Estado Desconectado / Configuração -->
                                    <StackPanel Visibility="{Binding IsICloudConectado, Converter={StaticResource InverseBooleanConverter}}">
                                        <TextBlock Text="Conecte seu Apple ID com uma Senha de App específica para sincronizar eventos diretamente com o app Calendário do iPhone."
                                                   FontSize="11" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                                        <TextBlock Text="Apple ID (e-mail da conta Apple):" FontSize="11" FontWeight="Medium" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding ICloudEmailInput, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource ModalTextBoxStyle}"
                                                 FontSize="12"
                                                 Margin="0,0,0,8"/>

                                        <TextBlock Text="Senha de App gerada na Apple (ex: abcd-efgh-ijkl-mnop):" FontSize="11" FontWeight="Medium" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding ICloudSenhaAppInput, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource ModalTextBoxStyle}"
                                                 FontSize="12"
                                                 Margin="0,0,0,8"/>

                                        <Border Background="#F3E5F5" CornerRadius="6" Padding="10,6" Margin="0,0,0,10">
                                            <TextBlock Text="💡 Para gerar a senha: acesse appleid.apple.com > Senhas específicas de apps > Gerar senha." 
                                                       FontSize="11" Foreground="#4A148C" TextWrapping="Wrap"/>
                                        </Border>

                                        <Button Command="{Binding SalvarCredenciaisICloudCommand}"
                                                Style="{StaticResource PrimaryActionButtonStyle}"
                                                HorizontalAlignment="Right"
                                                Padding="16,8">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <ui:SymbolIcon Symbol="Checkmark24" FontSize="14" Foreground="White" Margin="0,0,6,0"/>
                                                <TextBlock Text="Salvar e Conectar ao iPhone" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- SEÇÃO 2: FILA DE OPERAÇÕES OFFLINE (SQLITE) -->
                            <Border Background="#FBF9F8"
                                    BorderBrush="#E8E2E0"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="16,14"
                                    Margin="0,0,0,14">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Fila Offline Local (SQLite)" FontSize="13" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" Background="#FFF3E0" CornerRadius="6" Padding="8,2">
                                            <TextBlock Text="{Binding ICloudOperacoesPendentesCount, StringFormat='{}{0} pendência(s)'}" FontSize="11" FontWeight="Bold" Foreground="#ED6C02"/>
                                        </Border>
                                    </Grid>

                                    <TextBlock Text="Operações criadas, editadas ou excluídas sem internet ficam salvas no SQLite com consolidação segura e são enviadas ao restaurar a conexão."
                                               FontSize="11" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                                    <!-- Lista de Operações Pendentes -->
                                    <ItemsControl ItemsSource="{Binding ListaOperacoesPendentes}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#F5F3F1" CornerRadius="6" Padding="10,6" Margin="0,0,0,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Background="#ECE6E2" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding TipoOperacao}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                                                        </Border>
                                                        <TextBlock Grid.Column="1" Text="{Binding AgendamentoId, StringFormat='Agendamento #{0}'}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding DataCriacao, StringFormat='{}{0:dd/MM HH:mm:ss}'}" FontSize="10" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="✓ Nenhuma operação pendente. O banco local está 100% alinhado com a nuvem." 
                                               FontSize="11" Foreground="#2E7D32" FontWeight="Medium" Margin="0,4,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ICloudOperacoesPendentesCount}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- SEÇÃO 3: RESOLUÇÃO DE CONFLITOS (3-WAY DIFF) -->
                            <Border Background="#FFFDE7"
                                    BorderBrush="#FFF59D"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="16,14"
                                    Margin="0,0,0,14">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ICloudEstado}" Value="Conflito">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <ui:SymbolIcon Symbol="Warning24" FontSize="16" Foreground="#F57F17" Margin="0,0,8,0"/>
                                        <TextBlock Text="Conflitos Detectados (Modificações Simultâneas)" FontSize="13" FontWeight="Bold" Foreground="#E65100"/>
                                    </StackPanel>
                                    <TextBlock Text="Os eventos abaixo foram modificados tanto no salão quanto no iPhone durante o período offline. Escolha qual versão deseja manter:"
                                               FontSize="11" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                                    <ItemsControl ItemsSource="{Binding ListaConflitos}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="White" BorderBrush="#FFE082" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Titulo}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,2"/>
                                                        <TextBlock Text="{Binding Descricao}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                            <Button Content="Manter Versão do Salão"
                                                                    Command="{Binding DataContext.ResolverConflitoManterLocalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding Id}"
                                                                    Style="{StaticResource OutlineActionButtonStyle}"
                                                                    FontSize="11"
                                                                    Padding="10,5"
                                                                    Margin="0,0,8,0"/>
                                                            <Button Content="Manter Versão do iPhone"
                                                                    Command="{Binding DataContext.ResolverConflitoManterRemotoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding Id}"
                                                                    Style="{StaticResource PrimaryActionButtonStyle}"
                                                                    FontSize="11"
                                                                    Padding="10,5"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- SEÇÃO 4: BATERIA DE 11 TESTES AUTOMATIZADOS DE ACEITAÇÃO -->
                            <Border Background="#FAF8F6"
                                    BorderBrush="#EDE7E3"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="16,14"
                                    Margin="0,0,0,8">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Validação Automatizada de Aceitação" FontSize="13" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                                            <TextBlock Text="11 critérios: offline-first, reconexão, consolidação, 3-way diff e idempotência" 
                                                       FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <Button Grid.Column="1"
                                                Command="{Binding ExecutarTestesAutomatizadosCommand}"
                                                IsEnabled="{Binding IsExecutandoTestes, Converter={StaticResource InverseBooleanConverter}}"
                                                Style="{StaticResource OutlineActionButtonStyle}"
                                                Padding="12,6"
                                                VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <ui:SymbolIcon Symbol="Play24" FontSize="13" Foreground="{StaticResource BrushAccent}" Margin="0,0,6,0"/>
                                                <TextBlock Text="Executar 11 Testes" FontSize="11" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <!-- Log de Execução dos Testes -->
                                    <TextBox Text="{Binding ResultadosTestesTexto, Mode=OneWay}"
                                             IsReadOnly="True"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             FontFamily="Consolas, Cascadia Code, Courier New"
                                             FontSize="10"
                                             Height="95"
                                             Background="#211E1D"
                                             Foreground="#E0DDD9"
                                             BorderThickness="0"
                                             Padding="8"
                                             Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- 2: Mensagem de Feedback -->
                    <Border Grid.Row="2"
                            CornerRadius="8"
                            Padding="12,10"
                            Margin="0,10,0,14"
                            Visibility="{Binding TemFeedbackICloud, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#FEECE9"/>
                                <Setter Property="BorderBrush" Value="#F8C8C0"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ICloudFeedbackSucesso}" Value="True">
                                        <Setter Property="Background" Value="#E8F5E9"/>
                                        <Setter Property="BorderBrush" Value="#C8E6C9"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="Info24" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center">
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Setter Property="Foreground" Value="#D32F2F"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ICloudFeedbackSucesso}" Value="True">
                                                <Setter Property="Foreground" Value="#2E7D32"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                            <TextBlock Grid.Column="1" 
                                       Text="{Binding ICloudFeedbackMensagem}" 
                                       FontSize="12" 
                                       TextWrapping="Wrap" 
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#C62828"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ICloudFeedbackSucesso}" Value="True">
                                                <Setter Property="Foreground" Value="#1B5E20"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- 3: Ações do Rodapé -->
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="Fechar"
                                Command="{Binding FecharModalICloudCommand}"
                                Style="{StaticResource OutlineActionButtonStyle}"
                                HorizontalAlignment="Left"
                                Padding="16,8"/>

                        <Button Grid.Column="1"
                                Command="{Binding SincronizarICloudAgoraCommand}"
                                IsEnabled="{Binding IsSincronizandoICloud, Converter={StaticResource InverseBooleanConverter}}"
                                Style="{StaticResource PrimaryActionButtonStyle}"
                                Padding="20,9">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="ArrowSync24" FontSize="15" Foreground="White" Margin="0,0,8,0"/>
                                <TextBlock Text="Sincronizar agora" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
