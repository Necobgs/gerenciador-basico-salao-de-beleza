<UserControl x:Class="GerenciadorSalao.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:GerenciadorSalao.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="1200" d:DesignWidth="1100">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Estilo ComboBox em Pílula (Ano completo ▾ / 2026 ▾) -->
        <ControlTemplate x:Key="ComboBoxToggleButtonTemplate" TargetType="ToggleButton">
            <Border x:Name="Border"
                    Background="{StaticResource BrushSurface}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ContentPresenter Grid.Column="0"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Left"
                                      Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="1"
                               Text="▾"
                               FontSize="10"
                               Foreground="{StaticResource BrushTextSecondary}"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                    <Setter TargetName="Border" Property="Background" Value="#FAF8F7"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource BrushPrimary}"/>
                    <Setter TargetName="Border" Property="Background" Value="#FAF8F7"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="PillComboBoxStyle" TargetType="ComboBox">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Template="{StaticResource ComboBoxToggleButtonTemplate}">
                                <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                  VerticalAlignment="Center"/>
                            </ToggleButton>

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade"
                                   VerticalOffset="4">
                                <Border x:Name="DropDownBorder"
                                        Background="{StaticResource BrushSurface}"
                                        BorderBrush="{StaticResource BrushBorder}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="200"
                                        Padding="4"
                                        SnapsToDevicePixels="True">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="10" Direction="270" ShadowDepth="3" Opacity="0.12" Color="#34302F"/>
                                    </Border.Effect>
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Padding" Value="10,6"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBorder"
                                            Background="Transparent"
                                            CornerRadius="6"
                                            Padding="{TemplateBinding Padding}"
                                            Margin="0,1">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource BrushSurfaceSubtle}"/>
                                            <Setter Property="Foreground" Value="{StaticResource BrushPrimary}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource BrushSurfaceSubtle}"/>
                                            <Setter Property="Foreground" Value="{StaticResource BrushPrimary}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão sutil circular / ícone -->
        <Style x:Key="HeaderNavIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BrushSurfaceSubtle}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="28,20,28,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 1. Header da Página -->
                <RowDefinition Height="Auto"/> <!-- 2. Quatro Cards de Métricas -->
                <RowDefinition Height="Auto"/> <!-- 3. Faturamento (Gráfico Dinâmico) + Clientes Especiais (Top 5) -->
                <RowDefinition Height="Auto"/> <!-- 4. Agenda do Dia (Tabela) -->
            </Grid.RowDefinitions>

            <!-- ===================== 1. HEADER DA PÁGINA ===================== -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="SEU SALÃO, EM HARMONIA" 
                               FontSize="11" 
                               FontWeight="Bold" 
                               Foreground="{StaticResource BrushSecondary}" 
                               Margin="0,0,0,4"/>
                    <TextBlock Text="Visão geral" 
                               FontSize="26" 
                               FontWeight="Bold" 
                               Foreground="{StaticResource BrushTextPrimary}"/>
                    <TextBlock Text="Tudo pronto para mais um dia de beleza e cuidado." 
                               FontSize="13" 
                               Foreground="{StaticResource BrushTextSecondary}" 
                               Margin="0,3,0,0"/>
                </StackPanel>

                <!-- Ações do Topo: Navegação de Datas, Recarregar e Novo Agendamento -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Seletor de Data com Navegação Anterior/Próximo -->
                    <Border Background="{StaticResource BrushSurface}"
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="6,4"
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Dia Anterior -->
                            <Button Style="{StaticResource HeaderNavIconButtonStyle}"
                                    Command="{Binding IrParaDiaAnteriorCommand}"
                                    ToolTip="Dia anterior">
                                <ui:SymbolIcon Symbol="ChevronLeft24" FontSize="14" Foreground="{StaticResource BrushTextSecondary}"/>
                            </Button>

                            <!-- Data Exibida -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,6,0">
                                <ui:SymbolIcon Symbol="CalendarLtr24" FontSize="14" Foreground="{StaticResource BrushPrimary}" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding DataHojeFormatada}" 
                                           FontSize="12" 
                                           FontWeight="SemiBold" 
                                           Foreground="{StaticResource BrushTextPrimary}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Próximo Dia -->
                            <Button Style="{StaticResource HeaderNavIconButtonStyle}"
                                    Command="{Binding IrParaProximoDiaCommand}"
                                    ToolTip="Próximo dia">
                                <ui:SymbolIcon Symbol="ChevronRight24" FontSize="14" Foreground="{StaticResource BrushTextSecondary}"/>
                            </Button>

                            <!-- Botão Hoje se não estiver na data atual -->
                            <Button Style="{StaticResource HeaderNavIconButtonStyle}"
                                    Command="{Binding IrParaHojeCommand}"
                                    ToolTip="Voltar para a data de hoje"
                                    Margin="4,0,2,0">
                                <Border Background="{StaticResource BrushSurfaceSubtle}" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="Hoje" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushPrimary}"/>
                                </Border>
                            </Button>

                            <!-- Separador -->
                            <Rectangle Width="1" Height="18" Fill="{StaticResource BrushBorder}" Margin="6,0,6,0"/>

                            <!-- Botão de Atualização Manual dos Dados -->
                            <Button Style="{StaticResource HeaderNavIconButtonStyle}"
                                    Command="{Binding CarregarDadosCommand}"
                                    ToolTip="Atualizar dados agora">
                                <ui:SymbolIcon Symbol="ArrowSync24" FontSize="14" Foreground="{StaticResource BrushTextSecondary}"/>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Botão Novo Agendamento -->
                    <Button Command="{Binding NovoAgendamentoCommand}"
                            Background="{StaticResource BrushPrimary}"
                            Foreground="White"
                            BorderThickness="0"
                            Padding="14,9"
                            Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Add24" FontSize="15" Foreground="White" Margin="0,0,6,0"/>
                            <TextBlock Text="Novo agendamento" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ===================== 2. QUATRO CARDS DE MÉTRICAS ===================== -->
            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Card 1: Faturamento do dia -->
                <Border Grid.Column="0" 
                        Background="{StaticResource BrushSurface}" 
                        BorderBrush="{StaticResource BrushBorder}" 
                        BorderThickness="1" 
                        CornerRadius="10" 
                        Padding="16,16" 
                        Margin="0,0,6,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <TextBlock Text="{Binding TituloFaturamentoDia}" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                            <Border Width="34" Height="34" CornerRadius="8" Background="{StaticResource BrushSurfaceSubtle}" HorizontalAlignment="Right">
                                <ui:SymbolIcon Symbol="Wallet24" FontSize="17" Foreground="{StaticResource BrushPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <TextBlock Grid.Row="1" 
                                   Text="{Binding FaturamentoHoje, StringFormat='{}{0:C2}'}" 
                                   FontSize="22" 
                                   FontWeight="Bold" 
                                   Foreground="{StaticResource BrushTextPrimary}" 
                                   Margin="0,10,0,4"/>

                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                            <TextBlock Text="• " FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                            <TextBlock Text="{Binding ComandasFinalizadasHoje}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                            <TextBlock Text=" comandas finalizadas" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Card 2: Comandas abertas -->
                <Border Grid.Column="1" 
                        Background="{StaticResource BrushSurface}" 
                        BorderBrush="{StaticResource BrushBorder}" 
                        BorderThickness="1" 
                        CornerRadius="10" 
                        Padding="16,16" 
                        Margin="4,0,4,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <TextBlock Text="Comandas abertas" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                            <Border Width="34" Height="34" CornerRadius="8" Background="{StaticResource BrushSurfaceSubtle}" HorizontalAlignment="Right">
                                <ui:SymbolIcon Symbol="ClipboardTextEdit24" FontSize="17" Foreground="{StaticResource BrushSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <TextBlock Grid.Row="1" 
                                   Text="{Binding ComandasAbertas, StringFormat='{}{0:D2}'}" 
                                   FontSize="22" 
                                   FontWeight="Bold" 
                                   Foreground="{StaticResource BrushTextPrimary}" 
                                   Margin="0,10,0,4"/>

                        <TextBlock Grid.Row="2" Text="• Atendimentos em andamento" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                    </Grid>
                </Border>

                <!-- Card 3: Agendamentos hoje -->
                <Border Grid.Column="2" 
                        Background="{StaticResource BrushSurface}" 
                        BorderBrush="{StaticResource BrushBorder}" 
                        BorderThickness="1" 
                        CornerRadius="10" 
                        Padding="16,16" 
                        Margin="4,0,4,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <TextBlock Text="{Binding TituloAgendamentosDia}" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                            <Border Width="34" Height="34" CornerRadius="8" Background="#E8F5E9" HorizontalAlignment="Right">
                                <ui:SymbolIcon Symbol="CalendarLtr24" FontSize="17" Foreground="#2E7D32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <TextBlock Grid.Row="1" 
                                   Text="{Binding AgendamentosHoje, StringFormat='{}{0:D2}'}" 
                                   FontSize="22" 
                                   FontWeight="Bold" 
                                   Foreground="{StaticResource BrushTextPrimary}" 
                                   Margin="0,10,0,4"/>

                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                            <TextBlock Text="• " FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                            <TextBlock Text="{Binding AgendamentosPendentesHoje}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                            <TextBlock Text=" aguardando atendimento" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Card 4: Clientes cadastrados -->
                <Border Grid.Column="3" 
                        Background="{StaticResource BrushSurface}" 
                        BorderBrush="{StaticResource BrushBorder}" 
                        BorderThickness="1" 
                        CornerRadius="10" 
                        Padding="16,16" 
                        Margin="6,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <TextBlock Text="Clientes cadastrados" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                            <Border Width="34" Height="34" CornerRadius="8" Background="#E3F2FD" HorizontalAlignment="Right">
                                <ui:SymbolIcon Symbol="People24" FontSize="17" Foreground="#1565C0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <TextBlock Grid.Row="1" 
                                   Text="{Binding TotalClientes, StringFormat='{}{0:D2}'}" 
                                   FontSize="22" 
                                   FontWeight="Bold" 
                                   Foreground="{StaticResource BrushTextPrimary}" 
                                   Margin="0,10,0,4"/>

                        <TextBlock Grid.Row="2" Text="• Conexões que fazem a diferença" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===================== 3. FATURAMENTO (GRÁFICO DINÂMICO) + CLIENTES ESPECIAIS (TOP 5) ===================== -->
            <Grid Grid.Row="2" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- CARD ESQUERDA: FATURAMENTO REAL COM GRÁFICO DINÂMICO -->
                <Border Grid.Column="0" 
                        Background="{StaticResource BrushSurface}" 
                        BorderBrush="{StaticResource BrushBorder}" 
                        BorderThickness="1" 
                        CornerRadius="12" 
                        Padding="22,18" 
                        Margin="0,0,8,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Título & Filtros -->
                            <RowDefinition Height="Auto"/> <!-- Valor Acumulado & Legenda -->
                            <RowDefinition Height="Auto"/> <!-- Gráfico Visual Dinâmico -->
                            <RowDefinition Height="Auto"/> <!-- Labels dos Meses (Eixo X) -->
                            <RowDefinition Height="Auto"/> <!-- Rodapé -->
                        </Grid.RowDefinitions>

                        <!-- Cabeçalho do Card Faturamento -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Faturamento" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                                <TextBlock Text="Uma visão dos resultados do seu salão" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- Filtros (Ano completo / Semestre e Ano) -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <ComboBox Style="{StaticResource PillComboBoxStyle}"
                                          ItemsSource="{Binding PeriodosDisponiveis}"
                                          SelectedItem="{Binding PeriodoSelecionado}"
                                          Margin="0,0,6,0"/>
                                <ComboBox Style="{StaticResource PillComboBoxStyle}"
                                          ItemsSource="{Binding AnosDisponiveis}"
                                          SelectedItem="{Binding AnoSelecionado}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Valor Acumulado e Tag Dinâmica -->
                        <Grid Grid.Row="1" Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding FaturamentoAcumuladoAno, StringFormat='{}{0:C2}'}" 
                                           FontSize="24" 
                                           FontWeight="Bold" 
                                           Foreground="{StaticResource BrushTextPrimary}" 
                                           Margin="0,0,10,0"/>
                                <Border Background="{StaticResource BrushSurfaceSubtle}" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding PeriodoTagDescricao}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushPrimary}"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource BrushPrimary}" Margin="0,0,6,0"/>
                                <TextBlock Text="Faturamento" FontSize="11" FontWeight="Medium" Foreground="{StaticResource BrushTextSecondary}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Gráfico Dinâmico Baseado no RelatorioService -->
                        <Grid Grid.Row="2" Height="150" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="58"/> <!-- Eixo Y Labels Dinâmicos -->
                                <ColumnDefinition Width="*"/>   <!-- Área do Gráfico Dinâmico -->
                            </Grid.ColumnDefinitions>

                            <!-- Labels Dinâmicos do Eixo Y -->
                            <Grid Grid.Column="0">
                                <TextBlock Text="{Binding YLabelMax}" FontSize="10" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Top" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding YLabel75}" FontSize="10" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Top" Margin="0,32,0,0"/>
                                <TextBlock Text="{Binding YLabel50}" FontSize="10" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Top" Margin="0,60,0,0"/>
                                <TextBlock Text="{Binding YLabel25}" FontSize="10" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Top" Margin="0,88,0,0"/>
                                <TextBlock Text="{Binding YLabel0}" FontSize="10" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Bottom" Margin="0,0,0,12"/>
                            </Grid>

                            <!-- Área do Gráfico em Viewbox Escalável -->
                            <Grid Grid.Column="1">
                                <Viewbox Stretch="Fill" Height="140" SnapsToDevicePixels="True">
                                    <Grid Width="500" Height="140">
                                        <!-- Linhas de Guia Horizontais Tracejadas -->
                                        <Canvas>
                                            <Line X1="0" Y1="10" X2="500" Y2="10" Stroke="{StaticResource BrushBorder}" StrokeDashArray="3 3"/>
                                            <Line X1="0" Y1="38.75" X2="500" Y2="38.75" Stroke="{StaticResource BrushBorder}" StrokeDashArray="3 3"/>
                                            <Line X1="0" Y1="67.5" X2="500" Y2="67.5" Stroke="{StaticResource BrushBorder}" StrokeDashArray="3 3"/>
                                            <Line X1="0" Y1="96.25" X2="500" Y2="96.25" Stroke="{StaticResource BrushBorder}" StrokeDashArray="3 3"/>
                                            <Line X1="0" Y1="125" X2="500" Y2="125" Stroke="{StaticResource BrushBorder}"/>
                                        </Canvas>

                                        <!-- Preenchimento Suave sob a Curva Dinâmica -->
                                        <Path Stretch="None" Data="{Binding GraficoAreaGeometry}" Opacity="0.18">
                                            <Path.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#64423C" Offset="0.0"/>
                                                    <GradientStop Color="#FEE9E6" Offset="1.0"/>
                                                </LinearGradientBrush>
                                            </Path.Fill>
                                        </Path>

                                        <!-- Curva Dinâmica em Degrau Suave Rosé Marsala -->
                                        <Path Stretch="None" 
                                              Data="{Binding GraficoLinhaGeometry}" 
                                              Stroke="{StaticResource BrushPrimary}" 
                                              StrokeThickness="3" 
                                              StrokeStartLineCap="Round" 
                                              StrokeEndLineCap="Round" 
                                              StrokeLineJoin="Round"/>

                                        <!-- Pontos Interativos e Colunas de Hover com Tooltip -->
                                        <ItemsControl ItemsSource="{Binding ChartMeses}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas IsItemsHost="True"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                                    <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="-16,-60,0,0" Width="32" Height="130" Background="Transparent" Cursor="Hand" ToolTipService.InitialShowDelay="50">
                                                        <ToolTipService.ToolTip>
                                                            <Border Background="{StaticResource BrushTextPrimary}" CornerRadius="6" Padding="8,4">
                                                                <TextBlock Text="{Binding TooltipTexto}" Foreground="White" FontSize="11" FontWeight="Medium"/>
                                                            </Border>
                                                        </ToolTipService.ToolTip>
                                                        <Ellipse Width="7" Height="7" 
                                                                 Fill="{StaticResource BrushPrimary}" 
                                                                 Stroke="White" 
                                                                 StrokeThickness="1.5" 
                                                                 HorizontalAlignment="Center" 
                                                                 VerticalAlignment="Top" 
                                                                 Margin="0,56.5,0,0"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Aviso quando o período selecionado não possui dados no banco -->
                                        <Border Background="#F9F7F6" 
                                                BorderBrush="{StaticResource BrushBorder}" 
                                                BorderThickness="1" 
                                                CornerRadius="8" 
                                                Padding="14,8" 
                                                HorizontalAlignment="Center" 
                                                VerticalAlignment="Center" 
                                                Visibility="{Binding SemDadosNoGrafico, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <ui:SymbolIcon Symbol="Info24" FontSize="14" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,6,0"/>
                                                <TextBlock Text="Nenhum faturamento registrado para o período." FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Viewbox>
                            </Grid>
                        </Grid>

                        <!-- Labels dos Meses (Eixo X) Dinâmicos -->
                        <ItemsControl Grid.Row="3" ItemsSource="{Binding ChartMeses}" Margin="58,0,0,8">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="{Binding ColunasGrafico}"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding MesNome}" FontSize="10" Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Rodapé do Card Faturamento -->
                        <Grid Grid.Row="4" Margin="0,10,0,0">
                            <Border Height="1" Background="{StaticResource BrushBorder}" VerticalAlignment="Top" Margin="0,0,0,10"/>
                            <TextBlock Text="Considera apenas comandas pagas" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Bottom"/>
                            <Button HorizontalAlignment="Right" 
                                    Command="{Binding IrParaRelatoriosCommand}" 
                                    Background="Transparent" 
                                    BorderThickness="0" 
                                    Padding="0" 
                                    Cursor="Hand"
                                    VerticalAlignment="Bottom">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Ver relatório completo" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushPrimary}"/>
                                    <ui:SymbolIcon Symbol="ArrowUpRight24" FontSize="11" Foreground="{StaticResource BrushPrimary}" Margin="4,2,0,0"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <!-- CARD DIREITA: CLIENTES ESPECIAIS (TOP 5) -->
                <Border Grid.Column="1" 
                        Background="{StaticResource BrushSurface}" 
                        BorderBrush="{StaticResource BrushBorder}" 
                        BorderThickness="1" 
                        CornerRadius="12" 
                        Padding="20,18" 
                        Margin="6,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Header -->
                            <RowDefinition Height="*"/>    <!-- Lista Top 5 ou Empty State -->
                            <RowDefinition Height="Auto"/> <!-- Rodapé -->
                        </Grid.RowDefinitions>

                        <!-- Cabeçalho Clientes Especiais -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Clientes especiais ✦" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                                </StackPanel>
                                <TextBlock Text="Quem mais esteve com você" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <Border Background="{StaticResource BrushSurfaceSubtle}" 
                                    CornerRadius="4" 
                                    Padding="8,3" 
                                    HorizontalAlignment="Right" 
                                    VerticalAlignment="Top">
                                <TextBlock Text="TOP 5" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushPrimary}"/>
                            </Border>
                        </Grid>

                        <!-- Lista dos 5 Clientes quando existem dados -->
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding TopClientes}" Visibility="{Binding TemTopClientes, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BrushBorder}" 
                                            BorderThickness="0,0,0,1" 
                                            Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24"/> <!-- 01, 02 -->
                                                <ColumnDefinition Width="38"/> <!-- Avatar Circle -->
                                                <ColumnDefinition Width="*"/>  <!-- Nome & Atendimentos -->
                                                <ColumnDefinition Width="Auto"/> <!-- R$ Total -->
                                            </Grid.ColumnDefinitions>

                                            <!-- Posição -->
                                            <TextBlock Grid.Column="0" 
                                                       Text="{Binding Posicao}" 
                                                       FontSize="11" 
                                                       FontWeight="Medium" 
                                                       Foreground="{StaticResource BrushTextSecondary}" 
                                                       VerticalAlignment="Center"/>

                                            <!-- Avatar Circular -->
                                            <Border Grid.Column="1" 
                                                    Width="30" Height="30" 
                                                    CornerRadius="15" 
                                                    Background="{Binding AvatarBg}" 
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Iniciais}" 
                                                           FontSize="11" 
                                                           FontWeight="Bold" 
                                                           Foreground="{StaticResource BrushPrimary}" 
                                                           HorizontalAlignment="Center" 
                                                           VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- Nome e Atendimentos -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="4,0,0,0">
                                                <TextBlock Text="{Binding Nome}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                                <TextBlock Text="{Binding AtendimentosTexto}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                                            </StackPanel>

                                            <!-- Total Gasto -->
                                            <TextBlock Grid.Column="3" 
                                                       Text="{Binding TotalGastoTexto}" 
                                                       FontSize="12" 
                                                       FontWeight="Bold" 
                                                       Foreground="{StaticResource BrushTextPrimary}" 
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Estado Vazio quando não há clientes finalizados no período -->
                        <Border Grid.Row="1" 
                                Background="{StaticResource BrushBackground}" 
                                BorderBrush="{StaticResource BrushBorder}" 
                                BorderThickness="1" 
                                CornerRadius="8" 
                                Padding="20,24" 
                                Margin="0,8"
                                Visibility="{Binding SemTopClientes, Converter={StaticResource BoolToVis}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource BrushSurfaceSubtle}" HorizontalAlignment="Center" Margin="0,0,0,10">
                                    <ui:SymbolIcon Symbol="PeopleStar24" FontSize="20" Foreground="{StaticResource BrushPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Nenhum atendimento finalizado" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Finalize comandas no ano selecionado para visualizar o ranking." FontSize="11" Foreground="{StaticResource BrushTextSecondary}" TextAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Rodapé: Ver todos os clientes -->
                        <Button Grid.Row="2" 
                                Command="{Binding IrParaClientesCommand}" 
                                Background="Transparent" 
                                BorderThickness="0" 
                                Padding="0" 
                                Cursor="Hand"
                                HorizontalAlignment="Right"
                                Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Ver todos os clientes" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushPrimary}"/>
                                <ui:SymbolIcon Symbol="ArrowUpRight24" FontSize="11" Foreground="{StaticResource BrushPrimary}" Margin="4,2,0,0"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===================== 4. AGENDA DO DIA (TABELA) ===================== -->
            <Border Grid.Row="3" 
                    Background="{StaticResource BrushSurface}" 
                    BorderBrush="{StaticResource BrushBorder}" 
                    BorderThickness="1" 
                    CornerRadius="12" 
                    Padding="22,18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Título & Link -->
                        <RowDefinition Height="Auto"/> <!-- Cabeçalho da Tabela -->
                        <RowDefinition Height="*"/>    <!-- Linhas da Tabela ou Empty State -->
                    </Grid.RowDefinitions>

                    <!-- Cabeçalho do Card Agenda do Dia -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TituloAgendaTabela}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,8,0"/>
                            <Border Background="{StaticResource BrushSurfaceSubtle}" CornerRadius="4" Padding="7,2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding AgendamentosHoje}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushPrimary}"/>
                            </Border>
                        </StackPanel>

                        <Button HorizontalAlignment="Right" 
                                Command="{Binding IrParaAgendaCommand}" 
                                Background="Transparent" 
                                BorderThickness="0" 
                                Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Ver agenda completa" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushPrimary}"/>
                                <ui:SymbolIcon Symbol="ArrowUpRight24" FontSize="11" Foreground="{StaticResource BrushPrimary}" Margin="4,2,0,0"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Cabeçalho das Colunas da Tabela (visível quando existem agendamentos) -->
                    <Border Grid.Row="1" 
                            Background="#FAF9F8" 
                            CornerRadius="6" 
                            Padding="12,8" 
                            Margin="0,0,0,4"
                            Visibility="{Binding TemAgendamentos, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="65"/>  <!-- Horário -->
                                <ColumnDefinition Width="160"/> <!-- Cliente -->
                                <ColumnDefinition Width="*"/>   <!-- Serviços -->
                                <ColumnDefinition Width="90"/>  <!-- Duração -->
                                <ColumnDefinition Width="90"/>  <!-- Valor -->
                                <ColumnDefinition Width="100"/> <!-- Status -->
                                <ColumnDefinition Width="24"/>  <!-- Seta -->
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Horário" FontSize="11" FontWeight="Medium" Foreground="{StaticResource BrushTextSecondary}"/>
                            <TextBlock Grid.Column="1" Text="Cliente" FontSize="11" FontWeight="Medium" Foreground="{StaticResource BrushTextSecondary}"/>
                            <TextBlock Grid.Column="2" Text="Serviços" FontSize="11" FontWeight="Medium" Foreground="{StaticResource BrushTextSecondary}"/>
                            <TextBlock Grid.Column="3" Text="Duração" FontSize="11" FontWeight="Medium" Foreground="{StaticResource BrushTextSecondary}"/>
                            <TextBlock Grid.Column="4" Text="Valor" FontSize="11" FontWeight="Medium" Foreground="{StaticResource BrushTextSecondary}"/>
                            <TextBlock Grid.Column="5" Text="Status" FontSize="11" FontWeight="Medium" Foreground="{StaticResource BrushTextSecondary}"/>
                        </Grid>
                    </Border>

                    <!-- Lista de Agendamentos Reais do Dia -->
                    <ItemsControl Grid.Row="2" ItemsSource="{Binding AgendaDoDia}" Visibility="{Binding TemAgendamentos, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BrushBorder}" 
                                        BorderThickness="0,0,0,1" 
                                        Padding="12,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="65"/>  <!-- Horário -->
                                            <ColumnDefinition Width="160"/> <!-- Cliente -->
                                            <ColumnDefinition Width="*"/>   <!-- Serviços -->
                                            <ColumnDefinition Width="90"/>  <!-- Duração -->
                                            <ColumnDefinition Width="90"/>  <!-- Valor -->
                                            <ColumnDefinition Width="100"/> <!-- Status -->
                                            <ColumnDefinition Width="24"/>  <!-- Seta -->
                                        </Grid.ColumnDefinitions>

                                        <!-- Horário -->
                                        <TextBlock Grid.Column="0" 
                                                   Text="{Binding Horario}" 
                                                   FontSize="12" 
                                                   FontWeight="Bold" 
                                                   Foreground="{StaticResource BrushTextPrimary}" 
                                                   VerticalAlignment="Center"/>

                                        <!-- Cliente (Avatar + Nome) -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="26" Height="26" CornerRadius="13" Background="{StaticResource BrushSurfaceSubtle}" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Iniciais}" 
                                                           FontSize="10" 
                                                           FontWeight="Bold" 
                                                           Foreground="{StaticResource BrushPrimary}" 
                                                           HorizontalAlignment="Center" 
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{Binding NomeCliente}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Serviços -->
                                        <TextBlock Grid.Column="2" 
                                                   Text="{Binding Servicos}" 
                                                   FontSize="12" 
                                                   Foreground="{StaticResource BrushTextSecondary}" 
                                                   VerticalAlignment="Center" 
                                                   TextTrimming="CharacterEllipsis"/>

                                        <!-- Duração com Ícone de Relógio -->
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="Clock24" FontSize="13" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,5,0"/>
                                            <TextBlock Text="{Binding Duracao}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Valor -->
                                        <TextBlock Grid.Column="4" 
                                                   Text="{Binding Valor}" 
                                                   FontSize="12" 
                                                   FontWeight="Bold" 
                                                   Foreground="{StaticResource BrushTextPrimary}" 
                                                   VerticalAlignment="Center"/>

                                        <!-- Badge de Status -->
                                        <Border Grid.Column="5" 
                                                Background="{StaticResource BrushSurfaceSubtle}" 
                                                CornerRadius="10" 
                                                Padding="8,3" 
                                                HorizontalAlignment="Left" 
                                                VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="5" Height="5" Fill="{StaticResource BrushPrimary}" Margin="0,0,4,0"/>
                                                <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrushPrimary}"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Seta de Ação -->
                                        <ui:SymbolIcon Grid.Column="6" Symbol="ChevronRight24" FontSize="13" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Estado Vazio quando não há agendamentos no dia -->
                    <Border Grid.Row="2" 
                            Background="{StaticResource BrushBackground}" 
                            BorderBrush="{StaticResource BrushBorder}" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Padding="32,28" 
                            Margin="0,8,0,0"
                            Visibility="{Binding SemAgendamentos, Converter={StaticResource BoolToVis}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="44" Height="44" CornerRadius="22" Background="{StaticResource BrushSurfaceSubtle}" HorizontalAlignment="Center" Margin="0,0,0,12">
                                <ui:SymbolIcon Symbol="CalendarClock24" FontSize="22" Foreground="{StaticResource BrushPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Nenhum agendamento para este dia" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Você pode navegar pelas datas no topo ou marcar um novo atendimento para esta data." FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,16" HorizontalAlignment="Center"/>
                            <Button Command="{Binding NovoAgendamentoCommand}"
                                    Background="{StaticResource BrushPrimary}"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Padding="14,8"
                                    Cursor="Hand"
                                    HorizontalAlignment="Center">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Add24" FontSize="14" Foreground="White" Margin="0,0,6,0"/>
                                    <TextBlock Text="Agendar novo horário" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
