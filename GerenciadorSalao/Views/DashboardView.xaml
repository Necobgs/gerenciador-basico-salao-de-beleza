<UserControl x:Class="GerenciadorSalao.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="1200" d:DesignWidth="1100">

    <UserControl.Resources>
        <!-- Estilo ComboBox em Pílula (Ano completo ▾ / 2026 ▾) -->
        <ControlTemplate x:Key="ComboBoxToggleButtonTemplate" TargetType="ToggleButton">
            <Border x:Name="Border"
                    Background="{StaticResource BrushSurface}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ContentPresenter Grid.Column="0"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Left"
                                      Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="1"
                               Text="▾"
                               FontSize="10"
                               Foreground="{StaticResource BrushTextSecondary}"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                    <Setter TargetName="Border" Property="Background" Value="#FAF8F7"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource BrushPrimary}"/>
                    <Setter TargetName="Border" Property="Background" Value="#FAF8F7"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="PillComboBoxStyle" TargetType="ComboBox">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Template="{StaticResource ComboBoxToggleButtonTemplate}">
                                <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                  VerticalAlignment="Center"/>
                            </ToggleButton>

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade"
                                   VerticalOffset="4">
                                <Border x:Name="DropDownBorder"
                                        Background="{StaticResource BrushSurface}"
                                        BorderBrush="{StaticResource BrushBorder}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="360"
                                        Padding="4"
                                        SnapsToDevicePixels="True">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="10" Direction="270" ShadowDepth="3" Opacity="0.12" Color="#34302F"/>
                                    </Border.Effect>
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Padding" Value="10,6"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBorder"
                                            Background="Transparent"
                                            CornerRadius="6"
                                            Padding="{TemplateBinding Padding}"
                                            Margin="0,1">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource BrushSurfaceSubtle}"/>
                                            <Setter Property="Foreground" Value="{StaticResource BrushPrimary}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#66605E"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo do Botão Primário (+ Novo agendamento) com Hover Elegante Terracota/Café -->
        <Style x:Key="PrimaryActionButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="{StaticResource BrushPrimary}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BrushPrimaryHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#553732"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo dos Botões de Navegação do Mês no Calendário (↑ / ↓) -->
        <Style x:Key="CalendarNavButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F5F2F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo dos Botões de Ação de Texto (Limpar / Hoje) -->
        <Style x:Key="FlatActionButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" Padding="6,4" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BrushInfoSubtle}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="28,20,28,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 1. Header da Página -->
                <RowDefinition Height="Auto"/> <!-- 2. Quatro Cards de Métricas -->
                <RowDefinition Height="Auto"/> <!-- 3. Faturamento (Gráfico) + Clientes Especiais (Top 5) -->
                <RowDefinition Height="Auto"/> <!-- 4. Agenda do Dia (Tabela) -->
            </Grid.RowDefinitions>

            <!-- ===================== 1. HEADER DA PÁGINA ===================== -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="SEU SALÃO, EM HARMONIA" 
                               FontSize="11" 
                               FontWeight="Bold" 
                               Foreground="{StaticResource BrushSecondary}" 
                               Margin="0,0,0,4"/>
                    <TextBlock Text="Visão geral" 
                               FontSize="26" 
                               FontWeight="Bold" 
                               Foreground="{StaticResource BrushTextPrimary}"/>
                    <TextBlock Text="Tudo pronto para mais um dia de beleza e cuidado." 
                               FontSize="13" 
                               Foreground="{StaticResource BrushTextSecondary}" 
                               Margin="0,3,0,0"/>
                </StackPanel>

                <!-- Ações do Topo: Data e Novo Agendamento -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Seletor de Data com Calendário Dropdown -->
                    <Grid Margin="0,0,10,0">
                        <ToggleButton x:Name="btnDatePicker"
                                      IsChecked="{Binding IsCalendarOpen, Mode=TwoWay}"
                                      FocusVisualStyle="{x:Null}"
                                      Cursor="Hand"
                                      OverridesDefaultStyle="True">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="btnBorder"
                                            Background="{StaticResource BrushSurface}"
                                            BorderBrush="{StaticResource BrushBorder}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="12,8">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DataHojeFormatada}" 
                                                       FontSize="12" 
                                                       FontWeight="Medium" 
                                                       Foreground="{StaticResource BrushTextPrimary}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0"/>
                                            <ui:SymbolIcon Symbol="CalendarLtr24" FontSize="15" Foreground="{StaticResource BrushTextSecondary}"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="btnBorder" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                            <Setter TargetName="btnBorder" Property="Background" Value="#FAF8F7"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="btnBorder" Property="BorderBrush" Value="{StaticResource BrushPrimary}"/>
                                            <Setter TargetName="btnBorder" Property="Background" Value="#FAF8F7"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <!-- Popup do Calendário Suspenso -->
                        <Popup Placement="Bottom"
                               PlacementTarget="{Binding ElementName=btnDatePicker}"
                               IsOpen="{Binding IsCalendarOpen, Mode=TwoWay}"
                               StaysOpen="False"
                               AllowsTransparency="True"
                               PopupAnimation="Fade"
                               VerticalOffset="6">
                            <Border Background="{StaticResource BrushSurface}"
                                    BorderBrush="{StaticResource BrushBorder}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="16"
                                    Width="260"
                                    SnapsToDevicePixels="True">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="4" Opacity="0.12" Color="#34302F"/>
                                </Border.Effect>

                                <StackPanel>
                                    <!-- Cabeçalho do Mês / Ano e Navegação (↑ / ↓) -->
                                    <Grid Margin="2,0,2,12">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding MesVisualizadoTexto}" 
                                                       FontSize="13" 
                                                       FontWeight="Bold" 
                                                       Foreground="{StaticResource BrushTextPrimary}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text=" ▾" 
                                                       FontSize="10" 
                                                       Foreground="{StaticResource BrushTextSecondary}" 
                                                       VerticalAlignment="Center" 
                                                       Margin="2,0,0,0"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Command="{Binding MesAnteriorCommand}"
                                                    ToolTip="Mês anterior"
                                                    Style="{StaticResource CalendarNavButtonStyle}"
                                                    Margin="0,0,2,0">
                                                <ui:SymbolIcon Symbol="ArrowUp24" FontSize="13" Foreground="{StaticResource BrushTextPrimary}"/>
                                            </Button>
                                            <Button Command="{Binding MesProximoCommand}"
                                                    ToolTip="Próximo mês"
                                                    Style="{StaticResource CalendarNavButtonStyle}">
                                                <ui:SymbolIcon Symbol="ArrowDown24" FontSize="13" Foreground="{StaticResource BrushTextPrimary}"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Cabeçalho dos Dias da Semana: D S T Q Q S S -->
                                    <UniformGrid Columns="7" Margin="0,0,0,8">
                                        <TextBlock Text="D" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="S" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="T" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Q" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Q" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="S" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="S" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center"/>
                                    </UniformGrid>

                                    <!-- Grade de Dias do Mês (6 semanas x 7 dias = 42 células) -->
                                    <ItemsControl ItemsSource="{Binding DiasCalendario}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="7" Rows="6"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.SelecionarDataCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding Data}"
                                                        FocusVisualStyle="{x:Null}"
                                                        Cursor="Hand"
                                                        Margin="0,2"
                                                        OverridesDefaultStyle="True">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="dayBorder"
                                                                    Width="28" Height="28"
                                                                    CornerRadius="4"
                                                                    Background="Transparent"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock x:Name="dayText"
                                                                           Text="{Binding Dia}"
                                                                           FontSize="12"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{StaticResource BrushTextPrimary}"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding IsMesAtual}" Value="False">
                                                                    <Setter TargetName="dayText" Property="Foreground" Value="#A8A29E"/>
                                                                </DataTrigger>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                                                                        <Condition Binding="{Binding IsSelecionado}" Value="False"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter TargetName="dayBorder" Property="Background" Value="#F5F2F0"/>
                                                                </MultiDataTrigger>
                                                                <DataTrigger Binding="{Binding IsSelecionado}" Value="True">
                                                                    <Setter TargetName="dayBorder" Property="Background" Value="#504746"/>
                                                                    <Setter TargetName="dayText" Property="Foreground" Value="White"/>
                                                                    <Setter TargetName="dayText" Property="FontWeight" Value="SemiBold"/>
                                                                </DataTrigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Linha de Ações Inferior: Limpar e Hoje -->
                                    <Grid Margin="2,14,2,2">
                                        <Button Command="{Binding LimparDataCommand}"
                                                Content="Limpar"
                                                FontSize="12"
                                                FontWeight="Medium"
                                                Foreground="{StaticResource BrushInfo}"
                                                HorizontalAlignment="Left"
                                                Style="{StaticResource FlatActionButtonStyle}"/>

                                        <Button Command="{Binding HojeDataCommand}"
                                                Content="Hoje"
                                                FontSize="12"
                                                FontWeight="Medium"
                                                Foreground="{StaticResource BrushInfo}"
                                                HorizontalAlignment="Right"
                                                Style="{StaticResource FlatActionButtonStyle}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- Botão Novo Agendamento -->
                    <Button Command="{Binding NovoAgendamentoCommand}"
                            Style="{StaticResource PrimaryActionButtonStyle}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Add24" FontSize="15" Foreground="White" Margin="0,0,6,0"/>
                            <TextBlock Text="Novo agendamento" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ===================== 2. QUATRO CARDS DE MÉTRICAS ===================== -->
            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Card 1: Faturamento do dia -->
                <Border Grid.Column="0" 
                        Background="{StaticResource BrushSurface}" 
                        BorderBrush="{StaticResource BrushBorder}" 
                        BorderThickness="1" 
                        CornerRadius="10" 
                        Padding="16,16" 
                        Margin="0,0,6,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <TextBlock Text="Faturamento do dia" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                            <Border Width="34" Height="34" CornerRadius="8" Background="{StaticResource BrushSurfaceSubtle}" HorizontalAlignment="Right">
                                <ui:SymbolIcon Symbol="Wallet24" FontSize="17" Foreground="{StaticResource BrushPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <TextBlock Grid.Row="1" 
                                   Text="{Binding FaturamentoHoje, StringFormat='{}{0:C2}'}" 
                                   FontSize="22" 
                                   FontWeight="Bold" 
                                   Foreground="{StaticResource BrushTextPrimary}" 
                                   Margin="0,10,0,4"/>

                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                            <TextBlock Text="• " FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                            <TextBlock Text="{Binding ComandasFinalizadasHoje}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                            <TextBlock Text=" comandas finalizadas" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Card 2: Comandas abertas -->
                <Border Grid.Column="1" 
                        Background="{StaticResource BrushSurface}" 
                        BorderBrush="{StaticResource BrushBorder}" 
                        BorderThickness="1" 
                        CornerRadius="10" 
                        Padding="16,16" 
                        Margin="4,0,4,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <TextBlock Text="Comandas abertas" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                            <Border Width="34" Height="34" CornerRadius="8" Background="{StaticResource BrushSurfaceSubtle}" HorizontalAlignment="Right">
                                <ui:SymbolIcon Symbol="ClipboardTextEdit24" FontSize="17" Foreground="{StaticResource BrushSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <TextBlock Grid.Row="1" 
                                   Text="{Binding ComandasAbertas, StringFormat='{}{0:D2}'}" 
                                   FontSize="22" 
                                   FontWeight="Bold" 
                                   Foreground="{StaticResource BrushTextPrimary}" 
                                   Margin="0,10,0,4"/>

                        <TextBlock Grid.Row="2" Text="• Atendimentos em andamento" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                    </Grid>
                </Border>

                <!-- Card 3: Agendamentos hoje -->
                <Border Grid.Column="2" 
                        Background="{StaticResource BrushSurface}" 
                        BorderBrush="{StaticResource BrushBorder}" 
                        BorderThickness="1" 
                        CornerRadius="10" 
                        Padding="16,16" 
                        Margin="4,0,4,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <TextBlock Text="Agendamentos hoje" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                            <Border Width="34" Height="34" CornerRadius="8" Background="#E8F5E9" HorizontalAlignment="Right">
                                <ui:SymbolIcon Symbol="CalendarLtr24" FontSize="17" Foreground="#2E7D32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <TextBlock Grid.Row="1" 
                                   Text="{Binding AgendamentosHoje, StringFormat='{}{0:D2}'}" 
                                   FontSize="22" 
                                   FontWeight="Bold" 
                                   Foreground="{StaticResource BrushTextPrimary}" 
                                   Margin="0,10,0,4"/>

                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                            <TextBlock Text="• " FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                            <TextBlock Text="{Binding AgendamentosPendentesHoje}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                            <TextBlock Text=" aguardando atendimento" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Card 4: Clientes cadastrados -->
                <Border Grid.Column="3" 
                        Background="{StaticResource BrushSurface}" 
                        BorderBrush="{StaticResource BrushBorder}" 
                        BorderThickness="1" 
                        CornerRadius="10" 
                        Padding="16,16" 
                        Margin="6,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <TextBlock Text="Clientes cadastrados" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                            <Border Width="34" Height="34" CornerRadius="8" Background="#E3F2FD" HorizontalAlignment="Right">
                                <ui:SymbolIcon Symbol="People24" FontSize="17" Foreground="#1565C0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <TextBlock Grid.Row="1" 
                                   Text="{Binding TotalClientes, StringFormat='{}{0:D2}'}" 
                                   FontSize="22" 
                                   FontWeight="Bold" 
                                   Foreground="{StaticResource BrushTextPrimary}" 
                                   Margin="0,10,0,4"/>

                        <TextBlock Grid.Row="2" Text="• Conexões que fazem a diferença" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===================== 3. FATURAMENTO (GRÁFICO) + CLIENTES ESPECIAIS (TOP 5) ===================== -->
            <Grid Grid.Row="2" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- CARD ESQUERDA: FATURAMENTO ANUAL COM GRÁFICO -->
                <Border Grid.Column="0" 
                        Background="{StaticResource BrushSurface}" 
                        BorderBrush="{StaticResource BrushBorder}" 
                        BorderThickness="1" 
                        CornerRadius="12" 
                        Padding="22,18" 
                        Margin="0,0,8,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Título & Filtros -->
                            <RowDefinition Height="Auto"/> <!-- Valor Acumulado & Legenda -->
                            <RowDefinition Height="Auto"/> <!-- Gráfico Visual -->
                            <RowDefinition Height="Auto"/> <!-- Rodapé -->
                        </Grid.RowDefinitions>

                        <!-- Cabeçalho do Card Faturamento -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Faturamento" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                                <TextBlock Text="Uma visão dos resultados do seu salão" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- Filtros (Ano completo e Ano) -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <ComboBox Style="{StaticResource PillComboBoxStyle}"
                                          ItemsSource="{Binding PeriodosDisponiveis}"
                                          SelectedItem="{Binding PeriodoSelecionado}"
                                          Margin="0,0,6,0"/>
                                <ComboBox Style="{StaticResource PillComboBoxStyle}"
                                          ItemsSource="{Binding AnosDisponiveis}"
                                          SelectedItem="{Binding AnoSelecionado}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Valor Acumulado e Tag -->
                        <Grid Grid.Row="1" Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding FaturamentoAcumuladoAno, StringFormat='{}{0:C2}'}" 
                                           FontSize="24" 
                                           FontWeight="Bold" 
                                           Foreground="{StaticResource BrushTextPrimary}" 
                                           Margin="0,0,10,0"/>
                                <Border Background="{StaticResource BrushSurfaceSubtle}" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TagFaturamentoPeriodo}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushPrimary}"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource BrushPrimary}" Margin="0,0,6,0"/>
                                <TextBlock Text="Faturamento" FontSize="11" FontWeight="Medium" Foreground="{StaticResource BrushTextSecondary}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Área Completa do Gráfico (Eixo Y + Grid/Linha + Eixo X Meses) -->
                        <Grid Grid.Row="2" Margin="0,0,0,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="148"/> <!-- Área do Gráfico e Linhas -->
                                <RowDefinition Height="24"/>  <!-- Labels dos Meses (Eixo X) -->
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48"/> <!-- Eixo Y Labels -->
                                <ColumnDefinition Width="*"/>   <!-- Área do Gráfico Interativo -->
                            </Grid.ColumnDefinitions>

                            <!-- Labels do Eixo Y -->
                            <Grid Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="3.4 mil" FontSize="10" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Top"/>
                                <TextBlock Text="2.55 mil" FontSize="10" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Top" Margin="0,35,0,0"/>
                                <TextBlock Text="1.7 mil" FontSize="10" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Top" Margin="0,70,0,0"/>
                                <TextBlock Text="0.85 mil" FontSize="10" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Top" Margin="0,105,0,0"/>
                                <TextBlock Text="R$ 0" FontSize="10" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                            </Grid>

                            <!-- Área do Gráfico com Curva, Linhas e Hover Interativo -->
                            <Grid x:Name="ChartAreaGrid" 
                                  Grid.Row="0" 
                                  Grid.Column="1" 
                                  Background="Transparent"
                                  MouseMove="ChartArea_MouseMove"
                                  MouseLeave="ChartArea_MouseLeave">

                                <!-- Linhas de Guia Horizontais Tracejadas -->
                                <Canvas HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <Line X1="0" Y1="6" X2="600" Y2="6" Stroke="{StaticResource BrushBorder}" StrokeDashArray="3 3"/>
                                    <Line X1="0" Y1="41" X2="600" Y2="41" Stroke="{StaticResource BrushBorder}" StrokeDashArray="3 3"/>
                                    <Line X1="0" Y1="76" X2="600" Y2="76" Stroke="{StaticResource BrushBorder}" StrokeDashArray="3 3"/>
                                    <Line X1="0" Y1="111" X2="600" Y2="111" Stroke="{StaticResource BrushBorder}" StrokeDashArray="3 3"/>
                                    <Line X1="0" Y1="145" X2="600" Y2="145" Stroke="{StaticResource BrushBorder}"/>
                                </Canvas>

                                <!-- Curva e Preenchimento em Degradê Rosé Marsala -->
                                <Path Stretch="Fill" Margin="4,8,4,4" Stroke="{StaticResource BrushPrimary}" StrokeThickness="3">
                                    <Path.Data>
                                        <PathGeometry>
                                            <PathFigure StartPoint="0,85">
                                                <PolyBezierSegment Points="80,75 160,60 240,42 320,22 360,10 380,35 400,140 420,142 450,142"/>
                                            </PathFigure>
                                        </PathGeometry>
                                    </Path.Data>
                                </Path>

                                <!-- Preenchimento Suave sob a Curva -->
                                <Path Stretch="Fill" Margin="4,8,4,4" Opacity="0.18">
                                    <Path.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#64423C" Offset="0.0"/>
                                            <GradientStop Color="#FEE9E6" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Path.Fill>
                                    <Path.Data>
                                        <PathGeometry>
                                            <PathFigure StartPoint="0,85" IsClosed="True">
                                                <PolyBezierSegment Points="80,75 160,60 240,42 320,22 360,10 380,35 400,140 420,142 450,142"/>
                                                <LineSegment Point="450,142"/>
                                                <LineSegment Point="0,142"/>
                                            </PathFigure>
                                        </PathGeometry>
                                    </Path.Data>
                                </Path>

                                <!-- Camada de Hover: Linha Vertical Guia, Ponto e Tooltip Flutuante -->
                                <Canvas HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsHitTestVisible="False">
                                    <!-- Linha Vertical Guia -->
                                    <Line X1="{Binding HoverIndicatorX}" 
                                          Y1="6" 
                                          X2="{Binding HoverIndicatorX}" 
                                          Y2="145" 
                                          Stroke="#D5CEC9" 
                                          StrokeThickness="1" 
                                          Visibility="{Binding IsChartHovered, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                    <!-- Ponto Marcador na Curva -->
                                    <Ellipse Canvas.Left="{Binding HoverDotLeft}" 
                                             Canvas.Top="{Binding HoverDotTop}"
                                             Width="10" Height="10"
                                             Fill="{StaticResource BrushPrimary}"
                                             Stroke="White"
                                             StrokeThickness="2"
                                             Visibility="{Binding IsChartHovered, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Ellipse.Effect>
                                            <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.3" Color="#64423C"/>
                                        </Ellipse.Effect>
                                    </Ellipse>

                                    <!-- Card Tooltip Flutuante -->
                                    <Border Canvas.Left="{Binding HoverTooltipX}" 
                                            Canvas.Top="{Binding HoverTooltipY}"
                                            Background="White"
                                            BorderBrush="{StaticResource BrushBorder}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="12,8"
                                            Visibility="{Binding IsChartHovered, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="10" Direction="270" ShadowDepth="3" Opacity="0.12" Color="#34302F"/>
                                        </Border.Effect>
                                        <StackPanel>
                                            <TextBlock Text="{Binding HoverMesNome}" 
                                                       FontSize="13" 
                                                       FontWeight="Bold" 
                                                       Foreground="{StaticResource BrushTextPrimary}"
                                                       Margin="0,0,0,3"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Faturamento : " 
                                                           FontSize="12" 
                                                           Foreground="{StaticResource BrushTextSecondary}"/>
                                                <TextBlock Text="{Binding HoverMesValorFormatado}" 
                                                           FontSize="12" 
                                                           FontWeight="SemiBold" 
                                                           Foreground="{StaticResource BrushTextPrimary}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Canvas>
                            </Grid>

                            <!-- Labels dos Meses (Eixo X) -->
                            <UniformGrid Grid.Row="1" Grid.Column="1" Columns="12" VerticalAlignment="Center">
                                <TextBlock Text="Jan" FontSize="10" Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Fev" FontSize="10" Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Mar" FontSize="10" Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Abr" FontSize="10" Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Mai" FontSize="10" Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Jun" FontSize="10" Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Jul" FontSize="10" Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Ago" FontSize="10" Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Set" FontSize="10" Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Out" FontSize="10" Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Nov" FontSize="10" Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Dez" FontSize="10" Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Center"/>
                            </UniformGrid>
                        </Grid>

                        <!-- Rodapé do Card Faturamento -->
                        <Grid Grid.Row="3" Margin="-22,14,-22,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Linha Divisória de ponta a ponta -->
                                <RowDefinition Height="Auto"/> <!-- Textos e Botão -->
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Height="1" Background="{StaticResource BrushBorder}"/>

                            <Grid Grid.Row="1" Margin="22,12,22,0">
                                <TextBlock Text="Considera apenas comandas pagas" 
                                           FontSize="11" 
                                           Foreground="{StaticResource BrushTextSecondary}" 
                                           VerticalAlignment="Center"/>

                                <Button HorizontalAlignment="Right" 
                                        VerticalAlignment="Center"
                                        Command="{Binding IrParaRelatoriosCommand}" 
                                        Background="Transparent" 
                                        BorderThickness="0" 
                                        Padding="0" 
                                        Cursor="Hand">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Ver relatório completo" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushPrimary}" VerticalAlignment="Center"/>
                                        <ui:SymbolIcon Symbol="ArrowUpRight24" FontSize="12" Foreground="{StaticResource BrushPrimary}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <!-- CARD DIREITA: CLIENTES ESPECIAIS (TOP 5) -->
                <Border Grid.Column="1" 
                        Background="{StaticResource BrushSurface}" 
                        BorderBrush="{StaticResource BrushBorder}" 
                        BorderThickness="1" 
                        CornerRadius="12" 
                        Padding="20,18" 
                        Margin="6,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Header -->
                            <RowDefinition Height="*"/>    <!-- Lista Top 5 -->
                            <RowDefinition Height="Auto"/> <!-- Rodapé -->
                        </Grid.RowDefinitions>

                        <!-- Cabeçalho Clientes Especiais -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Clientes especiais ✦" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                                </StackPanel>
                                <TextBlock Text="Quem mais esteve com você" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <Border Background="{StaticResource BrushSurfaceSubtle}" 
                                    CornerRadius="4" 
                                    Padding="8,3" 
                                    HorizontalAlignment="Right" 
                                    VerticalAlignment="Top">
                                <TextBlock Text="TOP 5" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushPrimary}"/>
                            </Border>
                        </Grid>

                        <!-- Lista dos 5 Clientes -->
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding TopClientes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BrushBorder}" 
                                            BorderThickness="0,0,0,1" 
                                            Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24"/> <!-- 01, 02 -->
                                                <ColumnDefinition Width="38"/> <!-- Avatar Circle -->
                                                <ColumnDefinition Width="*"/>  <!-- Nome & Atendimentos -->
                                                <ColumnDefinition Width="Auto"/> <!-- R$ Total -->
                                            </Grid.ColumnDefinitions>

                                            <!-- Posição -->
                                            <TextBlock Grid.Column="0" 
                                                       Text="{Binding Posicao}" 
                                                       FontSize="11" 
                                                       FontWeight="Medium" 
                                                       Foreground="{StaticResource BrushTextSecondary}" 
                                                       VerticalAlignment="Center"/>

                                            <!-- Avatar Circular -->
                                            <Border Grid.Column="1" 
                                                    Width="30" Height="30" 
                                                    CornerRadius="15" 
                                                    Background="{Binding AvatarBg}" 
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Iniciais}" 
                                                           FontSize="11" 
                                                           FontWeight="Bold" 
                                                           Foreground="{StaticResource BrushPrimary}" 
                                                           HorizontalAlignment="Center" 
                                                           VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- Nome e Atendimentos -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="4,0,0,0">
                                                <TextBlock Text="{Binding Nome}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                                <TextBlock Text="{Binding AtendimentosTexto}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                                            </StackPanel>

                                            <!-- Total Gasto -->
                                            <TextBlock Grid.Column="3" 
                                                       Text="{Binding TotalGastoTexto}" 
                                                       FontSize="12" 
                                                       FontWeight="Bold" 
                                                       Foreground="{StaticResource BrushTextPrimary}" 
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Rodapé: Ver todos os clientes -->
                        <Button Grid.Row="2" 
                                Command="{Binding IrParaClientesCommand}" 
                                Background="Transparent" 
                                BorderThickness="0" 
                                Padding="0" 
                                Cursor="Hand"
                                HorizontalAlignment="Right"
                                Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Ver todos os clientes" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushPrimary}"/>
                                <ui:SymbolIcon Symbol="ArrowUpRight24" FontSize="11" Foreground="{StaticResource BrushPrimary}" Margin="4,2,0,0"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===================== 4. AGENDA DO DIA (TABELA) ===================== -->
            <Border Grid.Row="3" 
                    Background="{StaticResource BrushSurface}" 
                    BorderBrush="{StaticResource BrushBorder}" 
                    BorderThickness="1" 
                    CornerRadius="12" 
                    Padding="22,18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Título & Link -->
                        <RowDefinition Height="Auto"/> <!-- Cabeçalho da Tabela -->
                        <RowDefinition Height="*"/>    <!-- Linhas da Tabela -->
                    </Grid.RowDefinitions>

                    <!-- Cabeçalho do Card Agenda do Dia -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Agenda do dia" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,8,0"/>
                            <Border Background="{StaticResource BrushSurfaceSubtle}" CornerRadius="4" Padding="7,2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding AgendamentosHoje}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushPrimary}"/>
                            </Border>
                        </StackPanel>

                        <Button HorizontalAlignment="Right" 
                                Command="{Binding IrParaAgendaCommand}" 
                                Background="Transparent" 
                                BorderThickness="0" 
                                Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Ver agenda completa" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushPrimary}"/>
                                <ui:SymbolIcon Symbol="ArrowUpRight24" FontSize="11" Foreground="{StaticResource BrushPrimary}" Margin="4,2,0,0"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Cabeçalho das Colunas da Tabela -->
                    <Border Grid.Row="1" Background="#FAF9F8" CornerRadius="6" Padding="12,8" Margin="0,0,0,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="65"/>  <!-- Horário -->
                                <ColumnDefinition Width="160"/> <!-- Cliente -->
                                <ColumnDefinition Width="*"/>   <!-- Serviços -->
                                <ColumnDefinition Width="90"/>  <!-- Duração -->
                                <ColumnDefinition Width="90"/>  <!-- Valor -->
                                <ColumnDefinition Width="100"/> <!-- Status -->
                                <ColumnDefinition Width="24"/>  <!-- Seta -->
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Horário" FontSize="11" FontWeight="Medium" Foreground="{StaticResource BrushTextSecondary}"/>
                            <TextBlock Grid.Column="1" Text="Cliente" FontSize="11" FontWeight="Medium" Foreground="{StaticResource BrushTextSecondary}"/>
                            <TextBlock Grid.Column="2" Text="Serviços" FontSize="11" FontWeight="Medium" Foreground="{StaticResource BrushTextSecondary}"/>
                            <TextBlock Grid.Column="3" Text="Duração" FontSize="11" FontWeight="Medium" Foreground="{StaticResource BrushTextSecondary}"/>
                            <TextBlock Grid.Column="4" Text="Valor" FontSize="11" FontWeight="Medium" Foreground="{StaticResource BrushTextSecondary}"/>
                            <TextBlock Grid.Column="5" Text="Status" FontSize="11" FontWeight="Medium" Foreground="{StaticResource BrushTextSecondary}"/>
                        </Grid>
                    </Border>

                    <!-- Lista de Agendamentos -->
                    <ItemsControl Grid.Row="2" ItemsSource="{Binding AgendaDoDia}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BrushBorder}" 
                                        BorderThickness="0,0,0,1" 
                                        Padding="12,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="65"/>  <!-- Horário -->
                                            <ColumnDefinition Width="160"/> <!-- Cliente -->
                                            <ColumnDefinition Width="*"/>   <!-- Serviços -->
                                            <ColumnDefinition Width="90"/>  <!-- Duração -->
                                            <ColumnDefinition Width="90"/>  <!-- Valor -->
                                            <ColumnDefinition Width="100"/> <!-- Status -->
                                            <ColumnDefinition Width="24"/>  <!-- Seta -->
                                        </Grid.ColumnDefinitions>

                                        <!-- Horário -->
                                        <TextBlock Grid.Column="0" 
                                                   Text="{Binding Horario}" 
                                                   FontSize="12" 
                                                   FontWeight="Bold" 
                                                   Foreground="{StaticResource BrushTextPrimary}" 
                                                   VerticalAlignment="Center"/>

                                        <!-- Cliente (Avatar + Nome) -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="26" Height="26" CornerRadius="13" Background="{StaticResource BrushSurfaceSubtle}" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Iniciais}" 
                                                           FontSize="10" 
                                                           FontWeight="Bold" 
                                                           Foreground="{StaticResource BrushPrimary}" 
                                                           HorizontalAlignment="Center" 
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{Binding NomeCliente}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Serviços -->
                                        <TextBlock Grid.Column="2" 
                                                   Text="{Binding Servicos}" 
                                                   FontSize="12" 
                                                   Foreground="{StaticResource BrushTextSecondary}" 
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <!-- Duração com Ícone de Relógio -->
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="Clock24" FontSize="13" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,5,0"/>
                                            <TextBlock Text="{Binding Duracao}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Valor -->
                                        <TextBlock Grid.Column="4" 
                                                   Text="{Binding Valor}" 
                                                   FontSize="12" 
                                                   FontWeight="Bold" 
                                                   Foreground="{StaticResource BrushTextPrimary}" 
                                                   VerticalAlignment="Center"/>

                                        <!-- Badge de Status -->
                                        <Border Grid.Column="5" 
                                                Background="{StaticResource BrushSurfaceSubtle}" 
                                                CornerRadius="10" 
                                                Padding="8,3" 
                                                HorizontalAlignment="Left" 
                                                VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="5" Height="5" Fill="{StaticResource BrushPrimary}" Margin="0,0,4,0"/>
                                                <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrushPrimary}"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Seta de Ação -->
                                        <ui:SymbolIcon Grid.Column="6" Symbol="ChevronRight24" FontSize="13" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
