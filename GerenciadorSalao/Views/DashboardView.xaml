<UserControl x:Class="GerenciadorSalao.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:GerenciadorSalao.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="1200" d:DesignWidth="1100">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Botão sutil circular / ícone do Header -->
        <Style x:Key="HeaderNavIconButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="{StaticResource BrushSurface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BrushSurfaceSubtle}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo dos Botões de Navegação do Mês no Calendário (↑ / ↓) -->
        <Style x:Key="CalendarNavButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F5F2F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo dos Botões de Ação de Texto (Limpar / Hoje) -->
        <Style x:Key="FlatActionButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" Padding="6,4" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BrushInfoSubtle}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="28,20,28,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 1. Header da Página -->
                <RowDefinition Height="Auto"/> <!-- 2. Quatro Cards de Métricas -->
                <RowDefinition Height="Auto"/> <!-- 3. Serviços Populares + Clientes Mais Frequentes (Top 5) -->
                <RowDefinition Height="Auto"/> <!-- 4. Agenda do Dia (Tabela) -->
            </Grid.RowDefinitions>

            <!-- ===================== 1. HEADER DA PÁGINA ===================== -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="SEU SALÃO, EM HARMONIA" 
                               FontSize="11" 
                               FontWeight="Bold" 
                               Foreground="{StaticResource BrushSecondary}" 
                               Margin="0,0,0,4"/>
                    <TextBlock Text="Visão geral" 
                               FontSize="26" 
                               FontWeight="Bold" 
                               Foreground="{StaticResource BrushTextPrimary}"/>
                    <TextBlock Text="Tudo pronto para mais um dia de beleza e cuidado." 
                               FontSize="13" 
                               Foreground="{StaticResource BrushTextSecondary}" 
                               Margin="0,3,0,0"/>
                </StackPanel>

                <!-- Ações do Topo: Data com Calendário Dropdown, Recarregar e Novo Agendamento -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Seletor de Data com Calendário Dropdown -->
                    <Grid Margin="0,0,10,0">
                        <ToggleButton x:Name="btnDatePicker"
                                      IsChecked="{Binding IsCalendarOpen, Mode=TwoWay}"
                                      FocusVisualStyle="{x:Null}"
                                      Cursor="Hand"
                                      OverridesDefaultStyle="True">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="btnBorder"
                                            Background="{StaticResource BrushSurface}"
                                            BorderBrush="{StaticResource BrushBorder}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="12,8">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DataHojeFormatada}" 
                                                       FontSize="12" 
                                                       FontWeight="Medium" 
                                                       Foreground="{StaticResource BrushTextPrimary}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0"/>
                                            <ui:SymbolIcon Symbol="CalendarLtr24" FontSize="15" Foreground="{StaticResource BrushTextSecondary}"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="btnBorder" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                            <Setter TargetName="btnBorder" Property="Background" Value="#FAF8F7"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="btnBorder" Property="BorderBrush" Value="{StaticResource BrushPrimary}"/>
                                            <Setter TargetName="btnBorder" Property="Background" Value="#FAF8F7"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <!-- Popup do Calendário Suspenso -->
                        <Popup Placement="Bottom"
                               PlacementTarget="{Binding ElementName=btnDatePicker}"
                               IsOpen="{Binding IsCalendarOpen, Mode=TwoWay}"
                               StaysOpen="False"
                               AllowsTransparency="True"
                               PopupAnimation="Fade"
                               VerticalOffset="6">
                            <Border Background="{StaticResource BrushSurface}"
                                    BorderBrush="{StaticResource BrushBorder}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="16"
                                    Width="260"
                                    SnapsToDevicePixels="True">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="4" Opacity="0.12" Color="#34302F"/>
                                </Border.Effect>

                                <StackPanel>
                                    <!-- Cabeçalho do Mês / Ano e Navegação (↑ / ↓) -->
                                    <Grid Margin="2,0,2,12">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding MesVisualizadoTexto}" 
                                                       FontSize="13" 
                                                       FontWeight="Bold" 
                                                       Foreground="{StaticResource BrushTextPrimary}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text=" ▾" 
                                                       FontSize="10" 
                                                       Foreground="{StaticResource BrushTextSecondary}" 
                                                       VerticalAlignment="Center" 
                                                       Margin="2,0,0,0"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Command="{Binding MesAnteriorCommand}"
                                                    ToolTip="Mês anterior"
                                                    Style="{StaticResource CalendarNavButtonStyle}"
                                                    Margin="0,0,2,0">
                                                <ui:SymbolIcon Symbol="ArrowUp24" FontSize="13" Foreground="{StaticResource BrushTextPrimary}"/>
                                            </Button>
                                            <Button Command="{Binding MesProximoCommand}"
                                                    ToolTip="Próximo mês"
                                                    Style="{StaticResource CalendarNavButtonStyle}">
                                                <ui:SymbolIcon Symbol="ArrowDown24" FontSize="13" Foreground="{StaticResource BrushTextPrimary}"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Cabeçalho dos Dias da Semana: D S T Q Q S S -->
                                    <UniformGrid Columns="7" Margin="0,0,0,8">
                                        <TextBlock Text="D" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="S" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="T" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Q" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Q" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="S" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="S" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center"/>
                                    </UniformGrid>

                                    <!-- Grade de Dias do Mês (6 semanas x 7 dias = 42 células) -->
                                    <ItemsControl ItemsSource="{Binding DiasCalendario}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="7" Rows="6"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.SelecionarDataCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding Data}"
                                                        FocusVisualStyle="{x:Null}"
                                                        Cursor="Hand"
                                                        Margin="0,2"
                                                        OverridesDefaultStyle="True">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="dayBorder"
                                                                    Width="28" Height="28"
                                                                    CornerRadius="4"
                                                                    Background="Transparent"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock x:Name="dayText"
                                                                           Text="{Binding Dia}"
                                                                           FontSize="12"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{StaticResource BrushTextPrimary}"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding IsMesAtual}" Value="False">
                                                                    <Setter TargetName="dayText" Property="Foreground" Value="#A8A29E"/>
                                                                </DataTrigger>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                                                                        <Condition Binding="{Binding IsSelecionado}" Value="False"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter TargetName="dayBorder" Property="Background" Value="#F5F2F0"/>
                                                                </MultiDataTrigger>
                                                                <DataTrigger Binding="{Binding IsSelecionado}" Value="True">
                                                                    <Setter TargetName="dayBorder" Property="Background" Value="#504746"/>
                                                                    <Setter TargetName="dayText" Property="Foreground" Value="White"/>
                                                                    <Setter TargetName="dayText" Property="FontWeight" Value="SemiBold"/>
                                                                </DataTrigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Linha de Ações Inferior: Limpar e Hoje -->
                                    <Grid Margin="2,14,2,2">
                                        <Button Command="{Binding LimparDataCommand}"
                                                Content="Limpar"
                                                FontSize="12"
                                                FontWeight="Medium"
                                                Foreground="{StaticResource BrushTextSecondary}"
                                                HorizontalAlignment="Left"
                                                Style="{StaticResource FlatActionButtonStyle}"/>

                                        <Button Command="{Binding HojeDataCommand}"
                                                Content="Hoje"
                                                FontSize="12"
                                                FontWeight="Medium"
                                                Foreground="{StaticResource BrushInfo}"
                                                HorizontalAlignment="Right"
                                                Style="{StaticResource FlatActionButtonStyle}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- Botão de Atualização Manual dos Dados -->
                    <Button Style="{StaticResource HeaderNavIconButtonStyle}"
                            Command="{Binding CarregarDadosCommand}"
                            ToolTip="Atualizar dados agora"
                            Margin="0,0,10,0">
                        <ui:SymbolIcon Symbol="ArrowSync24" FontSize="14" Foreground="{StaticResource BrushTextSecondary}"/>
                    </Button>

                    <!-- Botão Novo Agendamento -->
                    <Button Command="{Binding NovoAgendamentoCommand}"
                            Style="{StaticResource PrimaryActionButtonStyle}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Add24" FontSize="15" Foreground="White" Margin="0,0,6,0"/>
                            <TextBlock Text="Novo agendamento" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ===================== 2. QUATRO CARDS DE MÉTRICAS ===================== -->
            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- CARD 1: ATENDIMENTOS CONCLUÍDOS HOJE -->
                <Border Grid.Column="0" 
                        Background="{StaticResource BrushSurface}" 
                        BorderBrush="{StaticResource BrushBorder}" 
                        BorderThickness="1" 
                        CornerRadius="12" 
                        Padding="18,16" 
                        Margin="0,0,8,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <TextBlock Text="{Binding TituloAtendimentosDia}" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                            <Border Width="34" Height="34" CornerRadius="8" Background="#E8F5E9" HorizontalAlignment="Right">
                                <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="17" Foreground="#2E7D32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <TextBlock Grid.Row="1" 
                                   Text="{Binding ComandasFinalizadasHoje}" 
                                   FontSize="22" 
                                   FontWeight="Bold" 
                                   Foreground="{StaticResource BrushTextPrimary}" 
                                   Margin="0,6,0,8"/>

                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                            <TextBlock Text="• " FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                            <TextBlock Text="comandas concluídas" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- CARD 2: COMANDAS EM ABERTO -->
                <Border Grid.Column="1" 
                        Background="{StaticResource BrushSurface}" 
                        BorderBrush="{StaticResource BrushBorder}" 
                        BorderThickness="1" 
                        CornerRadius="12" 
                        Padding="18,16" 
                        Margin="4,0,4,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <TextBlock Text="Comandas abertas" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                            <Border Width="34" Height="34" CornerRadius="8" Background="#FFF3E0" HorizontalAlignment="Right">
                                <ui:SymbolIcon Symbol="Receipt24" FontSize="17" Foreground="#E65100" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <TextBlock Grid.Row="1" 
                                   Text="{Binding ComandasAbertas}" 
                                   FontSize="22" 
                                   FontWeight="Bold" 
                                   Foreground="{StaticResource BrushTextPrimary}" 
                                   Margin="0,6,0,8"/>

                        <Button Grid.Row="2" 
                                Command="{Binding IrParaComandasCommand}" 
                                Background="Transparent" 
                                BorderThickness="0" 
                                Padding="0" 
                                Cursor="Hand" 
                                HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="• " FontSize="11" Foreground="{StaticResource BrushSecondary}"/>
                                <TextBlock Text="em atendimento agora" FontSize="11" Foreground="{StaticResource BrushSecondary}"/>
                                <ui:SymbolIcon Symbol="ChevronRight24" FontSize="11" Foreground="{StaticResource BrushSecondary}" Margin="2,1,0,0"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- CARD 3: AGENDAMENTOS HOJE -->
                <Border Grid.Column="2" 
                        Background="{StaticResource BrushSurface}" 
                        BorderBrush="{StaticResource BrushBorder}" 
                        BorderThickness="1" 
                        CornerRadius="12" 
                        Padding="18,16" 
                        Margin="4,0,4,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <TextBlock Text="{Binding TituloAgendamentosDia}" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                            <Border Width="34" Height="34" CornerRadius="8" Background="#E8F5E9" HorizontalAlignment="Right">
                                <ui:SymbolIcon Symbol="CalendarLtr24" FontSize="17" Foreground="#2E7D32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <TextBlock Grid.Row="1" 
                                   Text="{Binding AgendamentosHoje}" 
                                   FontSize="22" 
                                   FontWeight="Bold" 
                                   Foreground="{StaticResource BrushTextPrimary}" 
                                   Margin="0,6,0,8"/>

                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                            <TextBlock Text="• " FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                            <TextBlock Text="{Binding AgendamentosPendentesHoje}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                            <TextBlock Text=" aguardando atendimento" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- CARD 4: TOTAL DE CLIENTES -->
                <Border Grid.Column="3" 
                        Background="{StaticResource BrushSurface}" 
                        BorderBrush="{StaticResource BrushBorder}" 
                        BorderThickness="1" 
                        CornerRadius="12" 
                        Padding="18,16" 
                        Margin="8,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <TextBlock Text="Total de clientes" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                            <Border Width="34" Height="34" CornerRadius="8" Background="#E1F5FE" HorizontalAlignment="Right">
                                <ui:SymbolIcon Symbol="People24" FontSize="17" Foreground="#0277BD" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <TextBlock Grid.Row="1" 
                                   Text="{Binding TotalClientes}" 
                                   FontSize="22" 
                                   FontWeight="Bold" 
                                   Foreground="{StaticResource BrushTextPrimary}" 
                                   Margin="0,6,0,8"/>

                        <Button Grid.Row="2" 
                                Command="{Binding IrParaClientesCommand}" 
                                Background="Transparent" 
                                BorderThickness="0" 
                                Padding="0" 
                                Cursor="Hand" 
                                HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="• " FontSize="11" Foreground="{StaticResource BrushSecondary}"/>
                                <TextBlock Text="cadastrados na base" FontSize="11" Foreground="{StaticResource BrushSecondary}"/>
                                <ui:SymbolIcon Symbol="ChevronRight24" FontSize="11" Foreground="{StaticResource BrushSecondary}" Margin="2,1,0,0"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===================== 3. SERVIÇOS POPULARES + CLIENTES MAIS FREQUENTES (TOP 5) ===================== -->
            <Grid Grid.Row="2" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- CARD ESQUERDA: SERVIÇOS MAIS PROCURADOS (POPULARIDADE OPERACIONAL) -->
                <Border Grid.Column="0" 
                        Background="{StaticResource BrushSurface}" 
                        BorderBrush="{StaticResource BrushBorder}" 
                        BorderThickness="1" 
                        CornerRadius="12" 
                        Padding="22,18" 
                        Margin="0,0,6,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Header -->
                            <RowDefinition Height="*"/>    <!-- Lista Top 5 ou Empty State -->
                            <RowDefinition Height="Auto"/> <!-- Rodapé -->
                        </Grid.RowDefinitions>

                        <!-- Cabeçalho Serviços Populares -->
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Serviços mais procurados" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                                <TextBlock Text="Procedimentos com maior frequência no salão" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <Border Background="{StaticResource BrushSurfaceSubtle}" 
                                    CornerRadius="4" 
                                    Padding="8,3" 
                                    HorizontalAlignment="Right" 
                                    VerticalAlignment="Top">
                                <TextBlock Text="POPULARIDADE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushPrimary}"/>
                            </Border>
                        </Grid>

                        <!-- Lista dos 5 Serviços Mais Procurados -->
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding TopServicos}" Visibility="{Binding TemTopServicos, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BrushBorder}" 
                                            BorderThickness="0,0,0,1" 
                                            Padding="0,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="26"/> <!-- 01, 02 -->
                                                <ColumnDefinition Width="*"/>  <!-- Nome, Barra e Metadados -->
                                                <ColumnDefinition Width="Auto"/> <!-- Percentual Badge -->
                                            </Grid.ColumnDefinitions>

                                            <!-- Posição -->
                                            <Border Grid.Column="0" 
                                                    Width="22" Height="22" 
                                                    CornerRadius="11" 
                                                    Background="{StaticResource BrushSurfaceSubtle}" 
                                                    HorizontalAlignment="Left" 
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Posicao}" 
                                                           FontSize="10" 
                                                           FontWeight="Bold" 
                                                           Foreground="{StaticResource BrushPrimary}" 
                                                           HorizontalAlignment="Center" 
                                                           VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- Detalhes do Serviço -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,12,0">
                                                <TextBlock Text="{Binding Nome}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                
                                                <!-- Barra de Progresso Visual Proporcional -->
                                                <ProgressBar Value="{Binding Percentual}" 
                                                             Minimum="0" 
                                                             Maximum="100" 
                                                             Height="5" 
                                                             BorderThickness="0" 
                                                             Background="#F0EDE8" 
                                                             Foreground="{StaticResource BrushPrimary}" 
                                                             Margin="0,4,0,4"/>

                                                <!-- Metadados: Duração e Quantidade Realizada -->
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="Clock24" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding DuracaoTexto}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                                                    <TextBlock Text=" • " FontSize="11" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding AtendimentosTexto}" FontSize="11" FontWeight="Medium" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Badge de Percentual -->
                                            <Border Grid.Column="2" 
                                                    Background="{StaticResource BrushSurfaceSubtle}" 
                                                    CornerRadius="6" 
                                                    Padding="8,4" 
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding PercentualTexto}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushPrimary}"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Estado Vazio para Serviços -->
                        <Border Grid.Row="1" 
                                Background="{StaticResource BrushBackground}" 
                                BorderBrush="{StaticResource BrushBorder}" 
                                BorderThickness="1" 
                                CornerRadius="8" 
                                Padding="20,24" 
                                Margin="0,8"
                                Visibility="{Binding SemTopServicos, Converter={StaticResource BoolToVis}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource BrushSurfaceSubtle}" HorizontalAlignment="Center" Margin="0,0,0,10">
                                    <ui:SymbolIcon Symbol="Sparkle24" FontSize="20" Foreground="{StaticResource BrushPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Nenhum procedimento registrado" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Conclua atendimentos ou finalize comandas para listar os serviços mais populares." FontSize="11" Foreground="{StaticResource BrushTextSecondary}" TextAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Rodapé: Ver todos os serviços -->
                        <Grid Grid.Row="2" Margin="0,12,0,0">
                            <Button HorizontalAlignment="Right" 
                                    VerticalAlignment="Center"
                                    Command="{Binding IrParaServicosCommand}" 
                                    Background="Transparent" 
                                    BorderThickness="0" 
                                    Padding="0" 
                                    Cursor="Hand">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Ver todos os serviços" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushPrimary}" VerticalAlignment="Center"/>
                                    <ui:SymbolIcon Symbol="ArrowUpRight24" FontSize="12" Foreground="{StaticResource BrushPrimary}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <!-- CARD DIREITA: CLIENTES MAIS FREQUENTES (TOP 5 ATENDIMENTOS) -->
                <Border Grid.Column="1" 
                        Background="{StaticResource BrushSurface}" 
                        BorderBrush="{StaticResource BrushBorder}" 
                        BorderThickness="1" 
                        CornerRadius="12" 
                        Padding="20,18" 
                        Margin="6,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Header -->
                            <RowDefinition Height="*"/>    <!-- Lista Top 5 ou Empty State -->
                            <RowDefinition Height="Auto"/> <!-- Rodapé -->
                        </Grid.RowDefinitions>

                        <!-- Cabeçalho Clientes Mais Frequentes -->
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Clientes mais frequentes ✦" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                                <TextBlock Text="Quem mais esteve presente no seu salão" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <Border Background="{StaticResource BrushSurfaceSubtle}" 
                                    CornerRadius="4" 
                                    Padding="8,3" 
                                    HorizontalAlignment="Right" 
                                    VerticalAlignment="Top">
                                <TextBlock Text="TOP 5" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushPrimary}"/>
                            </Border>
                        </Grid>

                        <!-- Lista dos 5 Clientes Mais Frequentes -->
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding TopClientes}" Visibility="{Binding TemTopClientes, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BrushBorder}" 
                                            BorderThickness="0,0,0,1" 
                                            Padding="0,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24"/> <!-- 01, 02 -->
                                                <ColumnDefinition Width="38"/> <!-- Avatar Circle -->
                                                <ColumnDefinition Width="*"/>  <!-- Nome & Telefone -->
                                                <ColumnDefinition Width="Auto"/> <!-- Badge Atendimentos -->
                                            </Grid.ColumnDefinitions>

                                            <!-- Posição -->
                                            <TextBlock Grid.Column="0" 
                                                       Text="{Binding Posicao}" 
                                                       FontSize="11" 
                                                       FontWeight="Medium" 
                                                       Foreground="{StaticResource BrushTextSecondary}" 
                                                       VerticalAlignment="Center"/>

                                            <!-- Avatar Circular -->
                                            <Border Grid.Column="1" 
                                                    Width="30" Height="30" 
                                                    CornerRadius="15" 
                                                    Background="{Binding AvatarBg}" 
                                                    HorizontalAlignment="Left" 
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Iniciais}" 
                                                           FontSize="11" 
                                                           FontWeight="Bold" 
                                                           Foreground="{StaticResource BrushPrimary}" 
                                                           HorizontalAlignment="Center" 
                                                           VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- Nome e Telefone -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="4,0,8,0">
                                                <TextBlock Text="{Binding Nome}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Telefone}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                                            </StackPanel>

                                            <!-- Badge de Frequência / Atendimentos (Sem qualquer valor financeiro) -->
                                            <Border Grid.Column="3" 
                                                    Background="{StaticResource BrushSurfaceSubtle}" 
                                                    CornerRadius="6" 
                                                    Padding="8,4" 
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding AtendimentosTexto}" 
                                                           FontSize="11" 
                                                           FontWeight="SemiBold" 
                                                           Foreground="{StaticResource BrushPrimary}"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Estado Vazio quando não há clientes finalizados -->
                        <Border Grid.Row="1" 
                                Background="{StaticResource BrushBackground}" 
                                BorderBrush="{StaticResource BrushBorder}" 
                                BorderThickness="1" 
                                CornerRadius="8" 
                                Padding="20,24" 
                                Margin="0,8"
                                Visibility="{Binding SemTopClientes, Converter={StaticResource BoolToVis}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource BrushSurfaceSubtle}" HorizontalAlignment="Center" Margin="0,0,0,10">
                                    <ui:SymbolIcon Symbol="PeopleStar24" FontSize="20" Foreground="{StaticResource BrushPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Nenhum atendimento finalizado" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Finalize atendimentos para visualizar o ranking dos clientes mais frequentes." FontSize="11" Foreground="{StaticResource BrushTextSecondary}" TextAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Rodapé: Ver todos os clientes -->
                        <Button Grid.Row="2" 
                                Command="{Binding IrParaClientesCommand}" 
                                Background="Transparent" 
                                BorderThickness="0" 
                                Padding="0" 
                                Cursor="Hand" 
                                HorizontalAlignment="Right" 
                                Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Ver todos os clientes" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushPrimary}"/>
                                <ui:SymbolIcon Symbol="ArrowUpRight24" FontSize="11" Foreground="{StaticResource BrushPrimary}" Margin="4,2,0,0"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===================== 4. AGENDA DO DIA (TABELA) ===================== -->
            <Border Grid.Row="3" 
                    Background="{StaticResource BrushSurface}" 
                    BorderBrush="{StaticResource BrushBorder}" 
                    BorderThickness="1" 
                    CornerRadius="12" 
                    Padding="22,18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Título & Link -->
                        <RowDefinition Height="Auto"/> <!-- Cabeçalho da Tabela -->
                        <RowDefinition Height="*"/>    <!-- Linhas da Tabela ou Empty State -->
                    </Grid.RowDefinitions>

                    <!-- Cabeçalho do Card Agenda do Dia -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TituloAgendaTabela}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,8,0"/>
                            <Border Background="{StaticResource BrushSurfaceSubtle}" CornerRadius="4" Padding="7,2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding AgendamentosHoje}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushPrimary}"/>
                            </Border>
                        </StackPanel>

                        <Button HorizontalAlignment="Right" 
                                Command="{Binding IrParaAgendaCommand}" 
                                Background="Transparent" 
                                BorderThickness="0" 
                                Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Ver agenda completa" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushPrimary}"/>
                                <ui:SymbolIcon Symbol="ArrowUpRight24" FontSize="11" Foreground="{StaticResource BrushPrimary}" Margin="4,2,0,0"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Cabeçalho das Colunas da Tabela (visível quando existem agendamentos) -->
                    <Border Grid.Row="1" 
                            Background="#FAF9F8" 
                            CornerRadius="6" 
                            Padding="12,8" 
                            Margin="0,0,0,4"
                            Visibility="{Binding TemAgendamentos, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="65"/>  <!-- Horário -->
                                <ColumnDefinition Width="180"/> <!-- Cliente -->
                                <ColumnDefinition Width="*"/>   <!-- Serviços -->
                                <ColumnDefinition Width="100"/> <!-- Duração -->
                                <ColumnDefinition Width="110"/> <!-- Status -->
                                <ColumnDefinition Width="24"/>  <!-- Seta -->
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Horário" FontSize="11" FontWeight="Medium" Foreground="{StaticResource BrushTextSecondary}"/>
                            <TextBlock Grid.Column="1" Text="Cliente" FontSize="11" FontWeight="Medium" Foreground="{StaticResource BrushTextSecondary}"/>
                            <TextBlock Grid.Column="2" Text="Serviços" FontSize="11" FontWeight="Medium" Foreground="{StaticResource BrushTextSecondary}"/>
                            <TextBlock Grid.Column="3" Text="Duração" FontSize="11" FontWeight="Medium" Foreground="{StaticResource BrushTextSecondary}"/>
                            <TextBlock Grid.Column="4" Text="Status" FontSize="11" FontWeight="Medium" Foreground="{StaticResource BrushTextSecondary}"/>
                        </Grid>
                    </Border>

                    <!-- Lista de Agendamentos Reais do Dia -->
                    <ItemsControl Grid.Row="2" ItemsSource="{Binding AgendaDoDia}" Visibility="{Binding TemAgendamentos, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.AbrirAtendimentoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        FocusVisualStyle="{x:Null}"
                                        Cursor="Hand"
                                        HorizontalContentAlignment="Stretch"
                                        BorderThickness="0"
                                        Background="Transparent"
                                        Padding="0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="RowBorder" 
                                                    Background="Transparent"
                                                    BorderBrush="{StaticResource BrushBorder}" 
                                                    BorderThickness="0,0,0,1" 
                                                    Padding="12,12"
                                                    SnapsToDevicePixels="True">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="65"/>  <!-- Horário -->
                                                        <ColumnDefinition Width="180"/> <!-- Cliente -->
                                                        <ColumnDefinition Width="*"/>   <!-- Serviços -->
                                                        <ColumnDefinition Width="100"/> <!-- Duração -->
                                                        <ColumnDefinition Width="110"/> <!-- Status -->
                                                        <ColumnDefinition Width="24"/>  <!-- Seta -->
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Horário -->
                                                    <TextBlock Grid.Column="0" 
                                                               Text="{Binding Horario}" 
                                                               FontSize="12" 
                                                               FontWeight="Bold" 
                                                               Foreground="{StaticResource BrushTextPrimary}" 
                                                               VerticalAlignment="Center"/>

                                                    <!-- Cliente (Avatar + Nome) -->
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Width="26" Height="26" CornerRadius="13" Background="{StaticResource BrushSurfaceSubtle}" Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding Iniciais}" 
                                                                       FontSize="10" 
                                                                       FontWeight="Bold" 
                                                                       Foreground="{StaticResource BrushPrimary}" 
                                                                       HorizontalAlignment="Center" 
                                                                       VerticalAlignment="Center"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding NomeCliente}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                                                    </StackPanel>

                                                    <!-- Serviços -->
                                                    <TextBlock Grid.Column="2" 
                                                               Text="{Binding Servicos}" 
                                                               FontSize="12" 
                                                               Foreground="{StaticResource BrushTextSecondary}" 
                                                               VerticalAlignment="Center" 
                                                               TextTrimming="CharacterEllipsis"/>

                                                    <!-- Duração com Ícone de Relógio -->
                                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <ui:SymbolIcon Symbol="Clock24" FontSize="13" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,5,0"/>
                                                        <TextBlock Text="{Binding Duracao}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                                                    </StackPanel>

                                                    <!-- Badge de Status -->
                                                    <Border Grid.Column="4" 
                                                            Background="{StaticResource BrushSurfaceSubtle}" 
                                                            CornerRadius="10" 
                                                            Padding="8,3" 
                                                            HorizontalAlignment="Left" 
                                                            VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Ellipse Width="5" Height="5" Fill="{StaticResource BrushPrimary}" Margin="0,0,4,0"/>
                                                            <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrushPrimary}"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Seta de Ação -->
                                                    <ui:SymbolIcon x:Name="ChevronIcon" Grid.Column="5" Symbol="ChevronRight24" FontSize="13" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="RowBorder" Property="Background" Value="#FAF6F4"/>
                                                    <Setter TargetName="ChevronIcon" Property="Foreground" Value="{StaticResource BrushPrimary}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Estado Vazio quando não há agendamentos no dia -->
                    <Border Grid.Row="2" 
                            Background="{StaticResource BrushBackground}" 
                            BorderBrush="{StaticResource BrushBorder}" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Padding="32,28" 
                            Margin="0,8,0,0"
                            Visibility="{Binding SemAgendamentos, Converter={StaticResource BoolToVis}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="44" Height="44" CornerRadius="22" Background="{StaticResource BrushSurfaceSubtle}" HorizontalAlignment="Center" Margin="0,0,0,12">
                                <ui:SymbolIcon Symbol="CalendarClock24" FontSize="22" Foreground="{StaticResource BrushPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Nenhum agendamento para este dia" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Você pode navegar pelas datas no topo ou marcar um novo atendimento para esta data." FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,16" HorizontalAlignment="Center"/>
                            <Button Command="{Binding NovoAgendamentoCommand}"
                                    Style="{StaticResource PrimaryActionButtonStyle}"
                                    HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Add24" FontSize="15" Foreground="White" Margin="0,0,6,0"/>
                                    <TextBlock Text="Agendar novo horário" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
